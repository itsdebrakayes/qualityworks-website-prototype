---
/**
 * Base layout: SEO head, structured data, skip link, prototype bar, header, footer.
 * Every page passes `seo` (unique title + description) and optional `breadcrumbs` and `jsonLd`.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProtoBar from '../components/ProtoBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { Seo } from '../data/types';
import { site } from '../data/site';

interface Props {
  seo: Seo;
  breadcrumbs?: { label: string; href?: string }[];
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  showBreadcrumbs?: boolean;
  bodyClass?: string;
}
const { seo, breadcrumbs, jsonLd = [], ogType = 'website', showBreadcrumbs = false, bodyClass } = Astro.props;
const path = Astro.url.pathname;
// Production canonical = existing domain + preserved path (see docs/06-url-mapping.md).
const canonical = new URL(path, site.legacyOrigin).toString();
const ogImage = new URL(seo.ogImage ?? '/brand/qualityworks-logo-color.png', site.legacyOrigin).toString();

const crumbLd = breadcrumbs && breadcrumbs.length > 1 ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.label, ...(b.href ? { item: new URL(b.href, site.legacyOrigin).toString() } : {}) })),
} : null;
const ld = [...(crumbLd ? [crumbLd] : []), ...jsonLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    <!-- PROTOTYPE: never index. Production directive for this template is recorded below. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="qw:production-robots" content={seo.noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@qualityworkscg" />
    <meta name="theme-color" content="#16202B" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/8vIQ7wUr0m80wwYf0QCXZzYzUoTg_T6h.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <ProtoBar />
    <Header currentPath={path} />
    <main id="main" tabindex="-1">
      {showBreadcrumbs && breadcrumbs && <div class="container crumb-wrap"><Breadcrumbs items={breadcrumbs} /></div>}
      <slot />
    </main>
    <Footer />
    <script>
      // Restrained reveal-on-scroll. Content is visible without JS and with reduced motion.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-visible'));
    </script>
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
  </body>
</html>
<style>
  main:focus { outline: none; }
  .crumb-wrap { padding-top: var(--space-6); }
</style>
