---
import Icon from './Icon.astro';
import type { Service } from '../data/types';
interface Props { service: Service; headingLevel?: 'h3' | 'h4'; showProblem?: boolean }
const { service: s, headingLevel = 'h3', showProblem = true } = Astro.props;
const H = headingLevel;
---
<article class="card service-card">
  <div class="card__body">
    <span class="service-card__icon"><Icon name={s.icon} /></span>
    <H class="card__title"><a href={s.path}>{s.name}</a></H>
    {showProblem && <p class="service-card__problem"><span class="visually-hidden">Problem it solves: </span>{s.buyerProblem}</p>}
    <p class="service-card__summary">{s.cardSummary}</p>
    <span class="card__footer link-arrow" aria-hidden="true">Explore {s.kind === 'engagement-model' ? 'model' : 'service'}<Icon name="arrow" /></span>
  </div>
</article>
<style>
  .service-card__icon { display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: var(--radius-md); background: var(--qw-teal-50); color: var(--qw-teal-700); }
  .surface-dark .service-card__icon, .surface-product .service-card__icon { background: rgba(95,195,207,0.12); color: var(--qw-teal-300); }
  .service-card__problem { font-size: var(--fs-sm); color: var(--color-heading); font-weight: var(--fw-medium); border-left: 3px solid var(--qw-teal-500); padding-left: var(--space-3); }
  .service-card__summary { font-size: var(--fs-sm); color: var(--color-muted); }
</style>
