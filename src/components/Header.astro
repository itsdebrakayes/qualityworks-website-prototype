---
import { REVIEW } from '../lib/release';
/**
 * Global header. Desktop mega-menu + mobile drawer, BOTH rendered from src/data/navigation.ts.
 * Behaviour (see script): disclosure buttons with aria-expanded; hover-intent open with a 280ms
 * close delay and a seamless hover bridge (no gap between trigger and panel); click/tap toggles;
 * Escape closes and returns focus; focus leaving the item closes it; one menu open at a time.
 * Mobile drawer is a modal <dialog> (native focus containment, Escape, inert page) that returns
 * focus to the menu button on close.
 *
 * Why: the navigation is the most-used interaction on the site, so its behaviour is pinned down by
 * acceptance criteria AC-NAV-1 to AC-NAV-4 (docs/10-acceptance-criteria.md; checked by QA-10, QA-12,
 * QA-13, QA-14). Rendering desktop and mobile from the same data guarantees the drawer contains every
 * desktop destination (AC-NAV-3). Review round 1 (doc 11) finding C4 made the drawer list every group
 * link by name (e.g. "Case Studies", "Resource Hub"); finding D1 put the link name in the logo alt.
 *
 * Props: currentPath (the current URL path, used for active-section and current-page markers).
 *
 * Used by: layouts/BaseLayout.astro only, which passes `Astro.url.pathname` on every page.
 *
 * Accessibility:
 * - Disclosure pattern, NOT the ARIA "menu" role: top-level items are <button>s with aria-expanded and
 *   aria-controls; panel contents are ordinary links reached with Tab. Hover is never the only way in.
 * - The active section's trigger carries visually hidden "(current section)" text plus a green
 *   underline; the exact current page link has aria-current="page" (AC-NAV-4).
 * - External links show an icon and visually hidden "(external site, opens in a new tab)".
 * - Touch targets: Menu and Close buttons are at least 44x44px; drawer links at least 44px tall.
 *
 * Review/release behaviour: links whose nav data has `status: 'proposed'` get a gold dot, rendered only
 * in REVIEW builds and only visible while review annotations are on (ProtoBar toggle). The release
 * build renders no dot (docs/12-release-cleanup.md, "Header proposed dots").
 *
 * Gotchas:
 * - Menus need JavaScript: desktop panels are rendered with `hidden` and the drawer is a closed
 *   <dialog>. Without JS the footer still links to every main section.
 * - The script finds elements through data-* hooks (data-menu-item, data-menu-trigger, data-menu-panel,
 *   data-drawer, data-drawer-open, data-drawer-close, data-accordion-trigger). Renaming classes is
 *   safe; renaming these attributes breaks the menus. `data-header` is a marker no script reads.
 * - The 1024px desktop breakpoint appears in the CSS AND in the script's matchMedia. Change both.
 * - Panel ids are built from NavItem.id (`menu-<id>` desktop, `m-<id>` drawer); ids must stay unique.
 * - Hover timings (90/200/280 ms) are part of AC-NAV-1. Re-run the navigation QA checks after changing them.
 */
import Icon from './Icon.astro';
import Button from './Button.astro';
import { primaryNav, headerCta, isActive } from '../data/navigation';
interface Props {
  /** Current URL path (Astro.url.pathname). Drives the active-section and aria-current markers. */
  currentPath: string
}
const { currentPath } = Astro.props;
// Normalise to a trailing slash so "/services" and "/services/" compare equal (live URLs use trailing slashes).
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const cur = norm(currentPath);
// Exact-page match, used for aria-current="page". (Section-level matching uses isActive from navigation.ts.)
const isCurrent = (href: string) => norm(href) === cur;
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    {/* Logo: alt names the link destination rather than describing the image (review round 1, D1). */}
    <a class="site-header__logo" href="/">
      <img src="/brand/qualityworks-wordmark-teal-on-slate.jpg" alt="QualityWorks Consulting Group home" width="677" height="156" />
    </a>

    {/* Desktop navigation, shown from 1024px. Each top-level item is a disclosure button plus a hidden panel. */}
    <nav class="primary-nav" aria-label="Main">
      <ul class="primary-nav__list">
        {/* active = the current URL belongs to this section (isActive in navigation.ts). wide = more than one link
            group, which switches the panel to the multi-column layout. */}
        {primaryNav.map((item) => {
          const active = isActive(cur, item);
          const wide = (item.groups?.length ?? 0) > 1;
          return (
            <li class:list={['primary-nav__item', { 'is-active': active }]} data-menu-item>
              {/* Disclosure trigger: the script toggles aria-expanded; aria-controls points at the panel below. */}
              <button class="primary-nav__trigger" type="button" aria-expanded="false" aria-controls={`menu-${item.id}`} data-menu-trigger>
                {item.label}{active && <span class="visually-hidden"> (current section)</span>}
                <Icon name="chevron" />
              </button>
              {/* Mega panel: starts hidden, opened by the script. It is positioned against the sticky header, so it
                  spans the full header width directly below the bar (no hover gap). */}
              <div class:list={['mega', { 'mega--wide': wide }]} id={`menu-${item.id}`} data-menu-panel hidden>
                <div class="mega__inner">
                  <div class="mega__groups">
                    {item.groups?.map((g) => (
                      <div class="mega__group">
                        <p class="mega__heading">{g.heading}</p>
                        <ul>
                          {g.links.map((l) => (
                            <li>
                              {/* aria-current marks the exact current page; external links open in a new tab and announce it. */}
                              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                                <span class="mega__label">
                                  {l.label}
                                  {l.external && <><Icon name="external" class="mega__ext" /><span class="visually-hidden"> (external site, opens in a new tab)</span></>}
                                  {/* REVIEW-only dot for links proposed but not in the live navigation; shown only in review mode. */}
                                  {REVIEW && l.status === 'proposed' && <span class="proposed-dot" title="Proposed: not in current live navigation"><span class="visually-hidden">(proposed page)</span></span>}
                                </span>
                                {l.description && <span class="mega__desc">{l.description}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  {/* Right column: a featured promo if the nav item defines one, otherwise a link to the section overview page. */}
                  <div class="mega__aside">
                    {item.feature ? (
                      <>
                        <p class="eyebrow">{item.feature.eyebrow}</p>
                        <p class="mega__feature-title">{item.feature.title}</p>
                        <p class="mega__feature-text">{item.feature.text}</p>
                        <a class="link-arrow" href={item.feature.cta.href}>{item.feature.cta.label}<Icon name="arrow" /></a>
                      </>
                    ) : item.href && (
                      <a class="link-arrow" href={item.href}>{item.label} overview<Icon name="arrow" /></a>
                    )}
                  </div>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </nav>

    {/* Header CTA (hidden below 480px, where it moves into the drawer) and the mobile Menu button. */}
    <div class="site-header__actions">
      <Button href={headerCta.href} label={headerCta.label} size="sm" arrow={false} class="site-header__cta" aria-current={isCurrent(headerCta.href) ? 'page' : undefined} />
      {/* Menu button (below 1024px only). aria-expanded mirrors the drawer state; the script keeps it in sync. */}
      <button class="menu-button" type="button" aria-controls="mobile-nav" aria-expanded="false" data-drawer-open>
        <Icon name="menu" /><span>Menu</span>
      </button>
    </div>
  </div>

  {/* Mobile drawer: a modal <dialog> opened with showModal(), which makes the page behind inert, keeps focus
      inside and closes on Escape natively. */}
  <dialog class="drawer" id="mobile-nav" aria-label="Site navigation" data-drawer>
    <div class="drawer__top">
      <a href="/" class="drawer__logo"><img src="/brand/qualityworks-wordmark-white.png" alt="QualityWorks Consulting Group home" width="291" height="63" /></a>
      <button type="button" class="drawer__close" data-drawer-close><Icon name="close" /><span class="visually-hidden">Close menu</span></button>
    </div>
    {/* Same primaryNav data as the desktop menu (AC-NAV-3). Each section is an accordion; the active section
        is rendered already expanded so visitors see where they are. */}
    <nav aria-label="Main (mobile)">
      <ul class="drawer__list">
        {primaryNav.map((item) => (
          <li class:list={['drawer__item', { 'is-active': isActive(cur, item) }]}>
            {/* Accordion button: aria-expanded is server-rendered "true" for the active section, toggled by the script. */}
            <button type="button" class="drawer__trigger" aria-expanded={isActive(cur, item) ? 'true' : 'false'} aria-controls={`m-${item.id}`} data-accordion-trigger>
              <span>{item.label}</span><Icon name="chevron" />
            </button>
            <div id={`m-${item.id}`} class="drawer__panel" hidden={!isActive(cur, item)}>
              {/* Overview link only when the section's landing page is not already listed by name (e.g. Results = Case Studies). */}
              {/* Review round 1, finding C4: the drawer lists every group link by name, so a generic overview link would duplicate one. */}
              {item.href && !item.groups?.some((g) => g.links.some((l) => l.href === item.href)) && <a class="drawer__overview" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>All {item.label.toLowerCase()}</a>}
              {item.groups?.map((g) => (
                <div class="drawer__group">
                  <p class="drawer__heading">{g.heading}</p>
                  <ul>
                    {g.links.map((l) => (
                      <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}{l.external && <><Icon name="external" /><span class="visually-hidden"> (external site, opens in a new tab)</span></>}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </nav>
    {/* Header CTA repeated at the bottom of the drawer, because the bar hides it on small phones. */}
    <div class="drawer__cta"><Button href={headerCta.href} label={headerCta.label} /></div>
  </dialog>
</header>

<style>
  /* Bar: sticky header above page content (z-index token). Background is the guide's Slate 800, because the
     supplied primary lockup (teal wordmark) is delivered on Slate 800 (/brand/qualityworks-wordmark-teal-on-slate.jpg,
     background baked in). Keep the two in step. Nav text is ink-1 (8.71:1); the focus ring is the guide's
     Green (3.73:1, above the 3:1 needed for focus indicators). */
  .site-header { position: sticky; top: 0; z-index: var(--z-header); background: var(--qw-slate-800); color: #fff; border-bottom: 1px solid rgba(255,255,255,0.08); --focus-ring: var(--qw-green-500); }
  /* Bar height 72px. Triggers use the same min-height so their underline sits on the bottom edge. */
  .site-header__inner { display: flex; align-items: center; gap: var(--space-6); min-height: 72px; }
  .site-header__logo { flex: none; display: block; padding: 6px 0; }
  .site-header__logo img { width: 160px; height: auto; }
  /* Desktop nav is hidden by default (mobile first) and shown from 1024px in the media query below. */
  .primary-nav { flex: 1; display: none; justify-content: center; }
  .primary-nav__list { display: flex; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  /* position: static on purpose: the absolutely positioned .mega panel then anchors to the sticky
     .site-header (nearest positioned ancestor) and spans its full width, not the narrow list item. */
  .primary-nav__item { position: static; }
  /* Trigger: full bar height so hovering the trigger and entering the panel never crosses a gap.
     ink-1 on slate-800 is 8.71:1. Navigation uses the display face (guide: UI text in Montserrat). nowrap stops
     two-word labels from breaking. */
  .primary-nav__trigger { display: inline-flex; align-items: center; gap: 0.3rem; min-height: 72px; padding: 0 0.7rem; background: none; border: 0; color: var(--qw-ink-1); font: var(--fw-medium) var(--fs-sm)/1 var(--font-display); cursor: pointer; position: relative; white-space: nowrap; }
  /* Chevron rotates 180deg while the panel is open. */
  .primary-nav__trigger :global(svg) { width: 15px; height: 15px; transition: transform var(--dur-base) var(--ease-out); opacity: 0.8; }
  .primary-nav__trigger[aria-expanded="true"] :global(svg) { transform: rotate(180deg); }
  /* Underline indicator: a 3px bar along the bottom edge, transparent by default. Open = 35% white;
     active section = the guide's Green. */
  .primary-nav__trigger::after { content: ""; position: absolute; left: 0.7rem; right: 0.7rem; bottom: 0; height: 3px; border-radius: 3px 3px 0 0; background: transparent; transition: background var(--dur-base); }
  .primary-nav__trigger:hover, .primary-nav__trigger[aria-expanded="true"] { color: #fff; }
  .primary-nav__trigger[aria-expanded="true"]::after { background: rgba(255,255,255,0.35); }
  .primary-nav__item.is-active .primary-nav__trigger { color: #fff; }
  .primary-nav__item.is-active .primary-nav__trigger::after { background: var(--qw-green-500); }
  /* Inset the focus ring (-4px) so it is drawn inside the full-height trigger. */
  .primary-nav__trigger:focus-visible { outline-offset: -4px; }

  /* Mega panel: anchored to the header bottom edge (top:100%), so there is no hover gap. */
  /* The panel is a white surface inside the dark header, so it re-maps the colour tokens (focus ring,
     link, muted, accent) back to their on-light values. */
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: #fff; color: var(--qw-slate-800); border-top: 1px solid var(--qw-line); box-shadow: var(--shadow-lg); --focus-ring: var(--qw-teal-700); --color-link: var(--qw-teal-700); --color-muted: var(--qw-muted); --color-accent: var(--qw-teal-500); }
  .mega[hidden] { display: none; }
  /* Inner: same width as the page container; link groups on the left, a 17rem aside on the right. */
  .mega__inner { max-width: calc(var(--container) + 2 * var(--gutter)); margin: 0 auto; padding: var(--space-8) var(--gutter) var(--space-10); display: grid; grid-template-columns: 1fr 17rem; gap: var(--space-10); }
  /* Groups: auto-fit columns of at least 14rem. Panels with a single group (not --wide) use one
     14-22rem column instead of stretching. */
  .mega__groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--space-8); }
  .mega:not(.mega--wide) .mega__groups { grid-template-columns: minmax(14rem, 22rem); }
  .mega__heading { font: var(--fw-medium) var(--fs-xs)/1.3 var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-muted); margin: 0 0 var(--space-3); padding-bottom: var(--space-2); border-bottom: 1px solid var(--qw-line); }
  .mega ul { list-style: none; margin: 0; padding: 0; }
  /* Link rows: the negative inline margin cancels the padding, so link text lines up with the group
     heading while the hover background extends past it. */
  .mega__group a { display: block; padding: 0.5rem 0.6rem; margin-inline: -0.6rem; border-radius: var(--radius-sm); text-decoration: none; color: var(--qw-slate-900); }
  .mega__group a:hover { background: var(--qw-mint-50); }
  /* Current page: tinted background plus a 3px inset teal bar on the left (not colour alone). */
  .mega__group a[aria-current="page"] { background: var(--qw-mint-50); box-shadow: inset 3px 0 0 var(--qw-teal-700); }
  .mega__label { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: var(--fw-semibold); font-size: var(--fs-sm); }
  .mega__label :global(.mega__ext) { width: 13px; height: 13px; color: var(--qw-muted); }
  .mega__desc { display: block; font-size: var(--fs-xs); color: var(--qw-muted); line-height: 1.4; margin-top: 2px; }
  .mega__aside { background: var(--qw-mint-50); border-radius: var(--radius-lg); padding: var(--space-6); align-self: start; }
  .mega__feature-title { font-family: var(--font-display); font-weight: var(--fw-bold); font-size: var(--fs-md); color: var(--qw-slate-900); margin-bottom: var(--space-2); line-height: 1.25; }
  .mega__feature-text { font-size: var(--fs-sm); color: var(--qw-muted); }
  /* Proposed-page dot: hidden unless <html> has the review-mode class (toggled by ProtoBar). :global is
     needed because that class sits on <html>, outside this component. The white outline separates
     the gold dot from the hover background. */
  .proposed-dot { display: none; }
  :global(html.review-mode) .proposed-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--qw-caution); outline: 2px solid #fff; }

  /* Actions: margin-left auto pushes the CTA and Menu button to the right edge when the nav is hidden. */
  .site-header__actions { display: flex; align-items: center; gap: var(--space-3); margin-left: auto; }
  /* Header CTA uses interactive teal (var(--qw-teal-700), 5.45:1 with white text), darker on hover. */
  /* Header CTA uses the standard primary button (brand Teal, slate-900 text); only wrapping is prevented. */
  .site-header__actions :global(.btn) { white-space: nowrap; }
  /* Menu button: at least 44x44px (touch target); outlined pill in 35% white. */
  .menu-button { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; min-width: 44px; padding: 0 0.85rem; border: 1.5px solid rgba(255,255,255,0.35); border-radius: var(--radius-pill); background: transparent; color: #fff; font: var(--fw-semibold) var(--fs-sm)/1 var(--font-display); cursor: pointer; }
  .menu-button :global(svg) { width: 20px; height: 20px; }

  /* Breakpoint: from 1024px show the mega-menu and hide the Menu button. Keep in sync with the
     matchMedia("(min-width: 1024px)") call in the script. */
  @media (min-width: 1024px) {
    .primary-nav { display: flex; }
    .menu-button { display: none; }
  }
  /* 1024-1279px: tighter gaps, smaller logo and xs labels so every top-level item fits on one line. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .site-header__inner { gap: var(--space-3); }
    .site-header__logo img { width: 132px; }
    .primary-nav__trigger { padding: 0 0.45rem; font-size: var(--fs-xs); }
    .primary-nav__trigger::after { left: 0.45rem; right: 0.45rem; }
  }
  /* Small phones: the logo and Menu button need all the space. */
  @media (max-width: 479px) {
    .site-header__cta { display: none !important; }  /* CTA remains in the drawer */
    .site-header__logo img { width: 140px; }
  }

  /* Drawer */
  /* Docked to the right (margin-left auto), full height, at most 26rem wide. 100dvh follows the
     visible viewport when mobile browser toolbars show or hide. overflow-y lets long menus scroll. */
  .drawer { margin: 0 0 0 auto; height: 100dvh; max-height: 100dvh; width: min(100vw, 26rem); max-width: 100vw; padding: 0; border: 0; background: var(--qw-slate-900); color: #fff; overflow-y: auto; --focus-ring: var(--qw-green-500); }
  /* Dim the page behind the modal: ink at 60% opacity. */
  .drawer::backdrop { background: rgba(26, 33, 43, 0.6); }
  /* A closed <dialog> is display:none by default; when open, a flex column lets the CTA sit at the bottom. */
  .drawer[open] { display: flex; flex-direction: column; }
  /* Short slide-in only for visitors who have not asked for reduced motion. */
  @media (prefers-reduced-motion: no-preference) { .drawer[open] { animation: slide-in var(--dur-slow) var(--ease-out); } }
  @keyframes slide-in { from { transform: translateX(30px); opacity: 0; } }
  /* Drawer top bar (logo + Close) stays pinned while the list scrolls; its own background hides content beneath. */
  /* Drawer wordmark: the supplied white reversed wordmark, sized like the header logo (guide minimum 120px). */
  .drawer__logo img { width: 150px; height: auto; }
  /* Menu link labels use the display face like the rest of the navigation; descriptions stay in the body face. */
  .mega__label, .drawer__group a, .drawer__overview { font-family: var(--font-display); }
  .drawer__top { display: flex; justify-content: space-between; align-items: center; padding: var(--space-4) var(--space-5); border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--qw-slate-900); z-index: 1; }
  /* Close button: 44x44px touch target. */
  .drawer__close { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.35); background: none; color: #fff; cursor: pointer; }
  .drawer__list { list-style: none; margin: 0; padding: var(--space-2) var(--space-5); }
  .drawer__item { border-bottom: 1px solid rgba(255,255,255,0.1); }
  /* Accordion trigger: full-width 56px row. */
  .drawer__trigger { width: 100%; display: flex; justify-content: space-between; align-items: center; min-height: 56px; background: none; border: 0; color: #fff; font: var(--fw-semibold) var(--fs-md)/1.2 var(--font-display); cursor: pointer; text-align: left; padding: 0; }
  /* Active section: a 3px logo-green underline under its label (inset box-shadow, so no layout shift). */
  .drawer__item.is-active > .drawer__trigger span { box-shadow: inset 0 -3px 0 var(--qw-green-500); }
  .drawer__trigger :global(svg) { transition: transform var(--dur-base); }
  .drawer__trigger[aria-expanded="true"] :global(svg) { transform: rotate(180deg); }
  .drawer__panel { padding: 0 0 var(--space-5); }
  /* Defensive: keep collapsed panels hidden whatever display rules apply. */
  .drawer__panel[hidden] { display: none; }
  .drawer__overview { display: inline-block; margin-bottom: var(--space-3); color: var(--qw-teal-500); font-weight: var(--fw-semibold); }
  .drawer__heading { font: var(--fw-medium) var(--fs-xs)/1.3 var(--font-mono); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--qw-ink-2); margin: var(--space-3) 0 var(--space-2); }
  .drawer__group ul { list-style: none; margin: 0; padding: 0; }
  /* Drawer links: at least 44px tall for touch; var(--qw-ink-1) on ink. */
  .drawer__group a { display: flex; align-items: center; gap: 0.4rem; min-height: 44px; color: var(--qw-ink-1); text-decoration: none; font-size: var(--fs-base); }
  .drawer__group a :global(svg) { width: 14px; height: 14px; opacity: 0.7; }
  /* Current page: logo green AND bold, so it does not rely on colour alone. */
  .drawer__group a[aria-current="page"], .drawer__overview[aria-current="page"] { color: var(--qw-green-500); font-weight: var(--fw-bold); }
  /* CTA pinned to the bottom of the drawer (margin-top auto in the flex column); full-width button. */
  .drawer__cta { padding: var(--space-6) var(--space-5) var(--space-10); margin-top: auto; }
  .drawer__cta :global(.btn) { width: 100%; }
</style>

<script>
  // How long a hover-opened panel stays open after the pointer leaves it. Forgives brief overshoots
  // and is the "280ms close delay" described in the header.
  const CLOSE_DELAY = 280;
  // Hover behaviour is for real mice only. Touch and pen input use click/tap, so a tap never triggers
  // a hover-open followed immediately by a click-close.
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-item]'));
  // The one item whose panel is open (one menu at a time), or null.
  let openItem: HTMLElement | null = null;
  // One pending open/close timer per item. A WeakMap lets entries disappear with their elements.
  const timers = new WeakMap<HTMLElement, number>();

  // Find an item's trigger and panel through data-* hooks, so CSS class changes cannot break behaviour.
  const parts = (item: HTMLElement) => ({
    trigger: item.querySelector<HTMLButtonElement>('[data-menu-trigger]')!,
    panel: item.querySelector<HTMLElement>('[data-menu-panel]')!,
  });
  // Opening a menu always closes any other open menu first.
  function open(item: HTMLElement) {
    if (openItem && openItem !== item) close(openItem);
    const { trigger, panel } = parts(item);
    panel.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    openItem = item;
  }
  // returnFocus is true for Escape, so keyboard users land back on the trigger (AC-NAV-2).
  function close(item: HTMLElement, returnFocus = false) {
    const { trigger, panel } = parts(item);
    panel.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
    if (openItem === item) openItem = null;
    if (returnFocus) trigger.focus();
  }

  items.forEach((item) => {
    const { trigger, panel } = parts(item);
    // Click/tap toggles. Keyboard Enter/Space also fire "click" on a <button>, so this covers keyboards too.
    trigger.addEventListener('click', () => (panel.hidden ? open(item) : close(item)));
    // Hover intent, fine mouse pointers only.
    item.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !finePointer.matches) return;
      clearTimeout(timers.get(item));
      // Hover intent: a short delay avoids flicker when the pointer merely crosses the bar, and a
      // longer delay before SWITCHING menus lets users travel diagonally from a trigger into its
      // open panel across sibling triggers without the panel being replaced (the pending switch is
      // cancelled on pointerleave).
      // 0 ms = this menu is already open (just cancel its pending close); 200 ms = switching away from
      // another open menu (the AC-NAV-1 rest time); 90 ms = nothing open yet (anti-flicker).
      const delay = openItem === item ? 0 : openItem ? 200 : 90;
      timers.set(item, window.setTimeout(() => open(item), delay));
    });
    // Leaving cancels any pending open and, if this menu is open, schedules its close after CLOSE_DELAY.
    // Re-entering before then clears that timer (pointerenter above), so the panel stays open.
    item.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !finePointer.matches) return;
      clearTimeout(timers.get(item));
      if (openItem === item) timers.set(item, window.setTimeout(() => close(item), CLOSE_DELAY));
    });
    // Keyboard (AC-NAV-2): Escape closes and returns focus to the trigger; stopPropagation keeps the same
    // key press from reaching other Escape handlers. ArrowDown on the trigger opens the panel and
    // focuses its first link.
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { e.stopPropagation(); close(item, true); }
      if (e.key === 'ArrowDown' && document.activeElement === trigger) {
        e.preventDefault(); open(item); panel.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });
    // Focus moving outside the item (e.g. Tab past the last link) closes the panel. relatedTarget is the
    // element receiving focus; it is null when focus leaves the page, which also closes the panel.
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) close(item);
    });
  });
  // A click anywhere outside the open item closes it.
  document.addEventListener('click', (e) => {
    if (openItem && !openItem.contains(e.target as Node)) close(openItem);
  });

  // Mobile drawer (modal dialog)
  // The script assumes this markup exists; it always does, because the drawer is part of this component.
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-drawer-open]')!;
  const closeBtn = drawer.querySelector<HTMLButtonElement>('[data-drawer-close]')!;
  // showModal(): native focus containment, Escape-to-close and an inert page behind. Locking <html>
  // overflow stops the page from scrolling under the drawer on touch devices. Focus starts on Close.
  openBtn.addEventListener('click', () => {
    drawer.showModal();
    openBtn.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
    closeBtn.focus();
  });
  // Every way of closing (Close button, backdrop click, Escape) ends in dialog.close(), so the single
  // "close" listener below does all the clean-up.
  const shut = () => drawer.close();
  closeBtn.addEventListener('click', shut);
  // Backdrop click: the event target is the <dialog> both for the backdrop and for the drawer's own
  // padding, so also require the pointer to be OUTSIDE the drawer's box. Keyboard "clicks" have
  // clientX/Y of 0 and never target the dialog itself, so they are unaffected.
  drawer.addEventListener('click', (e) => {
    if (e.target !== drawer) return;
    const r = drawer.getBoundingClientRect();
    const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
    if (!inside) shut();
  });
  // Undo the open-state changes and return focus to the Menu button (AC-NAV-3).
  drawer.addEventListener('close', () => {
    openBtn.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
    openBtn.focus();
  });
  // Drawer section accordions: aria-expanded and the panel's hidden state always change together.
  drawer.querySelectorAll<HTMLButtonElement>('[data-accordion-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls')!)!;
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      panel.hidden = expanded;
    });
  });
  // Close the drawer if the viewport grows to desktop while it is open.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => { if (m.matches && drawer.open) shut(); });
</script>
