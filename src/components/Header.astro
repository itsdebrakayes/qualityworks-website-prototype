---
import { RELEASE, REVIEW } from '../lib/release';
/**
 * Global header. Desktop mega-menu + mobile drawer, BOTH rendered from src/data/navigation.ts.
 * Behaviour (see script): disclosure buttons with aria-expanded; hover-intent open with a 280ms
 * close delay and a seamless hover bridge (no gap between trigger and panel); click/tap toggles;
 * Escape closes and returns focus; focus leaving the item closes it; one menu open at a time.
 * Mobile drawer is a modal <dialog> (native focus containment, Escape, inert page) that returns
 * focus to the menu button on close.
 */
import Icon from './Icon.astro';
import Button from './Button.astro';
import { primaryNav, headerCta, isActive } from '../data/navigation';
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const cur = norm(currentPath);
const isCurrent = (href: string) => norm(href) === cur;
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/">
      <img src="/brand/qualityworks-logo-color.png" alt="QualityWorks Consulting Group home" width="175" height="38" />
    </a>

    <nav class="primary-nav" aria-label="Main">
      <ul class="primary-nav__list">
        {primaryNav.map((item) => {
          const active = isActive(cur, item);
          const wide = (item.groups?.length ?? 0) > 1;
          return (
            <li class:list={['primary-nav__item', { 'is-active': active }]} data-menu-item>
              <button class="primary-nav__trigger" type="button" aria-expanded="false" aria-controls={`menu-${item.id}`} data-menu-trigger>
                {item.label}{active && <span class="visually-hidden"> (current section)</span>}
                <Icon name="chevron" />
              </button>
              <div class:list={['mega', { 'mega--wide': wide }]} id={`menu-${item.id}`} data-menu-panel hidden>
                <div class="mega__inner">
                  <div class="mega__groups">
                    {item.groups?.map((g) => (
                      <div class="mega__group">
                        <p class="mega__heading">{g.heading}</p>
                        <ul>
                          {g.links.map((l) => (
                            <li>
                              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                                <span class="mega__label">
                                  {l.label}
                                  {l.external && <><Icon name="external" class="mega__ext" /><span class="visually-hidden"> (external site, opens in a new tab)</span></>}
                                  {REVIEW && l.status === 'proposed' && <span class="proposed-dot" title="Proposed: not in current live navigation"><span class="visually-hidden">(proposed page)</span></span>}
                                </span>
                                {l.description && <span class="mega__desc">{l.description}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  <div class="mega__aside">
                    {item.feature ? (
                      <>
                        <p class="eyebrow">{item.feature.eyebrow}</p>
                        <p class="mega__feature-title">{item.feature.title}</p>
                        <p class="mega__feature-text">{item.feature.text}</p>
                        <a class="link-arrow" href={item.feature.cta.href}>{item.feature.cta.label}<Icon name="arrow" /></a>
                      </>
                    ) : item.href && (
                      <a class="link-arrow" href={item.href}>{item.label} overview<Icon name="arrow" /></a>
                    )}
                  </div>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={headerCta.href} label={headerCta.label} size="sm" arrow={false} class="site-header__cta" aria-current={isCurrent(headerCta.href) ? 'page' : undefined} />
      <button class="menu-button" type="button" aria-controls="mobile-nav" aria-expanded="false" data-drawer-open>
        <Icon name="menu" /><span>Menu</span>
      </button>
    </div>
  </div>

  <dialog class="drawer" id="mobile-nav" aria-label="Site navigation" data-drawer>
    <div class="drawer__top">
      <a href="/" class="drawer__logo"><img src="/brand/qualityworks-logo-color.png" alt="QualityWorks Consulting Group home" width="150" height="33" /></a>
      <button type="button" class="drawer__close" data-drawer-close><Icon name="close" /><span class="visually-hidden">Close menu</span></button>
    </div>
    <nav aria-label="Main (mobile)">
      <ul class="drawer__list">
        {primaryNav.map((item) => (
          <li class:list={['drawer__item', { 'is-active': isActive(cur, item) }]}>
            <button type="button" class="drawer__trigger" aria-expanded={isActive(cur, item) ? 'true' : 'false'} aria-controls={`m-${item.id}`} data-accordion-trigger>
              <span>{item.label}</span><Icon name="chevron" />
            </button>
            <div id={`m-${item.id}`} class="drawer__panel" hidden={!isActive(cur, item)}>
              {/* Overview link only when the section's landing page is not already listed by name (e.g. Results = Case Studies). */}
              {item.href && !item.groups?.some((g) => g.links.some((l) => l.href === item.href)) && <a class="drawer__overview" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>All {item.label.toLowerCase()}</a>}
              {item.groups?.map((g) => (
                <div class="drawer__group">
                  <p class="drawer__heading">{g.heading}</p>
                  <ul>
                    {g.links.map((l) => (
                      <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}{l.external && <><Icon name="external" /><span class="visually-hidden"> (external site, opens in a new tab)</span></>}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </nav>
    <div class="drawer__cta"><Button href={headerCta.href} label={headerCta.label} /></div>
  </dialog>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-header); background: var(--qw-ink-900); color: #fff; border-bottom: 1px solid rgba(255,255,255,0.08); --focus-ring: var(--qw-green-400); }
  .site-header__inner { display: flex; align-items: center; gap: var(--space-6); min-height: 72px; }
  .site-header__logo { flex: none; display: block; padding: 6px 0; }
  .site-header__logo img { width: 160px; height: auto; }
  .primary-nav { flex: 1; display: none; justify-content: center; }
  .primary-nav__list { display: flex; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .primary-nav__item { position: static; }
  .primary-nav__trigger { display: inline-flex; align-items: center; gap: 0.3rem; min-height: 72px; padding: 0 0.7rem; background: none; border: 0; color: #E6ECF0; font: var(--fw-medium) var(--fs-sm)/1 var(--font-sans); cursor: pointer; position: relative; white-space: nowrap; }
  .primary-nav__trigger :global(svg) { width: 15px; height: 15px; transition: transform var(--dur-base) var(--ease-out); opacity: 0.8; }
  .primary-nav__trigger[aria-expanded="true"] :global(svg) { transform: rotate(180deg); }
  .primary-nav__trigger::after { content: ""; position: absolute; left: 0.7rem; right: 0.7rem; bottom: 0; height: 3px; border-radius: 3px 3px 0 0; background: transparent; transition: background var(--dur-base); }
  .primary-nav__trigger:hover, .primary-nav__trigger[aria-expanded="true"] { color: #fff; }
  .primary-nav__trigger[aria-expanded="true"]::after { background: rgba(255,255,255,0.35); }
  .primary-nav__item.is-active .primary-nav__trigger { color: #fff; }
  .primary-nav__item.is-active .primary-nav__trigger::after { background: var(--qw-green-400); }
  .primary-nav__trigger:focus-visible { outline-offset: -4px; }

  /* Mega panel: anchored to the header bottom edge (top:100%), so there is no hover gap. */
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: #fff; color: var(--qw-slate-700); border-top: 1px solid var(--qw-line); box-shadow: var(--shadow-lg); --focus-ring: var(--qw-teal-700); --color-link: var(--qw-teal-700); --color-muted: var(--qw-slate-500); --color-accent: var(--qw-teal-500); }
  .mega[hidden] { display: none; }
  .mega__inner { max-width: calc(var(--container) + 2 * var(--gutter)); margin: 0 auto; padding: var(--space-8) var(--gutter) var(--space-10); display: grid; grid-template-columns: 1fr 17rem; gap: var(--space-10); }
  .mega__groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--space-8); }
  .mega:not(.mega--wide) .mega__groups { grid-template-columns: minmax(14rem, 22rem); }
  .mega__heading { font: var(--fw-medium) var(--fs-xs)/1.3 var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-slate-500); margin: 0 0 var(--space-3); padding-bottom: var(--space-2); border-bottom: 1px solid var(--qw-line); }
  .mega ul { list-style: none; margin: 0; padding: 0; }
  .mega__group a { display: block; padding: 0.5rem 0.6rem; margin-inline: -0.6rem; border-radius: var(--radius-sm); text-decoration: none; color: var(--qw-ink-900); }
  .mega__group a:hover { background: var(--qw-teal-50); }
  .mega__group a[aria-current="page"] { background: var(--qw-teal-50); box-shadow: inset 3px 0 0 var(--qw-teal-700); }
  .mega__label { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: var(--fw-semibold); font-size: var(--fs-sm); }
  .mega__label :global(.mega__ext) { width: 13px; height: 13px; color: var(--qw-slate-500); }
  .mega__desc { display: block; font-size: var(--fs-xs); color: var(--qw-slate-500); line-height: 1.4; margin-top: 2px; }
  .mega__aside { background: var(--qw-canvas); border-radius: var(--radius-lg); padding: var(--space-6); align-self: start; }
  .mega__feature-title { font-weight: var(--fw-bold); font-size: var(--fs-md); color: var(--qw-ink-900); margin-bottom: var(--space-2); line-height: 1.25; }
  .mega__feature-text { font-size: var(--fs-sm); color: var(--qw-slate-500); }
  .proposed-dot { display: none; }
  :global(html.review-mode) .proposed-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--qw-gold-400); outline: 2px solid #fff; }

  .site-header__actions { display: flex; align-items: center; gap: var(--space-3); margin-left: auto; }
  .site-header__actions :global(.btn) { --btn-bg: var(--qw-teal-700); white-space: nowrap; }
  .site-header__actions :global(.btn:hover) { --btn-bg: var(--qw-teal-800); }
  .menu-button { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; min-width: 44px; padding: 0 0.85rem; border: 1.5px solid rgba(255,255,255,0.35); border-radius: var(--radius-pill); background: transparent; color: #fff; font: var(--fw-semibold) var(--fs-sm)/1 var(--font-sans); cursor: pointer; }
  .menu-button :global(svg) { width: 20px; height: 20px; }

  @media (min-width: 1024px) {
    .primary-nav { display: flex; }
    .menu-button { display: none; }
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    .site-header__inner { gap: var(--space-3); }
    .site-header__logo img { width: 132px; }
    .primary-nav__trigger { padding: 0 0.45rem; font-size: var(--fs-xs); }
    .primary-nav__trigger::after { left: 0.45rem; right: 0.45rem; }
  }
  @media (max-width: 479px) {
    .site-header__cta { display: none !important; }  /* CTA remains in the drawer */
    .site-header__logo img { width: 140px; }
  }

  /* Drawer */
  .drawer { margin: 0 0 0 auto; height: 100dvh; max-height: 100dvh; width: min(100vw, 26rem); max-width: 100vw; padding: 0; border: 0; background: var(--qw-ink-900); color: #fff; overflow-y: auto; --focus-ring: var(--qw-green-400); }
  .drawer::backdrop { background: rgba(8, 14, 20, 0.6); }
  .drawer[open] { display: flex; flex-direction: column; }
  @media (prefers-reduced-motion: no-preference) { .drawer[open] { animation: slide-in var(--dur-slow) var(--ease-out); } }
  @keyframes slide-in { from { transform: translateX(30px); opacity: 0; } }
  .drawer__top { display: flex; justify-content: space-between; align-items: center; padding: var(--space-4) var(--space-5); border-bottom: 1px solid rgba(255,255,255,0.1); position: sticky; top: 0; background: var(--qw-ink-900); z-index: 1; }
  .drawer__close { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.35); background: none; color: #fff; cursor: pointer; }
  .drawer__list { list-style: none; margin: 0; padding: var(--space-2) var(--space-5); }
  .drawer__item { border-bottom: 1px solid rgba(255,255,255,0.1); }
  .drawer__trigger { width: 100%; display: flex; justify-content: space-between; align-items: center; min-height: 56px; background: none; border: 0; color: #fff; font: var(--fw-semibold) var(--fs-md)/1.2 var(--font-sans); cursor: pointer; text-align: left; padding: 0; }
  .drawer__item.is-active > .drawer__trigger span { box-shadow: inset 0 -3px 0 var(--qw-green-400); }
  .drawer__trigger :global(svg) { transition: transform var(--dur-base); }
  .drawer__trigger[aria-expanded="true"] :global(svg) { transform: rotate(180deg); }
  .drawer__panel { padding: 0 0 var(--space-5); }
  .drawer__panel[hidden] { display: none; }
  .drawer__overview { display: inline-block; margin-bottom: var(--space-3); color: var(--qw-teal-300); font-weight: var(--fw-semibold); }
  .drawer__heading { font: var(--fw-medium) var(--fs-xs)/1.3 var(--font-mono); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--qw-slate-300); margin: var(--space-3) 0 var(--space-2); }
  .drawer__group ul { list-style: none; margin: 0; padding: 0; }
  .drawer__group a { display: flex; align-items: center; gap: 0.4rem; min-height: 44px; color: #E6ECF0; text-decoration: none; font-size: var(--fs-base); }
  .drawer__group a :global(svg) { width: 14px; height: 14px; opacity: 0.7; }
  .drawer__group a[aria-current="page"], .drawer__overview[aria-current="page"] { color: var(--qw-green-400); font-weight: var(--fw-bold); }
  .drawer__cta { padding: var(--space-6) var(--space-5) var(--space-10); margin-top: auto; }
  .drawer__cta :global(.btn) { width: 100%; }
</style>

<script>
  const CLOSE_DELAY = 280;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-item]'));
  let openItem: HTMLElement | null = null;
  const timers = new WeakMap<HTMLElement, number>();

  const parts = (item: HTMLElement) => ({
    trigger: item.querySelector<HTMLButtonElement>('[data-menu-trigger]')!,
    panel: item.querySelector<HTMLElement>('[data-menu-panel]')!,
  });
  function open(item: HTMLElement) {
    if (openItem && openItem !== item) close(openItem);
    const { trigger, panel } = parts(item);
    panel.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    openItem = item;
  }
  function close(item: HTMLElement, returnFocus = false) {
    const { trigger, panel } = parts(item);
    panel.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
    if (openItem === item) openItem = null;
    if (returnFocus) trigger.focus();
  }

  items.forEach((item) => {
    const { trigger, panel } = parts(item);
    trigger.addEventListener('click', () => (panel.hidden ? open(item) : close(item)));
    item.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !finePointer.matches) return;
      clearTimeout(timers.get(item));
      // Hover intent: a short delay avoids flicker when the pointer merely crosses the bar, and a
      // longer delay before SWITCHING menus lets users travel diagonally from a trigger into its
      // open panel across sibling triggers without the panel being replaced (the pending switch is
      // cancelled on pointerleave).
      const delay = openItem === item ? 0 : openItem ? 200 : 90;
      timers.set(item, window.setTimeout(() => open(item), delay));
    });
    item.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !finePointer.matches) return;
      clearTimeout(timers.get(item));
      if (openItem === item) timers.set(item, window.setTimeout(() => close(item), CLOSE_DELAY));
    });
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { e.stopPropagation(); close(item, true); }
      if (e.key === 'ArrowDown' && document.activeElement === trigger) {
        e.preventDefault(); open(item); panel.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) close(item);
    });
  });
  document.addEventListener('click', (e) => {
    if (openItem && !openItem.contains(e.target as Node)) close(openItem);
  });

  // Mobile drawer (modal dialog)
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-drawer-open]')!;
  const closeBtn = drawer.querySelector<HTMLButtonElement>('[data-drawer-close]')!;
  openBtn.addEventListener('click', () => {
    drawer.showModal();
    openBtn.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
    closeBtn.focus();
  });
  const shut = () => drawer.close();
  closeBtn.addEventListener('click', shut);
  drawer.addEventListener('click', (e) => { if (e.target === drawer) shut(); }); // backdrop
  drawer.addEventListener('close', () => {
    openBtn.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
    openBtn.focus();
  });
  drawer.querySelectorAll<HTMLButtonElement>('[data-accordion-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls')!)!;
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      panel.hidden = expanded;
    });
  });
  // Close the drawer if the viewport grows to desktop while it is open.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => { if (m.matches && drawer.open) shut(); });
</script>
