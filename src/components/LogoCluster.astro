---
/**
 * LogoCluster: an organic cluster of circular client marks (executive review, Stacy Kirk, 24 Nov 2026:
 * "just a visual, like boom, boom, look at all of these").
 *
 * Behaviour: bubbles of three sizes are packed at build time along a golden-angle spiral (no overlaps), drift
 *   gently, and rise and grow on hover, focus or tap, revealing the client name and industry. On phones the
 *   cluster becomes a wrapped grid of bubbles (tap to reveal).
 * Content: src/data/clients.ts (logos already published on qualityworkscg.com + clients named in published
 *   case studies). No new client relationships are claimed.
 * Accessibility: each bubble is a button whose accessible name is "Client, Industry"; the tooltip mirrors it.
 *   Motion stops under reduced motion.
 */
import { clients } from '../data/clients';
const R = { 3: 84, 2: 66, 1: 52 } as const;
const W = 1200, H = 620, GAP = 10;
type P = { x: number; y: number; r: number };
const placed: (P & { c: (typeof clients)[number] })[] = [];
const sorted = [...clients].sort((a, b) => b.size - a.size);
for (const c of sorted) {
  const r = R[c.size];
  for (let k = 0; k < 6000; k++) {
    const a = k * 2.39996; const d = 4 * Math.sqrt(k);
    const x = W / 2 + Math.cos(a) * d * 1.75; const y = H / 2 + Math.sin(a) * d;
    if (x - r < 0 || x + r > W || y - r < 0 || y + r > H) continue;
    if (placed.every((p) => Math.hypot(p.x - x, p.y - y) >= p.r + r + GAP)) { placed.push({ x, y, r, c }); break; }
  }
}
const industries = new Set(clients.map((c) => c.industry).filter((i) => !/confirm/i.test(i)));
---
<div class="lc" data-lc>
  <p class="lc__count"><strong>{clients.length}</strong> organisations shown · <strong>{industries.size}</strong> industries</p>
  <ul class="lc__field" style={`aspect-ratio:${W}/${H}`}>
    {placed.map((p, i) => (
      <li class="lc__item" style={`--x:${(p.x / W) * 100}%;--y:${(p.y / H) * 100}%;--s:${(p.r * 2 / W) * 100}%;--f:${(i % 7) * 0.7}s;--fd:${6 + (i % 5)}s`}>
        <button type="button" class:list={['lc__b', { 'lc__b--logo': p.c.logo, 'lc__b--name': !p.c.logo }]} aria-label={`${p.c.name}, ${p.c.industry}`} data-size={p.c.size}>
          {p.c.logo ? <img src={p.c.logo} alt="" loading="lazy" width="200" height="200" /> : <span class="lc__nm">{p.c.name}</span>}
          <span class="lc__tip" aria-hidden="true"><strong>{p.c.name}</strong><span>{p.c.industry}</span></span>
        </button>
      </li>
    ))}
  </ul>
</div>
<style>
  .lc__count { text-align: center; margin: 0 0 var(--space-6); font: 600 var(--fs-md)/1.4 var(--font-display); color: var(--qw-slate-700); }
  .lc__count strong { color: var(--qw-teal-800); font-size: 1.25em; }
  .lc__field { list-style: none; margin: 0; padding: 0; position: relative; width: 100%; }
  .lc__item { position: absolute; left: var(--x); top: var(--y); width: var(--s); aspect-ratio: 1; transform: translate(-50%, -50%); animation: lc-float var(--fd) ease-in-out var(--f) infinite alternate; }
  .lc__item:hover, .lc__item:focus-within { z-index: 5; animation-play-state: paused; }
  @keyframes lc-float { from { translate: 0 -5px; } to { translate: 0 6px; } }
  .lc__b { position: relative; width: 100%; height: 100%; border-radius: 50%; padding: 0; border: 1px solid rgba(255,255,255,.95); cursor: pointer; display: grid; place-items: center;
    background: linear-gradient(160deg, rgba(41,165,154,.16) 0%, rgba(255,255,255,.96) 70%);
    box-shadow: 0 10px 26px rgba(34,43,55,.08), 0 1px 2px rgba(34,43,55,.05), inset 0 1px 0 #fff;
    transition: transform 450ms cubic-bezier(.2,1.4,.4,1), box-shadow 300ms; }
  .lc__b img { width: 78%; height: 78%; object-fit: contain; filter: grayscale(1) contrast(1.1); opacity: .82; transition: filter 300ms, opacity 300ms; }
  .lc__b--name { background: linear-gradient(160deg, rgba(41,165,154,.34) 0%, rgba(255,255,255,.96) 78%); }
  .lc__b--name[data-size="1"] { background: linear-gradient(160deg, rgba(44,175,129,.34) 0%, rgba(255,255,255,.96) 78%); }
  .lc__nm { padding: 0 14%; color: var(--qw-slate-900); text-align: center; font: 800 clamp(.6rem, .4rem + .5vw, .95rem)/1.15 var(--font-display); }
  .lc__b:hover, .lc__b:focus-visible, .lc__b.is-open { transform: scale(1.28) translateY(-6px); box-shadow: 0 30px 60px -20px rgba(29,118,111,.6), inset 0 1px 0 #fff; }
  .lc__b:hover img, .lc__b:focus-visible img, .lc__b.is-open img { filter: none; opacity: 1; }
  .lc__tip { position: absolute; left: 50%; bottom: calc(100% + 10px); transform: translate(-50%, 8px) scale(.8); opacity: 0; pointer-events: none; white-space: nowrap; padding: .6em 1em; border-radius: 14px;
    background: rgba(34,43,55,.92); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: #fff; display: grid; gap: 2px; text-align: center; font-size: .78rem; transition: opacity 250ms, transform 300ms cubic-bezier(.2,1.4,.4,1); }
  .lc__tip strong { font: 800 .85rem/1.2 var(--font-display); }
  .lc__tip span { color: #9BE7C8; font-weight: 700; }
  .lc__b:hover .lc__tip, .lc__b:focus-visible .lc__tip, .lc__b.is-open .lc__tip { opacity: 1; transform: translate(-50%, 0) scale(calc(1 / 1.28)); }
  @media (max-width: 767px) {
    .lc__field { aspect-ratio: auto !important; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
    .lc__item { position: relative; left: auto; top: auto; transform: none; width: 92px; }
    .lc__item:has([data-size="3"]) { width: 116px; } .lc__item:has([data-size="1"]) { width: 76px; }
    .lc__tip { white-space: normal; width: 9rem; }
  }
  @media (prefers-reduced-motion: reduce) { .lc__item { animation: none; } .lc__b { transition: none; } }
</style>
<script>
  // Tap support: a tap opens one bubble's label and closes the others (hover already covers mouse users).
  document.querySelectorAll<HTMLElement>('[data-lc]').forEach((root) => {
    const bs = [...root.querySelectorAll<HTMLElement>('.lc__b')];
    bs.forEach((b) => b.addEventListener('click', () => { const was = b.classList.contains('is-open'); bs.forEach((x) => x.classList.remove('is-open')); if (!was) b.classList.add('is-open'); }));
  });
</script>
