---
/** Wireframe placeholder for modules awaiting product-owner content. Clearly not final design. */
interface Props { title: string; decision: string; owner?: string }
const { title, decision, owner = 'Product owner' } = Astro.props;
---
<div class="wf" role="note">
  <p class="wf__tag mono">Wireframe · decision needed</p>
  <p class="wf__title">{title}</p>
  <p class="wf__decision"><strong>{owner}:</strong> {decision}</p>
  <div class="wf__lines" aria-hidden="true"><span></span><span></span><span></span></div>
  <slot />
</div>
<style>
  .wf { border: 2px dashed #B9C4CC; border-radius: var(--radius-lg); padding: var(--space-6); background: repeating-linear-gradient(-45deg, transparent 0 12px, rgba(154,167,180,0.07) 12px 24px); }
  .surface-product .wf, .surface-dark .wf { border-color: rgba(255,255,255,0.25); }
  .wf__tag { font-size: var(--fs-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-warning); margin-bottom: var(--space-2); }
  .surface-product .wf__tag, .surface-dark .wf__tag { color: var(--qw-gold-400); }
  .wf__title { font-weight: var(--fw-bold); font-size: var(--fs-md); color: var(--color-heading); margin-bottom: var(--space-2); }
  .wf__decision { font-size: var(--fs-sm); color: var(--color-text); }
  .wf__lines { display: grid; gap: 0.5rem; margin-top: var(--space-4); }
  .wf__lines span { height: 0.6rem; border-radius: 4px; background: rgba(154,167,180,0.3); }
  .wf__lines span:nth-child(2) { width: 85%; } .wf__lines span:nth-child(3) { width: 60%; }
</style>
