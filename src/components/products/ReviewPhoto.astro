---
/**
 * ReviewPhoto: a people photograph in a colour-blocked frame with floating "review interface" chips
 * (pointer parallax via data-pointer-scene / data-depth). Used by the human-review sections on
 * /qualitywatcher-ai-tools/ and /products/agents-as-a-service/.
 * Chips are decorative (aria-hidden) and only restate what the section text already says.
 * Props: image (peopleImage), chips ({ title, sub?, icon?, tone?, x, y, dot? }[]), tone ('teal'|'green').
 */
import Icon from '../Icon.astro';
import { type PeopleImage, peopleSrc, peopleSrcset } from '../../data/peopleImagery';
interface Chip { title: string; sub?: string; icon?: string; tone?: 'green' | 'slate' | ''; x: string; y: string; dot?: boolean; faces?: string[] }
interface Props { image: PeopleImage; chips: Chip[]; tone?: 'teal' | 'green' }
const { image, chips, tone = 'teal' } = Astro.props;
---
<div class:list={['rp', `rp--${tone}`]} data-pointer-scene data-reveal="scale">
  <span class="rp__block" aria-hidden="true" data-depth style="--depth:-10"></span>
  <span class="rp__ring" aria-hidden="true" data-depth style="--depth:-18"></span>
  <img class="rp__img" src={peopleSrc(image)} srcset={peopleSrcset(image)} sizes="(min-width: 960px) 40vw, 100vw" alt={image.alt} width="1600" height={Math.round(1600 / image.ratio)} loading="lazy" decoding="async" style={`object-position:${image.focus}`} />
  <div class="rp__chips" aria-hidden="true">
    {chips.map((c, i) => (
      <div class="chip-ui float" data-depth style={`--depth:${14 + i * 8};--f:${i};left:${c.x};top:${c.y}`}>
        {c.faces ? <span class="rp__faces">{c.faces.map((f) => <img src={f} alt="" width="30" height="30" />)}</span>
          : c.dot ? <span class="chip-ui__dot"></span>
          : c.icon && <span class:list={['chip-ui__icon', c.tone && `chip-ui__icon--${c.tone}`]}><Icon name={c.icon} /></span>}
        <span>{c.title}{c.sub && <small>{c.sub}</small>}</span>
      </div>
    ))}
  </div>
</div>
<style>
  .rp { position: relative; padding: 0 0 var(--space-10) var(--space-10); }
  .rp__block { position: absolute; left: 0; bottom: 0; width: 78%; height: 82%; border-radius: 28px; background: var(--qw-teal-500); }
  .rp--green .rp__block { background: var(--qw-green-500); }
  .rp__ring { position: absolute; right: -28px; top: -34px; width: 120px; height: 120px; border-radius: 50%; border: 14px solid var(--qw-green-500); }
  .rp--green .rp__ring { border-color: var(--qw-teal-500); }
  .rp__img { position: relative; display: block; width: 100%; aspect-ratio: 4 / 3.4; object-fit: cover; border-radius: 24px; box-shadow: 0 40px 70px -40px rgba(34,43,55,.6); }
  .rp__chips { position: absolute; inset: 0; pointer-events: none; }
  .rp__faces { display: flex; }
  .rp__faces img { width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--qw-white); object-fit: cover; background: var(--qw-mint-50); }
  .rp__faces img + img { margin-left: -10px; }
  @media (max-width: 559px) { .rp { padding: 0 0 var(--space-6) var(--space-5); } .rp__ring { width: 70px; height: 70px; border-width: 10px; right: -6px; } }
</style>
