---
import { rn } from '../../lib/release';
/**
 * AgentFlow: interactive visualisation of AI agents + workflows + human oversight on
 * /products/agents-as-a-service/. Choosing an agent (tabs with persona portraits; auto-cycles via motion.ts
 * `data-cycle`) shows an illustrative path: work arrives → the agent works (its published description) →
 * human approval checkpoint → back in your workstream.
 *
 * Content integrity: agent names, roles, departments and descriptions come from `agentSnapshot`
 * (marketplace, observed 17 Nov 2026). The path is a generic, illustrative pattern, NOT a per-agent
 * specification; the REVIEW note says so. Portraits are marketplace agent personas, not staff.
 * Accessibility: role=tablist/tab/tabpanel; arrow keys move between agents; without JS all panels show.
 */
import Icon from '../Icon.astro';
import { agentSnapshot } from '../../data/products';
---
<div class="flow" data-cycle="5200">
  <div class="flow__tabs" role="tablist" aria-label="Choose an agent">
    {agentSnapshot.map((a, i) => (
      <button type="button" class="flow__tab" role="tab" id={`af-tab-${i}`} aria-controls={`af-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-cycle-tab={i}>
        <img src={`/agents/${a.id}.webp`} alt="" width="56" height="56" loading="lazy" />
        <span><strong>{a.name}</strong><small>{a.role}</small></span>
      </button>
    ))}
  </div>
  <div class="flow__panels">
    {agentSnapshot.map((a, i) => (
      <div class="flow__panel" id={`af-panel-${i}`} role="tabpanel" aria-labelledby={`af-tab-${i}`} data-cycle-panel={i} data-cycle-hide>
        <ol class="path">
          <li class="node node--in"><span class="node__icon"><Icon name="mail" /></span><span class="node__k">1 · Work arrives</span><strong>{a.category}</strong></li>
          <li class="node node--agent"><img src={`/agents/${a.id}.webp`} alt={`${a.name}, AI agent persona portrait`} width="72" height="72" loading="lazy" /><span class="node__k">2 · {a.name} works</span><strong>{a.role}</strong><span class="node__d">{a.description}</span></li>
          <li class="node node--human"><span class="node__icon"><Icon name="team" /></span><span class="node__k">3 · Human approval</span><strong>Your team reviews and decides</strong></li>
          <li class="node node--out"><span class="node__icon"><Icon name="check" /></span><span class="node__k">4 · Next step</span><strong>Back in your workstream</strong></li>
        </ol>
      </div>
    ))}
  </div>
  <p class="flow__note" data-review-note={rn('Illustrative pattern; human checkpoints per agent to be confirmed by product owner')}>Illustrative workflow. Which steps your team approves is agreed for each agent during onboarding.</p>
</div>
<style>
  .flow { display: grid; gap: var(--space-8); }
  .flow__tabs { display: flex; gap: var(--space-3); overflow-x: auto; padding: 4px 4px var(--space-3); scroll-snap-type: x mandatory; }
  .flow__tab { all: unset; box-sizing: border-box; cursor: pointer; flex: 0 0 auto; scroll-snap-align: start; display: flex; align-items: center; gap: var(--space-3); padding: 8px 16px 8px 8px; border-radius: 99px; background: var(--qw-white); color: var(--qw-slate-900); border: 2px solid transparent; transition: background 250ms, transform 250ms; }
  .flow__tab:hover { transform: translateY(-2px); }
  .flow__tab:focus-visible { outline: 3px solid var(--qw-slate-900); outline-offset: 2px; }
  .flow__tab img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; background: var(--qw-mint-50); }
  .flow__tab strong { display: block; font: var(--fw-bold) var(--fs-sm)/1.2 var(--font-display); }
  .flow__tab small { display: block; font-size: 0.72rem; color: var(--qw-muted); white-space: nowrap; }
  .flow__tab[aria-selected="true"] { background: var(--qw-slate-900); color: var(--qw-white); }
  .flow__tab[aria-selected="true"] small { color: #CFE3E0; }
  .flow__tab[aria-selected="true"] img { box-shadow: 0 0 0 3px var(--qw-green-500); }

  .flow__panels { display: grid; }
  :global(html.js-motion) .flow__panels > .flow__panel { grid-area: 1 / 1; }
  .flow__panel + .flow__panel { margin-top: var(--space-6); }
  :global(html.js-motion) .flow__panel + .flow__panel { margin-top: 0; }
  .path { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-8); position: relative; }
  @media (min-width: 900px) { .path { grid-template-columns: 1fr 1.5fr 1.1fr 1fr; gap: var(--space-10); align-items: center; } }
  .node { position: relative; display: grid; gap: 6px; justify-items: start; padding: var(--space-5); border-radius: 22px; background: var(--qw-white); color: var(--qw-slate-900); box-shadow: 0 24px 40px -30px rgba(34,43,55,.6); }
  .node strong { font: var(--fw-bold) var(--fs-md)/1.25 var(--font-display); }
  .node__k { font: var(--fw-bold) 0.7rem/1.2 var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; color: var(--qw-teal-700); }
  .node__d { font-size: var(--fs-sm); line-height: 1.5; }
  .node__icon { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: var(--qw-mint-50); color: var(--qw-teal-700); }
  .node__icon :global(svg) { width: 22px; height: 22px; }
  .node--agent { background: var(--qw-slate-900); color: var(--qw-white); padding: var(--space-6); }
  .node--agent .node__k { color: var(--qw-green-500); }
  .node--agent img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 3px solid var(--qw-green-500); background: var(--qw-mint-50); }
  .node--human { background: var(--qw-green-500); }
  .node--human .node__k { color: var(--qw-slate-900); }
  .node--human .node__icon { background: var(--qw-slate-900); color: var(--qw-white); }
  .node--human::before { content: ""; position: absolute; inset: -8px; border-radius: 28px; border: 2px dashed var(--qw-slate-900); pointer-events: none; }
  /* Connectors with a travelling token between nodes. */
  .node:not(:last-child)::after { content: ""; position: absolute; left: 50%; top: 100%; width: 3px; height: var(--space-8); background: repeating-linear-gradient(180deg, var(--qw-slate-900) 0 6px, transparent 6px 12px); }
  @media (min-width: 900px) { .node:not(:last-child)::after { left: 100%; top: 50%; width: var(--space-10); height: 3px; background: repeating-linear-gradient(90deg, var(--qw-slate-900) 0 6px, transparent 6px 12px); } }
  .node--human:not(:last-child)::after { margin-left: 8px; }
  @media (max-width: 899px) { .node--human:not(:last-child)::after { margin: 8px 0 0; } }
  :global(html.js-motion:not(.reduced-motion)) .flow__panel.is-active .node { animation: qw-node 600ms var(--ease-out) both; }
  :global(html.js-motion:not(.reduced-motion)) .flow__panel.is-active .node:nth-child(2) { animation-delay: 250ms; }
  :global(html.js-motion:not(.reduced-motion)) .flow__panel.is-active .node:nth-child(3) { animation-delay: 550ms; }
  :global(html.js-motion:not(.reduced-motion)) .flow__panel.is-active .node:nth-child(4) { animation-delay: 850ms; }
  :global(html.js-motion:not(.reduced-motion)) .flow__panel.is-active .node--human .node__icon { animation: qw-pulse 1.6s 1.2s ease-out 2; }
  @keyframes qw-node { from { opacity: 0; transform: translateY(18px) scale(0.96); } }
  .flow__note { margin: 0; font-size: var(--fs-sm); display: flex; gap: var(--space-2); align-items: center; }
</style>
