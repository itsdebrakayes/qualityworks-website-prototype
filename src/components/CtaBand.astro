---
/**
 * CtaBand: the bright "next step" colour block near the bottom of a page (teal or green, people photo), with an eyebrow, an h2, optional
 * supporting text and one or two buttons.
 *
 * Why: every page should end with a clear next action (contact, see case studies, open a product).
 * One component keeps that closing pattern and its CTA styling identical across the site.
 *
 * Props: title, text, primary, secondary, eyebrow.
 *
 * Used by: components/templates/ServiceTemplate.astro and pages [slug] (article), about-us,
 * case-studies, case-studies/[slug], design-system, engagement-models, index, industries,
 * industries/[slug], products, products/prism, products/agents-as-a-service, qualitywatcher-ai-tools,
 * resources and services.
 *
 * Accessibility: the section is named by its h2 through aria-labelledby. It always uses the
 * `surface-dark` theme class, which switches text, link and focus-ring colours to on-dark values.
 * External CTAs get the "(opens in a new tab)" text and hand-off description from Button.
 *
 * Gotchas:
 * - The heading id is generated per instance (cta-band-xxxxxx), so several bands on one page stay valid.
 * - The title is an h2, so the band must sit at section level (not inside an h2 section's content).
 * - `primary` is always rendered as primary and `secondary` always as secondary, whatever `kind`
 *   the Cta data carries.
 */
import Button from './Button.astro';
import type { Cta } from '../data/types';
import { peopleImage, peopleSrc, peopleSrcset } from '../data/peopleImagery';
interface Props {
  /** Band heading (h2). Keep it short. */
  title: string;
  /** Supporting sentence under the heading. Optional. */
  text?: string;
  /** Main action; always styled as the primary button. Required. */
  primary: Cta;
  /** Second action; always styled as the secondary (outline) button. */
  secondary?: Cta;
  /** Small label above the heading. Default 'Next step'. */
  eyebrow?: string;
  /** Colour block: 'teal' (default) or 'green'. */
  tone?: 'teal' | 'green';
  /** People photo id from src/data/peopleImagery.ts shown on the right (default 'contact-team'); false hides it. */
  photo?: string | false;
}
const { title, text, primary, secondary, eyebrow = 'Next step', tone = 'teal', photo = 'contact-team' } = Astro.props;
const img = photo ? peopleImage(photo) : null;
// Unique heading id per instance so aria-labelledby never points at another band's heading.
const headingId = `cta-band-${Math.random().toString(36).slice(2, 8)}`;
---
{/* Redesign (docs/16 §4): a bright colour block (Teal or Green, slate-900 text) with a people photo that
    blends into the block on its left edge, like the page heroes. Buttons are equal width. */}
<section class:list={['cta-band', `surface-${tone}`, { 'cta-band--photo': !!img }]} aria-labelledby={headingId}>
  {img && <img class="cta-band__img" src={peopleSrc(img)} srcset={peopleSrcset(img)} sizes="(min-width: 960px) 45vw, 100vw" alt="" width="1600" height={Math.round(1600 / img.ratio)} loading="lazy" decoding="async" style={`object-position:${img.focus}`} />}
  <div class="container cta-band__inner">
    <div data-reveal="up">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={headingId} class="display-sm">{title}</h2>
      {text && <p class="cta-band__text">{text}</p>}
      <div class="btn-row btn-row--equal cta-band__ctas">
        <Button cta={{ ...primary, kind: 'primary' }} />
        {secondary && <Button cta={{ ...secondary, kind: 'secondary' }} />}
      </div>
    </div>
  </div>
</section>
<style>
  .cta-band { position: relative; overflow: hidden; padding-block: clamp(4rem, 3rem + 4vw, 7rem); }
  .cta-band__inner { position: relative; z-index: 1; }
  .cta-band__inner > div { max-width: 38rem; }
  .cta-band h2 { margin-bottom: var(--space-4); }
  .cta-band__text { font-size: var(--fs-md); margin: 0; max-width: 34rem; }
  .cta-band__ctas { margin-top: var(--space-8); }
  /* Photo is decorative here (alt=""): the people imagery supports, the heading carries the message. */
  .cta-band__img { display: none; }
  @media (min-width: 960px) {
    .cta-band__img { display: block; position: absolute; top: 0; right: 0; bottom: 0; width: 48%; height: 100%; object-fit: cover;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 40%); mask-image: linear-gradient(90deg, transparent 0%, #000 40%); }
  }
</style>
