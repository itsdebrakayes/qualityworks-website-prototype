---
/**
 * Shared inner-page hero. Variants: corporate (light), dark (slate), product (deep product surface).
 *
 * What: the top band of every inner page: optional breadcrumbs, eyebrow, the page <h1>, a lede,
 * free content, the brand gradient rule, up to two CTAs, and either a people photograph (`image` prop,
 * blended into the band like the homepage hero) or a custom right-hand "aside" column.
 *
 * Why: one hero component gives every inner page the same structure and guarantees exactly one <h1>
 * per page (CONTRIBUTING 3.4, QA-01). The variants implement the design direction
 * (docs/02-design-direction.md, updated by docs/15-visual-revision.md): "light" is the corporate
 * default on the guide's Mint surface, "dark" the slate surface, and "product" the product layer used
 * for QualityWatcher, Agents as a Service and PRISM. The `image` option was added in the visual
 * revision so page headers can feature people (Janique's feedback), using photographs QualityWorks
 * already publishes (src/data/peopleImagery.ts).
 *
 * Props: eyebrow, title, lede, variant, breadcrumbs, primary, secondary, compact, image.
 * Slots: default (extra content under the lede) and "aside" (right column on wide screens).
 *
 * Used by: components/LegalStub.astro, components/templates/ServiceTemplate.astro and most inner
 * pages (about-us, blog, careers, case-studies, engagement-models, events, events/[slug], industries,
 * industries/[slug], products, products/prism, products/agents-as-a-service, qualitywatcher-ai-tools,
 * resources, services, prototype, prototype/claims, design-system).
 *
 * Accessibility: renders the page's only <h1>, so do not add another h1 in the page body. The photo
 * carries real alt text from peopleImagery.ts (it shows who the work is for, so it is not treated as
 * decoration); the gradient rule and blend layer are aria-hidden. Text never sits on top of the photo:
 * on desktop the copy column is on the solid slate part of the band, so contrast does not depend on it. The `surface-dark` / `surface-product` classes (global.css) switch
 * text, link and focus colours to their on-dark values.
 *
 * Gotchas:
 * - The primary CTA is always forced to `kind: 'primary'`; the secondary keeps its own kind or falls
 *   back to 'secondary'. Change the Cta data, not this component, if a page needs a ghost secondary.
 * - The two-column layout only applies at 1024px and up and only with the "aside" slot. If both `image`
 *   and the aside slot are given, the aside slot wins and the image is not rendered.
 * - A header with `image` is always the dark slate band, whatever `variant` says (it matches the homepage
 *   hero). Below 1024px the photo is a plain 16:9 picture above the copy; from 1024px it fills the right
 *   62% and blends into slate. `focus` in peopleImagery.ts keeps faces in frame at both crops.
 * - Breadcrumbs given here are visible only; pass the same array to BaseLayout for the JSON-LD.
 * - The gradient rule is the page's single "brand signature" moment (guide: once per layout). Do not
 *   add another gradient element to a page that uses PageHero.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import Button from './Button.astro';
import type { Cta } from '../data/types';
import { type PeopleImage, peopleSrc, peopleSrcset } from '../data/peopleImagery';
interface Props {
  /** Short uppercase label above the title. */
  eyebrow?: string;
  /** The page h1 text. Required. */
  title: string;
  /** Intro paragraph under the h1. */
  lede?: string;
  /** Visual surface: 'light' (default, corporate mint), 'dark' (slate) or 'product' (deep product surface with grid). */
  variant?: 'light' | 'dark' | 'product';
  /** Visible breadcrumb trail rendered above the eyebrow. */
  breadcrumbs?: { label: string; href?: string }[];
  /** Main call to action; always rendered as a primary button. */
  primary?: Cta;
  /** Second call to action; rendered with its own `kind`, defaulting to 'secondary'. */
  secondary?: Cta;
  /** Reduced vertical padding, for utility pages (legal stubs, prototype tools). */
  compact?: boolean;
  /** People photograph shown in the right column (use peopleImage('id') from src/data/peopleImagery.ts). */
  image?: PeopleImage;
}
const { eyebrow, title, lede, variant = 'light', breadcrumbs, primary, secondary, compact, image } = Astro.props;
// The aside slot takes precedence over the image; either one switches on the two-column grid.
const hasAside = Astro.slots.has('aside');
const showImage = !!image && !hasAside;
---
{/* surface-dark / surface-product are global theme classes that re-map colour tokens for dark backgrounds. */}
<section class:list={['page-hero', showImage ? 'page-hero--photo' : `page-hero--${variant}`, { 'surface-dark': variant === 'dark' || showImage, 'surface-product': variant === 'product' && !showImage, 'page-hero--compact': compact }]}>
  {/* Photo header (same treatment as the homepage hero): below 1024px a plain edge-to-edge picture above the
      copy; from 1024px the photo fills the right side of the band and blends into slate on its left edge.
      The photo is the hero's LCP candidate, so it loads eagerly with high fetch priority. */}
  {showImage && image && (
    <div class="page-hero__media">
      <img class="page-hero__img" src={peopleSrc(image)} srcset={peopleSrcset(image)} sizes="(min-width: 1024px) 62vw, 100vw"
        alt={image.alt} width="1600" height={Math.round(1600 / image.ratio)} loading="eager" fetchpriority="high" decoding="async"
        style={`object-position: ${image.focus}`} />
      <div class="page-hero__blend" aria-hidden="true"></div>
    </div>
  )}
  <div class:list={['container', 'page-hero__grid', { 'page-hero__grid--aside': hasAside }]}>
    <div class="page-hero__copy">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {/* The one and only h1 on the page. */}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
      {/* Brand signature: the guide's green-teal-blue gradient, used once per page. Decorative. */}
      {!compact && <span class="brand-rule page-hero__rule" aria-hidden="true"></span>}
      {/* CTA row: primary is always primary-styled; secondary defaults to the outline style. */}
      {(primary || secondary) && (
        <div class="btn-row page-hero__ctas">
          {primary && <Button cta={{ ...primary, kind: 'primary' }} />}
          {secondary && <Button cta={{ ...secondary, kind: secondary.kind ?? 'secondary' }} />}
        </div>
      )}
    </div>
    {/* Optional right column: custom aside content (e.g. "At a glance" on service pages). */}
    {hasAside && <div class="page-hero__aside"><slot name="aside" /></div>}
  </div>
</section>
<style>
  .page-hero { position: relative; overflow: hidden; padding-block: var(--space-12) var(--space-16); background: var(--color-bg); }
  /* Light (corporate) variant: the guide's Mint, its one light surface. */
  .page-hero--light { background: var(--qw-mint-50); }
  .page-hero--compact { padding-block: var(--space-10) var(--space-12); }
  .page-hero__grid { position: relative; display: grid; gap: var(--space-10); align-items: center; }
  /* Two columns only on desktop and only with an aside or photo; copy gets slightly more width. */
  @media (min-width: 1024px) { .page-hero__grid--aside { grid-template-columns: 1.15fr 0.85fr; gap: var(--space-16); } }
  /* Cap the h1 at about 22 characters per line so long titles wrap into a balanced block. */
  .page-hero h1 { font-size: var(--fs-2xl); max-width: 22ch; }
  .page-hero__copy .lede { margin-bottom: 0; }
  .page-hero__rule { margin-top: var(--space-8); }
  .page-hero__ctas { margin-top: var(--space-8); }
  /* Photo header (visual revision, docs/15): slate-900 band. Mobile and tablet: the picture is a plain
     edge-to-edge 16:9 band at the top (no radius, no shadow, no text over it). */
  .page-hero--photo { background: var(--qw-slate-900); padding-top: 0; }
  .page-hero__media { position: relative; margin-bottom: var(--space-8); }
  .page-hero__img { display: block; width: 100%; aspect-ratio: 16 / 9; height: auto; object-fit: cover; }
  .page-hero__blend { display: none; }
  @media (min-width: 1024px) {
    /* Desktop: the photo fills the right 62% of the band at full height. The blend layer fades it into
       slate-900 on its left edge (and slightly at the bottom), so the copy always sits on solid slate and
       never covers faces; `focus` in peopleImagery.ts keeps faces in the visible part of the crop. */
    .page-hero--photo { padding-top: var(--space-12); }
    .page-hero__media { position: absolute; top: 0; right: 0; bottom: 0; width: 62%; margin: 0; }
    .page-hero__img { width: 100%; height: 100%; aspect-ratio: auto; }
    .page-hero__blend { display: block; position: absolute; inset: 0; pointer-events: none;
      background:
        linear-gradient(90deg, var(--qw-slate-900) 0%, color-mix(in srgb, var(--qw-slate-900) 80%, transparent) 14%, color-mix(in srgb, var(--qw-slate-900) 35%, transparent) 34%, transparent 58%),
        linear-gradient(0deg, color-mix(in srgb, var(--qw-slate-900) 55%, transparent) 0%, transparent 30%); }
    /* Copy column stays on the solid slate part of the band (left 38% of the width plus the blend zone). */
    .page-hero--photo .page-hero__copy { max-width: min(32rem, 38vw); }
    .page-hero--photo { min-height: 30rem; display: flex; align-items: center; }
    .page-hero--photo .page-hero__grid { width: 100%; }
  }
  /* Product variant: deepest product surface (slate-950) with a faint teal glow in the top-right corner. */
  .page-hero--product { background: radial-gradient(80% 60% at 85% 0%, color-mix(in srgb, var(--qw-teal-500) 16%, transparent), transparent 60%), var(--qw-slate-950); }
  /* Product variant grid: 1px white lines at 3.5% alpha on a 48px grid, faded out toward the bottom.
     This "fine grid" is the signature of the product layer in doc 02. */
  .page-hero--product::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 48px 48px; mask: linear-gradient(180deg, #000, transparent 85%); -webkit-mask: linear-gradient(180deg, #000, transparent 85%); pointer-events: none; }
</style>
