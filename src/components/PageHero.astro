---
/**
 * Shared inner-page hero (redesign, docs/16-redesign-system.md §4).
 *
 * What: the top band of every inner page: optional breadcrumbs, eyebrow, the page <h1> (words animate
 * in), a lede, free content, the brand rule, up to two CTAs (equal width), and either a people photograph
 * (`image`) or a custom right-hand "aside" column.
 *
 * Why: Janique's feedback (23 Nov 2026): navy heroes are dull; use brighter brand colours, people-focused
 * imagery and more motion. The default hero is therefore a bright colour block (Teal, Green or Mint), the
 * photo blends into that colour on its left edge (the blended treatment approved in the previous round),
 * and floating interface chips (FloatingUI) drift over the photo and follow the pointer.
 *
 * Props: eyebrow, title, lede, tone, variant (legacy alias), breadcrumbs, primary, secondary, compact,
 *   image, ui (FloatingUI set; default chosen by tone).
 *   tone: 'teal' (default with a photo), 'green', 'mint' (default without a photo), 'white', 'dark', 'product'.
 * Slots: default (extra content under the lede) and "aside" (right column on wide screens).
 *
 * Accessibility: renders the page's only <h1>. On teal/green all text is slate-900 (4.73:1 / 5.14:1).
 * Text never sits on the photo: on desktop the photo occupies the right part of the band and its blend
 * fades towards the copy; on phones it is a plain picture above the copy. Chips are aria-hidden.
 *
 * Gotchas:
 * - `variant` is kept for older call sites: 'light' → mint, 'dark' → dark, 'product' → product.
 * - If both `image` and the aside slot are given, the aside slot wins.
 * - The brand rule is the page's single gradient moment; do not add another gradient element.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import Button from './Button.astro';
import FloatingUI from './FloatingUI.astro';
import type { Cta } from '../data/types';
import { type PeopleImage, peopleSrc, peopleSrcset } from '../data/peopleImagery';
type Tone = 'teal' | 'green' | 'mint' | 'white' | 'dark' | 'product';
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Background colour block. Default: 'teal' when a photo is shown, otherwise 'mint'. */
  tone?: Tone;
  /** Legacy alias for tone: 'light' | 'dark' | 'product'. */
  variant?: 'light' | 'dark' | 'product';
  breadcrumbs?: { label: string; href?: string }[];
  primary?: Cta;
  secondary?: Cta;
  compact?: boolean;
  /** People photograph (peopleImage('id') from src/data/peopleImagery.ts). */
  image?: PeopleImage;
  /** Which floating interface chips to show over the photo; false hides them. */
  ui?: 'testing' | 'ai' | 'agents' | 'build' | 'people' | 'contact' | false;
}
const { eyebrow, title, lede, variant, breadcrumbs, primary, secondary, compact, image, ui } = Astro.props;
const hasAside = Astro.slots.has('aside');
const showImage = !!image && !hasAside;
const legacy: Record<string, Tone> = { light: 'mint', dark: 'dark', product: 'product' };
const tone: Tone = Astro.props.tone ?? (variant ? legacy[variant] : showImage ? 'teal' : 'mint');
const surface = { teal: 'surface-teal', green: 'surface-green', mint: 'surface-mint', white: 'surface-white', dark: 'surface-dark', product: 'surface-product' }[tone];
// Floating chips are off unless a page asks for them explicitly (removed by request, 24 Nov 2026).
const uiSet = ui && false ? ui : null; // chips disabled site-wide by request; the `ui` prop is ignored
// Split the title into words for the staggered rise (CSS in motion.css; static without JS / reduced motion).
const words = title.split(' ');
---
<section class:list={['page-hero', `page-hero--${tone}`, surface, { 'page-hero--photo': showImage, 'page-hero--compact': compact }]} data-pointer-scene={showImage ? '' : undefined}>
  {/* Decorative colour blocks for heroes without a photo (no gradients). */}
  {!showImage && !hasAside && !compact && (tone === 'mint' || tone === 'white') && (
    <div class="page-hero__shapes" aria-hidden="true"><span class="ph-shape ph-shape--a" data-parallax="0.08"></span><span class="ph-shape ph-shape--b" data-parallax="0.16"></span></div>
  )}
  {showImage && image && (
    <div class="page-hero__media">
      <img class="page-hero__img" src={peopleSrc(image)} srcset={peopleSrcset(image)} sizes="(min-width: 1024px) 60vw, 100vw"
        alt={image.alt} width="1600" height={Math.round(1600 / image.ratio)} loading="eager" fetchpriority="high" decoding="async"
        style={`object-position: ${image.focus}`} />
      {uiSet && <FloatingUI set={uiSet} />}
    </div>
  )}
  <div class:list={['container', 'page-hero__grid', { 'page-hero__grid--aside': hasAside }]}>
    <div class="page-hero__copy">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 data-words>{words.map((w, i) => <><span class="word" style={`--w:${i}`}>{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}</h1>
      {lede && <p class="lede" data-reveal style="--i:2">{lede}</p>}
      <slot />
      {!compact && <span class="brand-rule page-hero__rule" aria-hidden="true"></span>}
      {(primary || secondary) && (
        <div class="btn-row btn-row--equal page-hero__ctas">
          {primary && <Button cta={{ ...primary, kind: 'primary' }} />}
          {secondary && <Button cta={{ ...secondary, kind: secondary.kind ?? 'secondary' }} />}
        </div>
      )}
    </div>
    {hasAside && <div class="page-hero__aside" data-reveal="right"><slot name="aside" /></div>}
  </div>
</section>
<style>
  .page-hero { position: relative; overflow: hidden; padding-block: var(--space-16) var(--space-20); background: var(--color-bg); }
  .page-hero--compact { padding-block: var(--space-10) var(--space-12); }
  .page-hero__grid { position: relative; display: grid; gap: var(--space-10); align-items: center; z-index: 1; }
  @media (min-width: 1024px) { .page-hero__grid--aside { grid-template-columns: 1.15fr 0.85fr; gap: var(--space-16); } }
  .page-hero h1 { font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.75rem); line-height: 1.03; letter-spacing: -0.025em; max-width: 18ch; }
  .page-hero--compact h1 { font-size: var(--fs-2xl); }
  .page-hero__copy .lede { margin-bottom: 0; max-width: 38rem; }
  .page-hero__rule { margin-top: var(--space-8); }
  .page-hero__ctas { margin-top: var(--space-8); }
  /* On bright blocks the gradient rule would disappear into the background; use solid slate instead. */
  .page-hero--teal .page-hero__rule, .page-hero--green .page-hero__rule { background: var(--qw-slate-900); }

  /* Mint/white heroes without a photo: two large solid brand shapes (teal and green) at the right edge. */
  .page-hero__shapes { position: absolute; inset: 0; pointer-events: none; }
  .ph-shape { position: absolute; border-radius: 50%; }
  .ph-shape--a { width: clamp(220px, 30vw, 460px); aspect-ratio: 1; right: -6%; top: -18%; background: var(--qw-teal-500); }
  .ph-shape--b { width: clamp(120px, 14vw, 220px); aspect-ratio: 1; right: 18%; bottom: -12%; background: var(--qw-green-500); }
  @media (max-width: 767px) { .ph-shape--a { opacity: 0.35; } .ph-shape--b { display: none; } }

  /* Photo hero. Phones/tablets: plain edge-to-edge 16:9 picture on top, copy below on the colour block. */
  .page-hero--photo { padding-top: 0; }
  .page-hero__media { position: relative; margin-bottom: var(--space-8); }
  .page-hero__img { display: block; width: 100%; aspect-ratio: 16 / 9; height: auto; object-fit: cover; }
  @media (min-width: 1024px) {
    /* Desktop: the photo fills the right 60% at full height and fades into the colour block on its left edge
       (a mask, so it blends into whichever surface colour the hero uses). Copy stays on the solid part. */
    .page-hero--photo { padding-top: var(--space-16); min-height: 34rem; display: flex; align-items: center; }
    .page-hero--photo .page-hero__grid { width: 100%; }
    .page-hero__media { position: absolute; top: 0; right: 0; bottom: 0; width: 60%; margin: 0; }
    .page-hero__img { width: 100%; height: 100%; aspect-ratio: auto;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 34%); mask-image: linear-gradient(90deg, transparent 0%, #000 34%); }
    .page-hero--photo .page-hero__copy { max-width: min(34rem, 40vw); }
  }
  @media (max-width: 1023px) { .page-hero__media :global(.fui) { display: none; } }

  /* Product layer: deep slate with the fine product grid (kept for product pages that opt in). */
  .page-hero--product::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 48px 48px; mask: linear-gradient(180deg, #000, transparent 85%); -webkit-mask: linear-gradient(180deg, #000, transparent 85%); pointer-events: none; }
</style>
