---
/** Shared inner-page hero. Variants: corporate (light), dark (ink), product (deep product surface). */
import Breadcrumbs from './Breadcrumbs.astro';
import Button from './Button.astro';
import type { Cta } from '../data/types';
interface Props { eyebrow?: string; title: string; lede?: string; variant?: 'light' | 'dark' | 'product'; breadcrumbs?: { label: string; href?: string }[]; primary?: Cta; secondary?: Cta; compact?: boolean }
const { eyebrow, title, lede, variant = 'light', breadcrumbs, primary, secondary, compact } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<section class:list={['page-hero', `page-hero--${variant}`, { 'surface-dark': variant === 'dark', 'surface-product': variant === 'product', 'page-hero--compact': compact }]}>
  <div class="page-hero__motif" aria-hidden="true"></div>
  <div class:list={['container', 'page-hero__grid', { 'page-hero__grid--aside': hasAside }]}>
    <div class="page-hero__copy">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
      {(primary || secondary) && (
        <div class="btn-row page-hero__ctas">
          {primary && <Button cta={{ ...primary, kind: 'primary' }} />}
          {secondary && <Button cta={{ ...secondary, kind: secondary.kind ?? 'secondary' }} />}
        </div>
      )}
    </div>
    {hasAside && <div class="page-hero__aside"><slot name="aside" /></div>}
  </div>
</section>
<style>
  .page-hero { position: relative; overflow: hidden; padding-block: var(--space-12) var(--space-16); background: var(--color-bg); }
  .page-hero--light { background: linear-gradient(180deg, var(--qw-teal-50) 0%, #fff 100%); }
  .page-hero--compact { padding-block: var(--space-10) var(--space-12); }
  .page-hero__grid { position: relative; display: grid; gap: var(--space-10); align-items: center; }
  @media (min-width: 1024px) { .page-hero__grid--aside { grid-template-columns: 1.15fr 0.85fr; gap: var(--space-16); } }
  .page-hero h1 { font-size: var(--fs-2xl); max-width: 22ch; }
  .page-hero__copy .lede { margin-bottom: 0; }
  .page-hero__ctas { margin-top: var(--space-8); }
  /* Brand motif: the gear ring from the QualityWorks "Q", drawn as fine concentric lines. */
  .page-hero__motif { position: absolute; right: -12rem; top: -10rem; width: 36rem; height: 36rem; border-radius: 50%; opacity: 0.5; pointer-events: none;
    background: repeating-radial-gradient(circle, transparent 0 22px, rgba(40,157,173,0.16) 22px 23px); mask: radial-gradient(circle, #000 35%, transparent 70%); -webkit-mask: radial-gradient(circle, #000 35%, transparent 70%); }
  .page-hero--dark .page-hero__motif, .page-hero--product .page-hero__motif { opacity: 0.8; background: repeating-radial-gradient(circle, transparent 0 22px, rgba(143,198,64,0.12) 22px 23px); }
  .page-hero--product { background: radial-gradient(80% 60% at 85% 0%, rgba(40,157,173,0.22), transparent 60%), var(--qw-ink-950); }
  .page-hero--product::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 48px 48px; mask: linear-gradient(180deg, #000, transparent 85%); -webkit-mask: linear-gradient(180deg, #000, transparent 85%); }
</style>
