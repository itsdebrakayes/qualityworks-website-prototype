---
import type { Article } from '../data/types';
import FixtureLabel from './FixtureLabel.astro';
interface Props { a: Article; headingLevel?: 'h2' | 'h3' }
const { a, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const href = a.href ?? `/${a.slug}/`;
const typeLabel = { blog: 'Article', news: 'News', whitepaper: 'Whitepaper', guide: 'Guide', 'event-recap': 'Event recap' }[a.type];
const date = new Date(a.publishedAt + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const fixture = a.provenance.approval === 'fixture';
---
<article class="card article-card" data-type={a.type} data-categories={a.categories.join('|')}>
  <div class="card__media">{a.image ? <img src={a.image} alt={a.imageAlt} loading="lazy" width="640" height="360" /> : <div class="article-card__ph"><span>{typeLabel}</span></div>}</div>
  <div class="card__body">
    <p class="card__meta"><span>{typeLabel}</span> · <time datetime={a.publishedAt}>{date}</time></p>
    <H class="card__title"><a href={href}>{a.title}</a></H>
    <p class="article-card__excerpt">{a.excerpt}</p>
    {fixture && <p><FixtureLabel /></p>}
  </div>
</article>
<style>
  .article-card__excerpt { font-size: var(--fs-sm); color: var(--color-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .article-card__ph { height: 100%; display: grid; place-items: center; background: repeating-radial-gradient(circle at 80% 20%, transparent 0 18px, rgba(40,157,173,0.15) 18px 19px), var(--qw-ink-900); }
  .article-card__ph span { font: var(--fw-medium) var(--fs-xs)/1 var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-teal-300); }
  .article-card :global(.badge--fixture) { position: relative; z-index: 2; }
</style>
