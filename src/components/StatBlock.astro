---
import { RELEASE, REVIEW } from '../lib/release';
/**
 * Statistics. Every stat MUST reference a claim id in the claims register.
 *
 * What: a row of headline figures (e.g. "16+ Years of quality-driven development") rendered as a description list,
 * each with a review-mode ClaimRef badge linking to its entry in the claims register.
 *
 * Why: numbers are the riskiest content on a marketing site. Acceptance criterion AC-HOME-2
 * (docs/10-acceptance-criteria.md) requires every homepage statistic to reference a claim record, and
 * the build to fail if one does not. Review round 1 (doc 11, finding B4) flagged claims C02-C04 as
 * needing measurement context verified before launch; docs/12-release-cleanup.md records that
 * StatBlock drops them from the release build.
 *
 * Props: stats, footnote.
 *
 * Used by: pages/index.astro, pages/qualitywatcher-ai-tools/index.astro and pages/design-system/index.astro.
 *
 * Review/release behaviour:
 * - REVIEW: every stat is shown, each with its ClaimRef badge, plus the optional footnote.
 * - RELEASE: stats whose claim is 'required-before-launch' or 'wording-approval-needed' are removed, ClaimRef renders nothing, and
 *   the footnote is not rendered. If no stats remain, the whole block disappears.
 *
 * Accessibility: a <dl> pairs each label (dt) with its value (dd); graphics are aria-hidden; counters keep the
 * final value in the DOM (src/lib/motion.ts). CSS shows the value above the label
 * (column-reverse) while the DOM keeps label-then-value, so screen readers hear "Years of quality-driven
 * development, 16+" in a sensible order.
 *
 * Gotchas:
 * - To make a stat release-visible, set its claim's `verification` to 'source-checked' (or clear it) in
 *   src/data/claims.ts, with the evidence recorded. No claim is 'source-checked' today.
 * - An unknown claim id throws during the build, on purpose. Add the claim to src/data/claims.ts first.
 */
import ClaimRef from './ClaimRef.astro';
import { claimById } from '../data/claims';
interface Props {
  /** Figures to show. `value` = the big number as displayed, `label` = what it measures, `claim` = claim id (e.g. 'C01'). */
  stats: { value: string; label: string; claim: string }[];
  /** Small review-only note under the stats (e.g. measurement caveats). Never rendered in release builds. */
  footnote?: string
}
const { stats: allStats, footnote } = Astro.props;
// Release builds drop any statistic whose claim still requires verification.
// 'source-checked' claims are publishable; only unresolved states are removed.
const BLOCKING = ['required-before-launch', 'wording-approval-needed'];
const stats = RELEASE ? allStats.filter((s) => !BLOCKING.includes(claimById(s.claim)?.verification ?? '')) : allStats;
// Build-time guard (AC-HOME-2): fail loudly rather than publish a number with no claim record.
stats.forEach((s) => { if (!claimById(s.claim)) throw new Error(`Stat "${s.label}" has no registered claim`); });
---
{/* Render nothing at all when the release filter has removed every stat. */}
{stats.length > 0 && <div class="stats">
  {/* Redesign (docs/16 §4): colourful tiles (Janique: "redesign these stats to be more visually interesting";
      her own suggestion for statistics was colourful tiles on white). Each tile counts up when it enters the
      viewport and draws a small graphic chosen from the value's form: a ring for percentages, rising bars for
      money, a timeline for years. The graphics are decorative (aria-hidden); the dl carries the meaning. */}
  <dl class="stats__list" data-reveal-stagger>
    {stats.map((s, i) => {
      const tone = ['teal', 'slate', 'green', 'mint'][i % 4];
      const pct = /%/.test(s.value) ? Math.min(100, parseFloat(s.value)) : null;
      const kind = pct !== null ? 'ring' : /\$/.test(s.value) ? 'bars' : 'line';
      return (
        <div class:list={['stats__item', `stats__item--${tone}`]} data-reveal="up">
          <dt>{s.label}</dt>
          <dd><span class="stats__value" data-count>{s.value}</span><ClaimRef id={s.claim} /></dd>
          <div class:list={['stats__viz', `stats__viz--${kind}`]} aria-hidden="true">
            {kind === 'ring' && <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" class="ring-bg" /><circle cx="32" cy="32" r="26" class="ring-fg" pathLength="100" style={`--pct:${pct}`} /></svg>}
            {kind === 'bars' && <span class="bars">{[28, 44, 38, 62, 78, 100].map((h, k) => <i style={`--h:${h}%;--k:${k}`}></i>)}</span>}
            {kind === 'line' && <span class="dots">{Array.from({ length: 8 }, (_, k) => <i style={`--k:${k}`}></i>)}</span>}
          </div>
        </div>
      );
    })}
  </dl>
  {/* Footnote holds review commentary about the claims, so it is REVIEW-only. */}
  {footnote && REVIEW && <p class="stats__note">{footnote}</p>}
</div>}
<style>
  .stats__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--space-4); margin: 0; }
  /* Tile: value above label visually (column-reverse) while the DOM keeps dt before dd. */
  .stats__item { position: relative; overflow: hidden; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-2); padding: var(--space-8) var(--space-6) var(--space-6); border-radius: var(--radius-lg); min-height: 15rem; transition: transform var(--dur-base) var(--ease-out); }
  .stats__item:hover { transform: translateY(-4px); }
  .stats__item--teal { background: var(--qw-teal-500); --t: var(--qw-slate-900); --g: var(--qw-white); }
  .stats__item--slate { background: var(--qw-slate-900); --t: var(--qw-white); --g: var(--qw-green-500); }
  .stats__item--green { background: var(--qw-green-500); --t: var(--qw-slate-900); --g: var(--qw-white); }
  .stats__item--mint { background: var(--qw-mint-50); --t: var(--qw-slate-900); --g: var(--qw-teal-500); }
  .stats dd { margin: 0; font-family: var(--font-display); font-size: clamp(2.75rem, 2rem + 2.6vw, 4.25rem); font-weight: var(--fw-black); line-height: 1; letter-spacing: -0.04em; color: var(--t); font-variant-numeric: tabular-nums; }
  .stats dt { font-family: var(--font-display); font-weight: var(--fw-semibold); font-size: var(--fs-sm); color: var(--t); max-width: 20ch; }
  .stats__note { font-size: var(--fs-xs); color: var(--color-muted); margin: var(--space-4) 0 0; }
  /* Graphics sit in the top-right corner of each tile. */
  /* Graphic sits above the number in normal flow (column-reverse puts it first), so it never overlaps text. */
  .stats__viz { width: 56px; height: 56px; color: var(--g); margin-bottom: auto; }
  .ring-bg { fill: none; stroke: color-mix(in srgb, var(--g) 25%, transparent); stroke-width: 7; }
  .ring-fg { fill: none; stroke: var(--g); stroke-width: 7; stroke-linecap: round; stroke-dasharray: var(--pct) 100; transform: rotate(-90deg); transform-origin: center; transition: stroke-dasharray 1400ms var(--ease-out) 200ms; }
  :global(html.js-motion:not(.reduced-motion)) .stats__item:not(.is-visible) .ring-fg { stroke-dasharray: 0 100; }
  .bars { display: flex; align-items: flex-end; gap: 4px; height: 100%; }
  .bars i { flex: 1; height: var(--h); background: var(--g); border-radius: 3px 3px 0 0; transition: height 900ms var(--ease-out); transition-delay: calc(var(--k) * 80ms + 200ms); }
  :global(html.js-motion:not(.reduced-motion)) .stats__item:not(.is-visible) .bars i { height: 6%; }
  .dots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; height: 100%; align-content: center; }
  .dots i { aspect-ratio: 1; border-radius: 50%; background: var(--g); transition: transform 500ms var(--ease-out); transition-delay: calc(var(--k) * 70ms + 200ms); }
  :global(html.js-motion:not(.reduced-motion)) .stats__item:not(.is-visible) .dots i { transform: scale(0); }
</style>
