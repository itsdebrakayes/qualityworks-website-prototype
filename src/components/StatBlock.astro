---
import { RELEASE, REVIEW } from '../lib/release';
/**
 * Statistics. Every stat MUST reference a claim id in the claims register.
 *
 * What: a row of headline figures (e.g. "16+ Years of quality-driven development") rendered as a description list,
 * each with a review-mode ClaimRef badge linking to its entry in the claims register.
 *
 * Why: numbers are the riskiest content on a marketing site. Acceptance criterion AC-HOME-2
 * (docs/10-acceptance-criteria.md) requires every homepage statistic to reference a claim record, and
 * the build to fail if one does not. Review round 1 (doc 11, finding B4) flagged claims C02-C04 as
 * needing measurement context verified before launch; docs/12-release-cleanup.md records that
 * StatBlock drops them from the release build.
 *
 * Props: stats, footnote.
 *
 * Used by: pages/index.astro, pages/qualitywatcher-ai-tools/index.astro and pages/design-system/index.astro.
 *
 * Review/release behaviour:
 * - REVIEW: every stat is shown, each with its ClaimRef badge, plus the optional footnote.
 * - RELEASE: stats whose claim is 'required-before-launch' or 'wording-approval-needed' are removed, ClaimRef renders nothing, and
 *   the footnote is not rendered. If no stats remain, the whole block disappears.
 *
 * Accessibility: a <dl> pairs each label (dt) with its value (dd); the index and rule are aria-hidden; counters
 * keep the final value in the DOM (src/lib/motion.ts). CSS grid areas show the value above the label while the
 * DOM keeps label-then-value, so screen readers hear "Years of quality-driven development, 16+".
 *
 * Gotchas:
 * - To make a stat release-visible, set its claim's `verification` to 'source-checked' (or clear it) in
 *   src/data/claims.ts, with the evidence recorded. No claim is 'source-checked' today.
 * - An unknown claim id throws during the build, on purpose. Add the claim to src/data/claims.ts first.
 */
import ClaimRef from './ClaimRef.astro';
import { claimById } from '../data/claims';
interface Props {
  /** Figures to show. `value` = the big number as displayed, `label` = what it measures, `claim` = claim id (e.g. 'C01'). */
  stats: { value: string; label: string; claim: string }[];
  /** Small review-only note under the stats (e.g. measurement caveats). Never rendered in release builds. */
  footnote?: string
}
const { stats: allStats, footnote } = Astro.props;
// Release builds drop any statistic whose claim still requires verification.
// 'source-checked' claims are publishable; only unresolved states are removed.
const BLOCKING = ['required-before-launch', 'wording-approval-needed'];
const stats = RELEASE ? allStats.filter((s) => !BLOCKING.includes(claimById(s.claim)?.verification ?? '')) : allStats;
// Build-time guard (AC-HOME-2): fail loudly rather than publish a number with no claim record.
stats.forEach((s) => { if (!claimById(s.claim)) throw new Error(`Stat "${s.label}" has no registered claim`); });
---
{/* Render nothing at all when the release filter has removed every stat. */}
{stats.length > 0 && <div class="stats">
  {/* Spec-sheet layout (CEO review follow-up, 25 Nov 2026: the icon tiles felt "generated and juvenile";
      asked for "a more modern tech sheet"). One white panel split into columns by hairlines: a small mono
      index, a large precise numeral that counts up on reveal (and again when scrolled back to), the label,
      and a thin rule that draws in. No pictograms. The dl carries the meaning; the rule is aria-hidden. */}
  <dl class="stats__list" data-reveal-stagger>
    {stats.map((s, i) => {
      const pct = /%/.test(s.value) ? Math.min(100, parseFloat(s.value)) : 100;
      return (
        <div class="stats__item" data-reveal="up" style={`--pct:${pct}`}>
          <dt>{s.label}</dt>
          <dd><span class="stats__value" data-count>{s.value}</span><ClaimRef id={s.claim} /></dd>
          <span class="stats__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')} / {String(stats.length).padStart(2, '0')}</span>
          <span class="stats__rule" aria-hidden="true"><i></i></span>
        </div>
      );
    })}
  </dl>
  {/* Footnote holds review commentary about the claims, so it is REVIEW-only. */}
  {footnote && REVIEW && <p class="stats__note">{footnote}</p>}
</div>}
<style>
  .stats__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); margin: 0; border-radius: 24px; overflow: hidden;
    background: linear-gradient(160deg, rgba(41,165,154,.10) 0%, rgba(255,255,255,.97) 55%); border: 1px solid rgba(255,255,255,.9); box-shadow: 0 10px 30px rgba(34,43,55,.07), 0 1px 2px rgba(34,43,55,.04), inset 0 1px 0 #fff; }
  /* Column: index on top, number, label, rule. DOM keeps dt before dd for screen readers. */
  .stats__item { position: relative; display: grid; grid-template-areas: "idx" "num" "lbl" "rule"; align-content: start; gap: var(--space-3); padding: var(--space-8) var(--space-8) var(--space-8); border-left: 1px solid rgba(34,43,55,.09); }
  .stats__item:first-child { border-left: 0; }
  @media (max-width: 899px) { .stats__item { border-left: 0; border-top: 1px solid rgba(34,43,55,.09); } .stats__item:first-child { border-top: 0; } }
  .stats__idx { grid-area: idx; font: 700 0.8rem/1 var(--font-display); letter-spacing: .08em; color: var(--qw-teal-700); }
  .stats dd { grid-area: num; margin: 0; font-family: var(--font-display); font-size: clamp(2.75rem, 2rem + 2.4vw, 4rem); font-weight: 800; line-height: 1; letter-spacing: -0.045em; font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, var(--qw-slate-900) 40%, #18625C 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stats dd :global(.claim-ref) { -webkit-text-fill-color: initial; }
  .stats dt { grid-area: lbl; font-family: var(--font-body); font-weight: 600; font-size: var(--fs-base); line-height: 1.4; color: var(--qw-slate-700); max-width: 22ch; }
  .stats__rule { grid-area: rule; display: block; height: 3px; margin-top: var(--space-3); border-radius: 3px; background: rgba(34,43,55,.08); overflow: hidden; }
  .stats__rule i { display: block; height: 100%; width: calc(var(--pct) * 1%); border-radius: inherit; background: linear-gradient(90deg, var(--qw-teal-500), var(--qw-green-500)); transition: width 1400ms var(--ease-out) 250ms; }
  :global(html.js-motion:not(.reduced-motion)) .stats__item:not(.is-visible) .stats__rule i { width: 0; }
  .stats__note { font-size: var(--fs-xs); color: var(--color-muted); margin: var(--space-4) 0 0; }
</style>
