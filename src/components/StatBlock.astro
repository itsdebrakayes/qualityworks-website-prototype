---
/** Statistics. Every stat MUST reference a claim id in the claims register. */
import ClaimRef from './ClaimRef.astro';
import { claimById } from '../data/claims';
interface Props { stats: { value: string; label: string; claim: string }[]; footnote?: string }
const { stats, footnote } = Astro.props;
stats.forEach((s) => { if (!claimById(s.claim)) throw new Error(`Stat "${s.label}" has no registered claim`); });
---
<div class="stats">
  <dl class="stats__list">
    {stats.map((s) => (
      <div class="stats__item">
        <dt>{s.label}</dt>
        <dd>{s.value}<ClaimRef id={s.claim} /></dd>
      </div>
    ))}
  </dl>
  {footnote && <p class="stats__note">{footnote}</p>}
</div>
<style>
  .stats__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 0; margin: 0; border-top: 1px solid var(--color-border); }
  .stats__item { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-2); padding: var(--space-6) var(--space-6) var(--space-6) 0; border-bottom: 1px solid var(--color-border); }
  @media (min-width: 720px) { .stats__item + .stats__item { padding-left: var(--space-6); border-left: 1px solid var(--color-border); } }
  .stats dd { margin: 0; font-size: var(--fs-2xl); font-weight: var(--fw-bold); line-height: 1; letter-spacing: -0.03em; color: var(--color-heading); }
  .stats dt { font-size: var(--fs-sm); color: var(--color-muted); max-width: 22ch; }
  .stats__note { font-size: var(--fs-xs); color: var(--color-muted); margin: var(--space-4) 0 0; }
</style>
