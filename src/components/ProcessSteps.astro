---
/**
 * ProcessSteps: a numbered row of steps ("01 Discover", "02 Plan", ...) describing how an engagement
 * or product works.
 *
 * Why: several pages explain a sequence (how a service is delivered, how an agent is hired, how a
 * tool is used). One component keeps the numbering, rule and type treatment identical everywhere.
 *
 * Props: `steps`, an ordered list of { title, text }.
 *
 * Used by: components/templates/ServiceTemplate.astro ("How we deliver", from `Service.process`),
 * pages/products/agents-as-a-service.astro, pages/qualitywatcher-ai-tools/index.astro and
 * pages/design-system/index.astro.
 *
 * Accessibility: it is a real <ol>, so assistive tech already announces "list, N items" and each
 * position. The visible "01", "02" numbers are therefore aria-hidden to avoid reading the number twice.
 *
 * Gotchas:
 * - Step titles are hard-coded <h3>. Always place this component under an <h2> (usually a
 *   SectionHeading) or the page will skip a heading level (QA-01).
 * - `counter-reset: s` in the CSS is not used by any rule; numbers come from the markup.
 */
interface Props {
  /** Steps in order. `title` becomes an h3; `text` is a short paragraph. */
  steps: { title: string; text: string }[]
}
const { steps } = Astro.props;
---
{/* Redesign (docs/16 §4; Janique: "This could be more graphical"): a connected journey. Numbered nodes sit on
    a track whose filled portion follows scroll progress (--p from data-scroll-progress); each node lights up
    as the fill reaches it and its card rises in. Horizontal from 900px, vertical timeline below. Without JS or
    with reduced motion the track is fully drawn and every node is lit. */}
<ol class="steps" data-scroll-progress style={`--n:${steps.length}`} data-reveal-stagger>
  {steps.map((s, i) => (
    <li class="steps__item" data-reveal="up" style={`--k:${i}`}>
      <span class="steps__node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div class="steps__card">
        <h3 class="steps__title">{s.title}</h3>
        <p>{s.text}</p>
      </div>
    </li>
  ))}
</ol>
<style>
  .steps { --p: 1; --fill: clamp(0, calc((var(--p) - 0.15) * 2.2), 1); list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-6); position: relative; }
  :global(html.js-motion:not(.reduced-motion)) .steps { --p: 0; }
  /* Track + fill */
  .steps::before, .steps::after { content: ""; position: absolute; border-radius: 4px; }
  .steps::before { background: color-mix(in srgb, var(--qw-teal-500) 25%, transparent); }
  .steps::after { background: var(--qw-teal-500); }
  .surface-teal .steps::before, .surface-green .steps::before { background: color-mix(in srgb, var(--qw-slate-900) 20%, transparent); }
  .surface-teal .steps::after, .surface-green .steps::after { background: var(--qw-slate-900); }
  /* Vertical (phones/tablets) */
  .steps::before, .steps::after { left: 27px; top: 28px; bottom: 28px; width: 4px; }
  .steps::after { bottom: auto; height: calc((100% - 56px) * var(--fill)); }
  .steps__item { position: relative; display: grid; grid-template-columns: 58px 1fr; gap: var(--space-5); align-items: start; }
  .steps__node { position: relative; z-index: 1; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: var(--qw-white); color: var(--qw-slate-900); border: 3px solid var(--qw-teal-500); font: var(--fw-black) var(--fs-sm)/1 var(--font-display); transition: background 400ms, color 400ms, transform 400ms var(--ease-out); }
  /* A node is "lit" once the fill has passed its position in the sequence. */
  .steps__item .steps__node { --lit: clamp(0, calc((var(--fill) * var(--n) - var(--k)) * 4), 1); background: color-mix(in srgb, var(--qw-teal-500) calc(var(--lit) * 100%), var(--qw-white)); transform: scale(calc(0.9 + var(--lit) * 0.1)); }
  .surface-teal .steps__node, .surface-green .steps__node { border-color: var(--qw-slate-900); }
  .steps__card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-5) var(--space-6); box-shadow: var(--shadow-sm); }
  .surface-dark .steps__card, .surface-product .steps__card { background: var(--qw-slate-850); }
  .steps__title { font-size: var(--fs-md); margin: 0 0 var(--space-2); }
  .steps__item p { font-size: var(--fs-sm); color: var(--color-muted); margin: 0; }
  .surface-teal .steps__item p, .surface-green .steps__item p { color: var(--qw-slate-800); }
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(var(--n), 1fr); gap: var(--space-5); }
    .steps::before, .steps::after { left: 29px; right: 29px; top: 27px; bottom: auto; width: auto; height: 4px; }
    .steps::after { right: auto; width: calc((100% - 58px) * var(--fill)); height: 4px; }
    .steps__item { grid-template-columns: 1fr; gap: var(--space-5); }
    .steps__card { min-height: 100%; }
  }
</style>
