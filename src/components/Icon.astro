---
/**
 * Inline SVG icon set (stroke icons, 24px grid). Decorative unless `label` is given.
 *
 * What: renders one named icon as an inline <svg>. All icons are hand-drawn paths on a 24x24 grid
 * using `currentColor` strokes, so they inherit the surrounding text colour and need no theming.
 *
 * Why: inline SVG avoids an icon font (which would add a font request and glyph-substitution risk,
 * see the glyph rules in CONTRIBUTING 3.4) and avoids extra image requests. Keeping every path in one
 * map means the whole set is visible and reviewable in one place.
 *
 * Props: name, label, class, size.
 *
 * Used by: Alert, Breadcrumbs, Button, ContactForm, EmptyState, EventCard, Footer, Header, ProductCard,
 * ServiceCard, templates/ServiceTemplate, and pages ([slug], careers, contact-us, events/[slug], index,
 * industries, products, products/agents-as-a-service, prototype, qualitywatcher-ai-tools, services).
 * Service records name their icon in `Service.icon` (src/data/services.ts).
 *
 * Accessibility: without `label` the icon is aria-hidden (decorative), which is right when visible text
 * sits next to it. With `label` it becomes role="img" with that accessible name; use this only for
 * icon-only meaning. focusable="false" stops old Internet Explorer/Edge from adding SVGs to the tab order.
 *
 * Gotchas:
 * - An unknown `name` silently falls back to the "info" icon. Check the spelling against `paths`.
 * - Paths are injected with set:html. They are trusted constants in this file; never pass user or
 *   CMS content into `paths`.
 * - To add an icon: draw it on a 24x24 grid with 1.75 stroke and round caps/joins, add one entry to
 *   `paths` (inner SVG markup only, no <svg> wrapper).
 */
interface Props {
  /** Key in the `paths` map below (e.g. 'arrow', 'external', 'check'). Unknown names render 'info'. */
  name: string;
  /** Accessible name. Omit for decorative icons (the default); provide for icons that carry meaning alone. */
  label?: string;
  /** Extra class names added after the built-in `icon icon-<name>` classes. */
  class?: string;
  /** Width/height attribute in px. Default 24. CSS from the parent usually overrides the rendered size. */
  size?: number
}
// `class` is a reserved word in JavaScript, so it is renamed to `cls` while destructuring.
const { name, label, class: cls, size } = Astro.props;
// Inner SVG markup per icon, all on the same 24x24 viewBox.
const paths: Record<string, string> = {
  // interface glyphs
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
  'chevron-right': '<path d="M9 6l6 6-6 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  alert: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5h.01"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.5h.01"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',
  filter: '<path d="M4 6h16M7 12h10M10 18h4"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z"/><circle cx="12" cy="10" r="2.3"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/>',
  phone: '<path d="M5 4h3.5l1.5 4.5-2.2 1.3a11 11 0 0 0 6.4 6.4l1.3-2.2L20 15.5V19a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"/>',
  // service / capability glyphs
  automation: '<rect x="3.5" y="4" width="17" height="12" rx="2"/><path d="M8 20h8M12 16v4M8 10l2 2 4-4"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>',
  devices: '<rect x="2.5" y="5" width="13" height="10" rx="1.5"/><rect x="17" y="8" width="4.5" height="11" rx="1"/><path d="M6 19h6"/>',
  gauge: '<path d="M4.5 17a8.5 8.5 0 1 1 15 0"/><path d="M12 13l4-4"/><circle cx="12" cy="13" r="1.2"/>',
  api: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
  squad: '<circle cx="12" cy="7.5" r="3"/><circle cx="5" cy="11" r="2"/><circle cx="19" cy="11" r="2"/><path d="M6.5 20a5.5 5.5 0 0 1 11 0M2 19a3 3 0 0 1 4-2.8M22 19a3 3 0 0 0-4-2.8"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5 5-2z"/>',
  code: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4"/>',
  cycle: '<path d="M20 12a8 8 0 0 1-14 5.3M4 12a8 8 0 0 1 14-5.3"/><path d="M18 3v4h-4M6 21v-4h4"/>',
  team: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9.5" r="2.4"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M14.5 20a4 4 0 0 1 6.5-3.1"/>',
  'person-plus': '<circle cx="10" cy="8" r="3.5"/><path d="M3.5 20a6.5 6.5 0 0 1 13 0M19 8v6M16 11h6"/>',
  learn: '<path d="M2.5 9L12 4.5 21.5 9 12 13.5 2.5 9z"/><path d="M6.5 11v5c3 2.5 8 2.5 11 0v-5"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M6 18l2.5-2.5M15.5 8.5L18 6"/>',
  agent: '<rect x="5" y="7" width="14" height="11" rx="3"/><path d="M12 7V4M9.5 12h.01M14.5 12h.01M9.5 15h5"/>',
  data: '<ellipse cx="12" cy="6" rx="7.5" ry="2.8"/><path d="M4.5 6v12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8V6M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8"/>',
  shield: '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.4-7.5 9.5-4.3-1.1-7.5-4.9-7.5-9.5V6L12 3z"/><path d="M9 12l2 2 4-4"/>',
  access: '<circle cx="12" cy="4.5" r="1.8"/><path d="M5 8.5l7 1.5 7-1.5M12 10v5l-3 6M12 15l3 6"/>',
  doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>',
  // social
  linkedin: '<rect x="3.5" y="3.5" width="17" height="17" rx="2"/><path d="M8 10.5V17M8 7.5h.01M12 17v-3.8a2.3 2.3 0 0 1 4.6 0V17M12 10.5V17"/>',
};
// Fall back to a neutral icon rather than rendering an empty <svg> for a typo'd name.
const d = paths[name] ?? paths.info;
---
{/* aria-hidden when decorative; role="img" + aria-label when a label is given. Stroke uses currentColor so the
    icon takes the text colour of its parent. */}
<svg class:list={['icon', `icon-${name}`, cls]} viewBox="0 0 24 24" width={size ?? 24} height={size ?? 24} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false" set:html={d} />
