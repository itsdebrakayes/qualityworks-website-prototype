---
/**
 * Global footer — link columns are derived from navigation.ts (same source as the header).
 *
 * What: the dark site footer: logo, company statement, office addresses and phone numbers, email,
 * link columns, copyright line, legal links and social links.
 *
 * Why: deriving the columns from `footerColumns()` in src/data/navigation.ts means a page added to the
 * main navigation shows up in the footer too, so the two can never drift apart. Contact details come
 * from src/data/site.ts so they are maintained in one place.
 *
 * Props: none. Data: `footerColumns()` (navigation.ts) and `site` (site.ts).
 *
 * Used by: layouts/BaseLayout.astro only (rendered once on every page).
 *
 * Accessibility:
 * - The link columns are a <nav aria-label="Footer"> landmark, distinct from the header's "Main" nav.
 * - Offices sit in an <address> element (contact information for the organisation).
 * - Logo alt names the link destination ("QualityWorks Consulting Group home"), per review round 1,
 *   finding D1 (logos carry the link name in alt instead of aria-label).
 * - External and social links open in a new tab and say so with visually hidden text.
 * - Footer link colour #D5DDE4 on ink #16202B is about 12:1.
 *
 * Gotchas:
 * - The copyright year is computed when the site is BUILT, not when the page is viewed. A static build
 *   from December will still say that year in January until the site is rebuilt.
 * - The "Careers" link in the bottom row is hard-coded here, not taken from site.legal.
 * - Column contents (which groups, how many links) are decided in footerColumns(), not here.
 */
import Icon from './Icon.astro';
import { footerColumns } from '../data/navigation';
import { site } from '../data/site';
// Columns derived from the primary navigation (see Why above).
const columns = footerColumns();
// Build-time year (see Gotchas).
const year = new Date().getFullYear();
---
<footer class="site-footer surface-dark">
  <div class="container">
    <div class="site-footer__top">
      {/* Brand column: logo, statement and contact details. */}
      <div class="site-footer__brand">
        <a href="/"><img src="/brand/qualityworks-logo-color.png" alt="QualityWorks Consulting Group home" width="190" height="41" /></a>
        <p>{site.footerStatement}</p>
        <address>
          {site.offices.map((o) => (
            <div class="office">
              <p class="office__label">{o.label}</p>
              <p>{o.locality}</p>
              {/* tel: uses the machine-readable number; the visible text uses the formatted display string. */}
              {o.phones.map((p) => <p><a href={`tel:${p.tel}`}>{p.display}</a></p>)}
            </div>
          ))}
          <p class="office__mail"><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </address>
      </div>
      {/* Link columns, generated from the navigation data. */}
      <nav class="site-footer__nav" aria-label="Footer">
        {columns.map((col) => (
          <div>
            <p class="site-footer__heading">{col.heading}</p>
            <ul>
              {col.links.map((l: any) => (
                <li><a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}{l.external && <span class="visually-hidden"> (external site, opens in a new tab)</span>}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    {/* Bottom row: copyright, legal links (plus Careers) and social links. */}
    <div class="site-footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <ul class="site-footer__legal">
        {site.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/careers/">Careers</a></li>
      </ul>
      <ul class="site-footer__social" aria-label="QualityWorks on social media">
        {site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}<span class="visually-hidden"> (opens in a new tab)</span></a></li>)}
      </ul>
    </div>
  </div>
</footer>
<style>
  /* Footer surface: ink background with surface-dark tokens (class on the element). */
  .site-footer { color: var(--color-text); background: var(--qw-ink-900); padding-block: var(--space-16) var(--space-8); font-size: var(--fs-sm); }
  /* Links: light grey-blue (#D5DDE4, about 12:1 on ink), no underline until hover, white on hover. */
  .site-footer a { color: #D5DDE4; text-decoration: none; }
  .site-footer a:hover { color: #fff; text-decoration: underline; }
  /* Top area: stacked on mobile; from 1024px a fixed 19rem brand column beside the link columns. */
  .site-footer__top { display: grid; gap: var(--space-12); }
  @media (min-width: 1024px) { .site-footer__top { grid-template-columns: 19rem 1fr; gap: var(--space-16); } }
  .site-footer__brand img { width: 180px; margin-bottom: var(--space-5); }
  .site-footer__brand > p { color: var(--qw-slate-300); }
  /* Offices: two columns side by side; browsers italicise <address> by default, so reset font-style. */
  address { font-style: normal; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); margin-top: var(--space-6); }
  address p { margin: 0; }
  /* Office label: mono uppercase in logo green (accent on dark, about 8:1 on ink). */
  .office__label { font: var(--fw-medium) var(--fs-xs)/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--qw-green-400); margin-bottom: 0.3rem !important; }
  /* Email spans both office columns. */
  .office__mail { grid-column: 1 / -1; display: flex; gap: 0.5rem; align-items: center; }
  .office__mail :global(svg) { width: 18px; height: 18px; color: var(--qw-teal-300); }
  /* Link columns: as many 8.75rem (140px) columns as fit; footerColumns() currently returns 5 columns. */
  .site-footer__nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.75rem, 1fr)); gap: var(--space-8); }
  .site-footer__heading { font-weight: var(--fw-bold); color: #fff; margin-bottom: var(--space-3); }
  .site-footer__nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  /* 2px vertical padding enlarges each link's hit area slightly without changing the look. */
  .site-footer__nav a { display: inline-block; padding-block: 2px; }
  /* Bottom row: wraps on small screens; a faint 10% white rule separates it from the columns. */
  .site-footer__bottom { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-8); justify-content: space-between; align-items: center; margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid rgba(255,255,255,0.1); color: var(--qw-slate-300); }
  .site-footer__bottom p { margin: 0; }
  .site-footer__legal, .site-footer__social { display: flex; flex-wrap: wrap; gap: var(--space-5); list-style: none; margin: 0; padding: 0; }
</style>
