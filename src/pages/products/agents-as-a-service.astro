---
import { rn, REVIEW } from '../../lib/release';
/**
 * AGENTS AS A SERVICE (proposed corporate page). The marketplace at agents.qualityworkscg.com
 * remains the system of record for catalog, packages, prices and checkout. This page explains
 * the offer, contrasts it with custom consulting, previews the catalog, and hands off clearly.
 * Primary persona: SMB Founder/COO (D). Secondary: Marketing/Ops leader (E).
 *
 * URL: /products/agents-as-a-service/. Marked "(proposed)" in the docs/03 page map: the marketplace exists
 *   but is not linked from the live corporate navigation (audit P-01), so this route needs QM-41.
 * Persona / CTA (docs/03-page-map-personas.md §2, "Agents as a Service" row): primary D; secondary E.
 *   Core question: "Is a ready-made agent right for us? How do I buy one?" Proof required: marketplace
 *   catalog snapshot. Primary CTA: "Browse the marketplace" (external, `ctas.agentsMarketplace`).
 *   Secondary: "Talk to us first" (/contact-us/?topic=smb-ai). Journeys D and E in docs/03 §3 use this page.
 * What, top to bottom (redesign 24 Nov 2026): bright green hero with a hand-off note and orbiting agent
 *   persona portraits (components/products/AgentOrbit.astro); the problem; a marketplace-vs-custom-AI
 *   comparison table; a catalog preview (portrait cards) with a label legend and department filter chips;
 *   an interactive "agent → workflow → human approval" visualisation (components/products/AgentFlow.astro,
 *   replaces the old hero org chart); three graphical "How it works" steps; a human-oversight section with a
 *   people photo (proposed copy, REVIEW note); FAQ; closing CtaBand.
 * Data: src/data/products.ts (`agentSnapshot`: 8 agents observed on 17 Nov 2026; `agentCatalogFacts`:
 *   total observed, departments, steps), src/data/site.ts (`ctas.agentsMarketplace`). Problem list,
 *   comparison rows and FAQs are inline.
 * SEO: inline title/description. JSON-LD: FAQPage from `faqs` (faqLd), plus BreadcrumbList
 *   (Home > Products > Agents as a Service) from BaseLayout.
 * Review/release: the label legend carries `data-review-note={rn(...)}` (open question Q-21: the
 *   marketplace does not define its labels). No REVIEW/RELEASE branches otherwise.
 * Gotchas:
 *   - Prices are deliberately NOT shown, even though `agentSnapshot` holds them: the marketplace is the
 *     system of record (see the comment above `agentSnapshot` in products.ts). Do not render `price`.
 *   - Integrations are unknown per agent (empty arrays); never invent them.
 *   - The department chip filter is a small local script, not src/lib/filters.ts: no URL state, no empty
 *     state (every department chip comes from the snapshot, so it always has at least one agent).
 *   - Two of the four FAQs are proposed copy pending approval. They render on the page, but faqLd()
 *     emits only approved / published-live answers, so the FAQPage JSON-LD holds two questions.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import AgentOrbit from '../../components/products/AgentOrbit.astro';
import AgentFlow from '../../components/products/AgentFlow.astro';
import ReviewPhoto from '../../components/products/ReviewPhoto.astro';
import { peopleImage } from '../../data/peopleImagery';
import { agentSnapshot, agentCatalogFacts } from '../../data/products';
import { ctas } from '../../data/site';
import { faqLd } from '../../lib/schema';
import type { FaqItem } from '../../data/types';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Products', href: '/products/' }, { label: 'Agents as a Service' }];
// Departments present in the snapshot (in data order). Drives the org chart rows and the filter chips.
const departments = [...new Set(agentSnapshot.map((a) => a.category))];
// Display text for the marketplace listing label (AgentRecord['availabilityStatus']).
const availability = { 'ready-now': 'Ready now', 'quick-launch': 'Quick launch', 'custom-build': 'Custom build', unknown: 'Check marketplace' } as const;
// FAQ items with provenance: marketplace facts are 'external-platform'; corporate wording is 'proposed-copy'.
const faqs: FaqItem[] = [
  { q: 'What is Agents as a Service?', a: 'Agents as a Service is QualityWorks’ marketplace of named AI agents for sales, support, marketing, admin, finance and operations. You choose an agent or a package, and QualityWorks configures it for your tools. Launch support and onboarding are included.', provenance: { source: 'external-platform', approval: 'published-live', sourceUrl: 'https://agents.qualityworkscg.com/' } },
  { q: 'Where do I buy an agent?', a: 'On the separate marketplace at agents.qualityworkscg.com. Prices, packages and checkout live there; this corporate page does not take orders.', provenance: { source: 'proposed-copy', approval: 'pending-approval' } },
  { q: 'Do I need a discovery call?', a: 'No. The marketplace lets you check out directly, then book a short onboarding session. You can also book an optional call first.', provenance: { source: 'external-platform', approval: 'published-live', sourceUrl: 'https://agents.qualityworkscg.com/' } },
  { q: 'Which tools do the agents integrate with?', a: 'Integrations are confirmed per agent during onboarding. The public catalog does not list integrations per agent, so we don’t list them here.', provenance: { source: 'proposed-copy', approval: 'pending-approval', note: 'Product owner to supply integration list if one exists.' } },
];
---
<BaseLayout seo={{ title: 'Agents as a Service: AI Agents for Business Teams | QualityWorks', description: 'Named AI agents for sales, support, marketing, admin, finance and operations, configured for your tools by QualityWorks. Compare with custom AI consulting.' }} breadcrumbs={crumbs} jsonLd={[faqLd(faqs)].filter((x) => x !== null)}>
  <PageHero tone="green" eyebrow="QualityWorks AI Agents as a Service" title="Hire your AI workforce in days, not months" lede="Buy named AI agents for sales, support, marketing, admin, finance and operations. QualityWorks configures them for your tools so your team can stop losing time to repeat work." breadcrumbs={crumbs} primary={ctas.agentsMarketplace} secondary={{ label: 'Not sure? Talk to us first', href: '/contact-us/?topic=smb-ai' }}>
    {/* Hand-off note under the hero lede: buying happens on the separate marketplace. */}
    <p class="handoff"><Icon name="info" /><span>Packages, prices and checkout are on the separate marketplace at <strong>agents.qualityworkscg.com</strong>.</span></p>
    {/* Hero aside: agent persona portraits orbiting "your team" (decorative, pointer parallax). */}
    <Fragment slot="aside"><AgentOrbit /></Fragment>
  </PageHero>

  {/* The problem: the repetitive work SMB teams want to offload. */}
  <section class="section surface-white" aria-labelledby="problem-title">
    <div class="container split">
      <div data-reveal><p class="eyebrow">The problem</p><h2 id="problem-title" class="display-sm">Your team is doing work <span class="mark">AI should handle</span></h2></div>
      <div>
        <p class="lede" data-reveal>Too much time goes to repetitive tasks, manual follow-ups and operational overhead.</p>
        <ul class="pains" data-reveal-stagger>
          <li data-reveal><span class="icon-badge icon-badge--mint"><Icon name="mail" /></span>Customer questions slow down your team</li>
          <li data-reveal><span class="icon-badge icon-badge--mint"><Icon name="cycle" /></span>Sales opportunities stall without follow-up</li>
          <li data-reveal><span class="icon-badge icon-badge--mint"><Icon name="doc" /></span>Internal updates take hours to compile</li>
          <li data-reveal><span class="icon-badge icon-badge--mint"><Icon name="team" /></span>Scaling requires hiring, and hiring is expensive</li>
        </ul>
      </div>
    </div>
  </section>

  {/* Comparison: marketplace agent vs custom AI consulting, so visitors pick the right route before clicking. */}
  <section class="section surface-mint" aria-labelledby="compare-title">
    <div class="container">
      <SectionHeading eyebrow="Choose the right route" title="Marketplace agent or custom AI solution?" lede="Both come from QualityWorks. They solve different problems." id="compare-title" />
      <div class="table-scroll compare-wrap" data-reveal>
        <table class="data-table compare">
          <caption class="visually-hidden">Agents as a Service compared with AI & Agentic Business Solutions consulting</caption>
          <thead><tr><th scope="col"></th><th scope="col">Agents as a Service</th><th scope="col">AI & Agentic Business Solutions</th></tr></thead>
          <tbody>
            <tr><th scope="row">Best when</th><td>The workflow is common: lead follow-up, scheduling, support FAQs, reporting</td><td>The process is specific to your organization or customer-facing</td></tr>
            <tr><th scope="row">What you get</th><td>A pre-defined, named agent configured for your tools</td><td>An agent or AI solution designed and built around your process</td></tr>
            <tr><th scope="row">How you start</th><td>Choose on the marketplace and check out; book onboarding</td><td>A conversation with our team to scope the work</td></tr>
            <tr><th scope="row">Where it happens</th><td>agents.qualityworkscg.com (separate platform)</td><td>A consulting engagement with QualityWorks</td></tr>
            <tr><th scope="row">Pricing</th><td>Published on the marketplace</td><td>Scoped per engagement</td></tr>
          </tbody>
        </table>
      </div>
      <div class="btn-row btn-row--equal compare__ctas">
        <Button cta={{ ...ctas.agentsMarketplace, kind: 'primary' }} />
        <Button href="/services/ai-service/" label="Explore custom AI solutions" variant="secondary" />
      </div>
    </div>
  </section>

  {/* Catalog preview: legend for listing labels, department chips, agent cards with persona portraits (no prices). */}
  <section class="section surface-white" aria-labelledby="catalog-title">
    <div class="container">
      <SectionHeading eyebrow="Catalog preview" title="A sample of available agents" lede={`The marketplace listed ${agentCatalogFacts.totalAgentsObserved} agents across ${agentCatalogFacts.departments.length} departments on 17 Nov 2026. This preview is a snapshot; the marketplace is always current.`} id="catalog-title" />
      <div class="legend" data-review-note={rn('Marketplace does not publish definitions for these labels — Q-21')}>
        <p class="legend__title">How to read these labels</p>
        <dl>
          <div><dt><span class="badge">Ready now</span> <span class="badge">Quick launch</span> <span class="badge">Custom build</span></dt><dd>The listing label each agent carries on the marketplace (observed 17 Nov 2026). The marketplace does not publish what each label means, so treat them as indications only. Every agent still needs a setup call before QualityWorks deploys it.</dd></div>
          <div><dt>Guided Preview</dt><dd>A preview button on each marketplace listing. It is a walkthrough of the agent, not a live deployment or a trial account.</dd></div>
        </dl>
      </div>
      <div class="filter-chips" role="group" aria-label="Filter agents by department">
        <button type="button" class="chip" aria-pressed="true" data-dept="all">All</button>
        {departments.map((d) => <button type="button" class="chip" aria-pressed="false" data-dept={d}>{d}</button>)}
      </div>
      {/* Screen-reader-only live region: the chip script writes "Showing N agents" here after each filter. */}
      <p class="visually-hidden" aria-live="polite" data-agent-count></p>
      <ul class="agents" data-agents>
        {agentSnapshot.map((a, i) => (
          <li class="agent" data-dept={a.category}>
            <div class="agent__card" data-tilt="6">
              <div class:list={['agent__media', `agent__media--${i % 3}`]}><img src={`/agents/${a.id}.webp`} alt={`${a.name}, AI agent persona portrait from the marketplace`} width="320" height="320" loading="lazy" decoding="async" /><span class="badge agent__label" title="Marketplace listing label">{availability[a.availabilityStatus]}</span></div>
              <div class="agent__body">
                <h3>{a.name}</h3><p class="agent__role">{a.role}</p>
                <p class="agent__desc">{a.description}</p>
                <p class="agent__meta"><span class="agent__dept">{a.category}</span></p>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="catalog-note">Pricing, packages, integrations and checkout: <a href="https://agents.qualityworkscg.com/" target="_blank" rel="noopener">view the full catalog on the marketplace<span class="visually-hidden"> (opens agents.qualityworkscg.com in a new tab)</span></a>.</p>
    </div>
  </section>

  {/* Interactive visualisation: choose an agent → its illustrative path to a human approval checkpoint. */}
  <section class="section surface-teal" aria-labelledby="flow-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Agents, workflows, people</p>
        <h2 id="flow-title" class="display-sm">See where each agent fits, and where <span class="mark">your team decides</span></h2>
        <p class="lede">Pick an agent to follow a piece of work from arrival to a human approval checkpoint.</p>
      </div>
      <AgentFlow />
    </div>
  </section>

  {/* How it works: marketplace steps as a graphical, scroll-drawn track; note that nothing deploys at checkout. */}
  <section class="section surface-white" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">How it works</p>
        <h2 id="steps-title" class="display-sm">Three steps to an agent in your workflow</h2>
      </div>
      <div class="steps-wrap" data-scroll-progress>
      <span class="steps__track" aria-hidden="true"><i></i></span>
      <ol class="steps" data-reveal-stagger>
        {agentCatalogFacts.steps.map((st, i) => (
          <li class:list={['step', `step--${i}`]} data-reveal="up">
            <div class="step__visual" aria-hidden="true">
              {i === 0 && <span class="step__faces">{agentSnapshot.slice(0, 4).map((a) => <img src={`/agents/${a.id}.webp`} alt="" width="56" height="56" loading="lazy" />)}<b>+{agentCatalogFacts.totalAgentsObserved - 4}</b></span>}
              {i === 1 && <span class="chip-ui step__chip"><span class="chip-ui__icon chip-ui__icon--slate"><Icon name="calendar" /></span><span>Onboarding session<small>Connect tools and workflows</small></span></span>}
              {i === 2 && <span class="chip-ui step__chip"><span class="chip-ui__dot"></span><span>Agent deployed<small>Into your workstream</small></span></span>}
            </div>
            <span class="step__num" aria-hidden="true">{i + 1}</span>
            <span class:list={['icon-badge', i === 1 && 'icon-badge--green', i === 2 && 'icon-badge--slate']}><Icon name={['search', 'cycle', 'spark'][i]} /></span>
            <h3>{st.title}</h3>
            <p>{st.text}</p>
          </li>
        ))}
      </ol>
      </div>
      <p class="handoff handoff--light"><Icon name="external" /><span>Steps 1–2 happen on agents.qualityworkscg.com. Step 3 is completed by the QualityWorks team after the setup call. Nothing is deployed automatically at checkout.</span></p>
    </div>
  </section>

  {/* Human oversight: people photo + review chips. Copy restates facts already on this page / the marketplace. */}
  <section class="section surface-mint" aria-labelledby="human-title">
    <div class="container human">
      <ReviewPhoto tone="green" image={peopleImage('finance-client-meeting')} chips={[
        { title: 'Kai: drafting reply', sub: 'Human review in control', faces: ['/agents/kai-customer-service.webp'], x: '2%', y: '6%' },
        { title: 'Setup call', sub: 'With the QualityWorks team', icon: 'calendar', tone: 'slate', x: '50%', y: '62%' },
        { title: 'Human approval', sub: 'Kept in the loop', dot: true, x: '8%', y: '80%' },
      ]} />
      <div>
        <p class="eyebrow" data-reveal>Human oversight</p>
        <h2 id="human-title" class="display-sm" data-reveal>Agents take the repeat work. <span class="mark">People stay in charge.</span></h2>
        <ul class="oversight" data-reveal-stagger>
          <li data-reveal><span class="icon-badge icon-badge--green"><Icon name="calendar" /></span><span>Every agent still needs a setup call before QualityWorks deploys it.</span></li>
          <li data-reveal><span class="icon-badge icon-badge--slate"><Icon name="shield" /></span><span>Nothing is deployed automatically at checkout. QualityWorks finalizes setup and deploys the agents into your workstream.</span></li>
          <li data-reveal><span class="icon-badge icon-badge--mint"><Icon name="team" /></span><span>Agents such as Kai handle common support questions quickly while keeping human review in control.</span></li>
        </ul>
        {REVIEW && <p class="small-note" data-review-note={rn('Proposed section — confirm human-oversight wording with product owner')}>Proposed section built from statements already on this page and the marketplace listing. Confirm wording with the product owner.</p>}
      </div>
    </div>
  </section>

  {/* FAQ: same `faqs` array as the FAQPage JSON-LD. */}
  <section class="section surface-white" aria-labelledby="faq-title">
    <div class="container container--narrow">
      <SectionHeading eyebrow="FAQ" title="Agents as a Service questions" id="faq-title" />
      <FaqAccordion items={faqs} />
    </div>
  </section>

  {/* Closing CTA: marketplace hand-off or a guided conversation (?topic=smb-ai pre-tags the contact form). */}
  <CtaBand tone="green" title="Start with one agent, or build a cross-functional team." text="Browse the marketplace, or talk to us if you’re not sure an agent is the right fit." primary={ctas.agentsMarketplace} secondary={{ label: 'Talk to us first', href: '/contact-us/?topic=smb-ai' }} />
</BaseLayout>
<style>
  /* Hand-off note: slate-900 on the green hero; teal-700 icon (--light modifier) on white. */
  .handoff { display: flex; gap: var(--space-2); align-items: flex-start; font-size: var(--fs-sm); color: var(--color-text); margin-top: var(--space-6); max-width: 34rem; }
  .handoff :global(svg) { width: 18px; height: 18px; flex: none; margin-top: 2px; }
  .handoff--light :global(svg) { color: var(--qw-teal-700); }
  /* Problem list as tiles. */
  .pains { list-style: none; padding: 0; margin: var(--space-6) 0 0; display: grid; gap: var(--space-3); }
  @media (min-width: 640px) { .pains { grid-template-columns: 1fr 1fr; } }
  .pains li { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-5); border-radius: 20px; background: var(--qw-mint-50); font: var(--fw-bold) var(--fs-base)/1.35 var(--font-display); color: var(--qw-slate-900); height: 100%; }
  .pains .icon-badge { background: var(--qw-white); width: 44px; height: 44px; }
  /* Comparison table. */
  .compare-wrap { background: var(--qw-white); border-radius: 22px; padding: var(--space-2); }
  .compare th[scope="row"] { width: 12rem; background: var(--qw-mint-50); position: static; }
  .compare thead th:nth-child(2) { background: var(--qw-green-500); color: var(--qw-slate-900); }
  .compare__ctas { margin-top: var(--space-6); }
  /* Label legend above the catalog. */
  .legend { margin: 0 0 var(--space-8); padding: var(--space-5); border-radius: 20px; background: var(--qw-mint-50); font-size: var(--fs-sm); }
  .legend__title { font-weight: var(--fw-bold); color: var(--color-heading); }
  .legend dl { margin: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .legend dl { grid-template-columns: 1.4fr 1fr; } }
  .legend dt { display: flex; flex-wrap: wrap; gap: var(--space-2); font-weight: var(--fw-semibold); color: var(--color-heading); margin-bottom: var(--space-1); }
  .legend dd { margin: 0; }
  /* Department chips; pressed state = slate fill. */
  .filter-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-6); }
  .chip { min-height: 40px; padding: 0.4rem 1rem; border-radius: var(--radius-pill); border: 1px solid var(--color-border); background: var(--qw-white); color: var(--qw-slate-900); font: var(--fw-semibold) var(--fs-sm)/1 var(--font-display); cursor: pointer; }
  .chip:hover { border-color: var(--qw-teal-700); }
  .chip[aria-pressed="true"] { background: var(--qw-slate-900); color: var(--qw-white); border-color: var(--qw-slate-900); }
  /* Agent cards with persona portraits: equal heights; [hidden] rule beats display:flex. */
  .agents { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); align-items: stretch; }
  .agent { display: flex; }
  .agent[hidden] { display: none; }
  .agent__card { flex: 1; display: flex; flex-direction: column; border-radius: 22px; overflow: hidden; background: var(--qw-white); border: 1px solid color-mix(in srgb, var(--qw-slate-900) 10%, transparent); transition: box-shadow 300ms; }
  .agent__card:hover { box-shadow: 0 30px 50px -30px rgba(34,43,55,.5); }
  .agent__media { position: relative; background: var(--qw-teal-500); aspect-ratio: 5 / 4; display: grid; place-items: end center; overflow: hidden; }
  .agent__media--1 { background: var(--qw-green-500); } .agent__media--2 { background: var(--qw-mint-50); }
  .agent__media img { width: 78%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 50% 50% 0 0; translate: 0 8%; transition: transform 500ms var(--ease-out); }
  .agent__card:hover .agent__media img { transform: scale(1.05); }
  .agent__label { position: absolute; top: 12px; left: 12px; background: var(--qw-white); color: var(--qw-slate-900); border-color: transparent; }
  .agent__body { flex: 1; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-5); }
  .agent h3 { font-size: var(--fs-md); margin: 0; }
  .agent__role { margin: 0; font: var(--fw-bold) 0.72rem/1.3 var(--font-display); letter-spacing: 0.06em; text-transform: uppercase; color: var(--qw-teal-700); }
  .agent__desc { font-size: var(--fs-sm); margin: 0; }
  .agent__meta { margin: auto 0 0; padding-top: var(--space-3); font-size: var(--fs-xs); color: var(--color-muted); }
  .catalog-note { margin-top: var(--space-8); }
  /* How it works: three tiles on a track that fills as the section scrolls through (--p from data-scroll-progress). */
  .steps-wrap { position: relative; }
  .steps { list-style: none; padding: 0; margin: 0; position: relative; display: grid; gap: var(--space-5); }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .steps__track { display: none; }
  @media (min-width: 900px) {
    .steps__track { display: block; position: absolute; left: 8%; right: 8%; top: 5.25rem; height: 6px; border-radius: 4px; background: var(--qw-mint-50); z-index: 0; }
    .steps__track i { display: block; height: 100%; width: calc(min(1, var(--p, 1) * 1.6) * 100%); background: var(--qw-green-500); border-radius: inherit; transition: width 200ms linear; }
  }
  .step { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); border-radius: 24px; background: var(--qw-white); border: 1px solid color-mix(in srgb, var(--qw-slate-900) 10%, transparent); height: 100%; }
  .step__visual { height: 7.5rem; border-radius: 18px; background: var(--qw-teal-500); display: grid; place-items: center; margin-bottom: var(--space-4); position: relative; overflow: hidden; }
  .step--1 .step__visual { background: var(--qw-green-500); } .step--2 .step__visual { background: var(--qw-slate-900); }
  .step__faces { display: flex; align-items: center; }
  .step__faces img { width: 56px; height: 56px; border-radius: 50%; border: 3px solid var(--qw-white); object-fit: cover; background: var(--qw-mint-50); margin-left: -14px; }
  .step__faces img:first-child { margin-left: 0; }
  .step__faces b { margin-left: -14px; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--qw-slate-900); color: var(--qw-white); border: 3px solid var(--qw-white); font: var(--fw-bold) var(--fs-sm)/1 var(--font-display); }
  .step__chip { position: static; animation: qw-float 5s ease-in-out infinite; }
  .step__num { position: absolute; right: var(--space-6); top: calc(7.5rem + var(--space-8)); font: var(--fw-black) 3rem/1 var(--font-display); color: var(--qw-teal-500); opacity: 0.9; }
  .step h3 { margin: var(--space-2) 0 0; font-size: var(--fs-lg); }
  .step p { margin: 0; }
  .steps:hover .step__faces img { transition: margin 300ms; margin-left: -6px; }
  .steps:hover .step__faces img:first-child { margin-left: 0; }
  /* Human oversight section. */
  .human { display: grid; gap: var(--space-12); align-items: center; }
  @media (min-width: 960px) { .human { grid-template-columns: 1fr 1fr; gap: var(--space-16); } }
  .human h2.display-sm { font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem); }
  .split h2.display-sm { font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem); }
  .oversight { list-style: none; padding: 0; margin: var(--space-8) 0 0; display: grid; gap: var(--space-4); }
  .oversight li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: center; padding: var(--space-4); border-radius: 18px; background: var(--qw-white); }
  .oversight .icon-badge { width: 44px; height: 44px; border-radius: 13px; }
  .oversight .icon-badge :global(svg) { width: 22px; height: 22px; }
  .small-note { font-size: var(--fs-xs); margin-top: var(--space-4); color: var(--qw-muted); }
</style>
<script>
  // Department filter (single-select). Clicking a chip marks it pressed, hides cards from other departments
  // ("all" shows everything) and announces the visible count in the live region. Simpler than
  // src/lib/filters.ts: no URL state and no empty state (every chip has at least one agent).
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-dept]');
  const cards = document.querySelectorAll<HTMLElement>('[data-agents] > li');
  const live = document.querySelector('[data-agent-count]')!;
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    let n = 0;
    cards.forEach((card) => { const show = chip.dataset.dept === 'all' || card.dataset.dept === chip.dataset.dept; card.hidden = !show; if (show) n++; });
    live.textContent = `Showing ${n} agent${n === 1 ? '' : 's'}`;
  }));
</script>
