---
import { RELEASE, REVIEW, rn } from '../../lib/release';
/**
 * INDUSTRY / AUDIENCE template. Each record supplies its own challenge, considerations, capabilities
 * and evidence — pages are not name-swapped copies. Summary records show a migration notice.
 *
 * URLs: /industries/{slug}/. getStaticPaths() emits one route per record in src/data/industries.ts
 *   (`industries`), using `slug` as the URL segment and passing the record as `props.ind`. That covers the
 *   live sectors (finance-banking, healthcare, social-impact, insurance, logistics, media-entertainment,
 *   retail, technology) and the two proposed audience pages (public-sector, small-business).
 * Persona / CTA (docs/03-page-map-personas.md §2):
 *   - Industry pages: primary A (sector buyer), secondary B. Core question "Why is QualityWorks relevant
 *     to my sector?" Primary CTA "Talk to an industry expert".
 *   - Public Sector (proposed): primary C (procurement/tech lead), secondary A. Core question "Can they
 *     deliver in a regulated environment, with evidence?" CTA "Make a procurement inquiry"
 *     (/contact-us/?topic=procurement).
 *   - Small Business (proposed): primary D (founder/COO), secondary E. Core question "Where should we
 *     begin, and do we need to buy anything?" CTA "Help me choose" (/contact-us/?topic=smb-ai).
 *   The CTA actually rendered is each record's `primaryCta`; personas are recorded in `personas`.
 * Data: src/data/industries.ts (the record), src/data/services.ts (capabilities -> ServiceCards),
 *   src/data/products.ts (optional related products), src/data/caseStudies.ts (evidence cards).
 * SEO: title/description from the record's `seo`. Breadcrumbs Home > Who We Help > {name} produce
 *   BreadcrumbList JSON-LD via BaseLayout. No other JSON-LD.
 * Review/release behaviour:
 *   - Hero eyebrow gets a "· proposed page" suffix for proposed records in REVIEW builds only.
 *   - Summary records (contentDepth 'summary') show a warning Alert; proposed records show an info Alert.
 *     Both Alerts are rendered in every build, but in RELEASE builds their wrapper carries
 *     `data-release-blocker`, so scripts/release-check.mjs fails until the copy is migrated / QM-41
 *     approves the route.
 *   - ClaimRef badges (C19 healthcare training, C13 WBE/MBE/WOSB certifications) only render in review builds.
 *   - The evidence note carries `data-review-note` (review builds only).
 * Gotchas:
 *   - Unknown service/product/case-study slugs fail the build (src/data/integrity.ts); `.filter(Boolean)`
 *     below only narrows the types.
 *   - The ClaimRef placement is matched on the record slug plus the consideration title prefix
 *     ("Compliance", "Procurement"). Renaming those titles in industries.ts removes the annotation.
 *   - The CtaBand title special-cases public-sector; every other record gets "Talk to our {name} team."
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { peopleImage } from '../../data/peopleImagery';
import SectionHeading from '../../components/SectionHeading.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Alert from '../../components/Alert.astro';
import ClaimRef from '../../components/ClaimRef.astro';
import Icon from '../../components/Icon.astro';
import { industries } from '../../data/industries';
import { serviceBySlug } from '../../data/services';
import { productBySlug } from '../../data/products';
import { caseStudyBySlug } from '../../data/caseStudies';
import type { Industry } from '../../data/types';
export function getStaticPaths() { return industries.map((i) => ({ params: { slug: i.slug }, props: { ind: i } })); }
const { ind } = Astro.props as { ind: Industry };
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Who We Help', href: '/industries/' }, { label: ind.name }];
// Resolve slugs from the record into full objects for the cards; missing slugs are dropped (see Gotchas).
const caps = ind.capabilities.map(serviceBySlug).filter(Boolean);
const prods = (ind.products ?? []).map(productBySlug).filter(Boolean);
const cases = ind.caseStudies.map(caseStudyBySlug).filter(Boolean);
---
<BaseLayout seo={ind.seo} breadcrumbs={crumbs}>
  {/* Hero: secondary CTA jumps to the #evidence section further down this page. */}
  <PageHero ui="people" image={ind.heroImage ? peopleImage(ind.heroImage) : undefined} eyebrow={ind.status === 'proposed' && REVIEW ? `${ind.name} · proposed page` : ind.name} title={ind.heroTitle} lede={ind.heroLede} breadcrumbs={crumbs} primary={ind.primaryCta} secondary={{ label: 'See relevant results', href: '#evidence' }} />

  {/* Status notices: migration pending (summary records) and proposed route (needs QM-41). Release blockers in release builds. */}
  {ind.contentDepth === 'summary' && (
    <div class="container" data-release-blocker={RELEASE ? 'summary-record: industry copy not migrated' : undefined}><Alert tone="warning" title="Summary record — full content pending migration" class="ind-alert"><p>{ind.provenance.note}</p></Alert></div>
  )}
  {ind.status === 'proposed' && (
    <div class="container" data-release-blocker={RELEASE ? 'proposed-route: awaiting QM-41 approval' : undefined}><Alert tone="info" title="Proposed page — requires QM-41 sitemap approval" class="ind-alert"><p>{ind.provenance.note}</p></Alert></div>
  )}

  {/* The challenge: sector-specific buyer problem (buyerChallenge), not shared boilerplate. */}
  <section class="section" aria-labelledby="challenge-title">
    <div class="container split ichal">
      <div data-reveal="up"><p class="eyebrow">The challenge</p><h2 id="challenge-title" class="display-sm">What makes {ind.name.toLowerCase()} different</h2></div>
      <div class="ichal__card" data-reveal="right"><span class="icon-badge icon-badge--slate" aria-hidden="true"><Icon name="alert" /></span><p class="lede">{ind.buyerChallenge}</p></div>
    </div>
  </section>

  {/* Considerations: only full records have them; ClaimRef annotations attach to specific cards (see Gotchas). */}
  {ind.considerations.length > 0 && (
    <section class="section surface-green" aria-labelledby="consider-title" data-note="green breaks up the teal/mint run (Janique, 26 Nov 2026)">
      <div class="container">
        <SectionHeading eyebrow="How we approach it" title={`Considerations for ${ind.name.toLowerCase()}`} id="consider-title" />
        <div class="grid grid--2 eq" data-reveal-stagger>
          {ind.considerations.map((c, n) => (
            <div class="consider" data-reveal="up"><span class:list={['icon-badge', ['', 'icon-badge--green', 'icon-badge--slate', 'icon-badge--mint'][n % 4]]} aria-hidden="true"><Icon name={['shield', 'check', 'gauge', 'team'][n % 4]} /></span><span class="consider__n mono" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span><h3>{c.title}</h3><p>{c.text}{ind.slug === 'healthcare' && c.title.startsWith('Compliance') && <ClaimRef id="C19" />}{ind.slug === 'public-sector' && c.title.startsWith('Procurement') && <ClaimRef id="C13" />}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Services that apply, plus related products when the record lists any. */}
  <section class="section" aria-labelledby="caps-title">
    <div class="container">
      <SectionHeading eyebrow="Relevant capabilities" title="Services that apply" id="caps-title" />
      <div class="grid grid--3 eq" data-reveal-stagger>{caps.map((s) => <div data-reveal="up"><ServiceCard service={s!} /></div>)}</div>
      {prods.length > 0 && <div class="prods"><h3>Related products</h3><div class="grid grid--3 eq">{prods.map((p) => <ProductCard p={p!} />)}</div></div>}
    </div>
  </section>

  {/* Evidence: published case studies for this sector (target of the hero's "See relevant results" link). */}
  <section class="section surface-teal" id="evidence" aria-labelledby="evidence-title">
    <div class="container">
      <SectionHeading eyebrow="Evidence" title="Published results" id="evidence-title" />
      {cases.length ? <div class="grid grid--3 eq" data-reveal-stagger>{cases.map((c) => <div data-reveal="up"><CaseStudyCard cs={c!} /></div>)}</div> : <p>No published case studies for this sector yet.</p>}
      {ind.evidenceNote && <p class="evidence-note" data-review-note={rn('Evidence note')}>{ind.evidenceNote}</p>}
    </div>
  </section>

  {/* Closing CTA: procurement wording for the public-sector page, sector wording for everything else. */}
  <CtaBand title={ind.status === 'proposed' && ind.slug === 'public-sector' ? 'Make a procurement or capability inquiry.' : `Talk to our ${ind.name.toLowerCase()} team.`} primary={ind.primaryCta} secondary={{ label: 'All industries', href: '/industries/' }} />
</BaseLayout>
<style>
  /* :global because the class is passed into the Alert component, outside this file's style scope. */
  :global(.ind-alert) { margin-top: var(--space-8); }
  /* Consideration cards: white card with a 3px teal top rule to mark them as approach notes. */
  /* Badge is a fixed square (it stretched to the card's height and pushed the text out of view; Janique 25 Nov). */
  .consider :global(.icon-badge) { flex: none; width: 52px; height: 52px; align-self: flex-start; }
  .consider { position: relative; height: 100%; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-8); background: #fff; border-radius: 24px; box-shadow: 0 24px 44px -34px rgba(34,43,55,.6); transition: transform .3s ease; }
  .consider:hover { transform: translateY(-4px); }
  .consider .icon-badge--mint { background: var(--qw-mint-50); }
  .consider__n { position: absolute; top: var(--space-8); right: var(--space-8); font-size: var(--fs-xs); opacity: .6; }
  /* Challenge: statement left, problem card right. */
  .ichal { align-items: center; }
  .ichal__card { display: grid; gap: var(--space-5); padding: var(--space-8); border-radius: 28px; background: var(--qw-mint-50); border-left: 8px solid var(--qw-green-500); }
  .ichal__card .lede { margin: 0; color: var(--qw-slate-900); }
  .eq { align-items: stretch; }
  /* Equal-height cards only: the card itself (or the card inside a reveal wrapper), never its contents. */
  .eq > :global(*), .eq > div:not(.consider) > :global(*) { height: 100%; }
  .evidence-note { color: var(--qw-slate-900) !important; }
  .consider h3 { font-size: var(--fs-md); }
  .consider p { margin: 0; color: var(--qw-slate-800); }
  /* Related products block and the small evidence footnote. */
  .prods { margin-top: var(--space-12); }
  .prods h3 { font-size: var(--fs-md); }
  .evidence-note { margin-top: var(--space-6); font-size: var(--fs-sm); color: var(--color-muted); }
</style>
