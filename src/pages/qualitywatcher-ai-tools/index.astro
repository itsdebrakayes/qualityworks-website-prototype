---
import { RELEASE, REVIEW, rn } from '../../lib/release';
/**
 * QUALITYWATCHER AI TOOLS (/qualitywatcher-ai-tools/ — legacy URL preserved).
 * Product-forward presentation inside the shared system (same header/footer/type/buttons).
 * Primary persona: QA Director (B). Secondary: Automation engineer / CTO.
 * Core question: "What does it automate, how do I access it, where do humans review?"
 * Conversion: open the tool on qualitywatcher.ai (external hand-off) or talk to an automation expert.
 *
 * Persona / CTA (docs/03-page-map-personas.md §2, "QualityWatcher AI" row): primary B (QA Director);
 *   secondary automation engineer, A. Proof required: C07–C09 and the WSSC case study. Primary CTA:
 *   "Open QualityWatcher AI" (external); secondary "Talk to an automation expert" (/contact-us/).
 *   Journey B in docs/03 §3 runs through this page.
 * What, top to bottom: bright teal hero (people photo + AI chips); "How it works" interactive demo
 *   (components/products/QwDemo.astro, auto-cycling tabs, carries the illustrative mock); the four
 *   tools with their observed link status; "AI drafts. People decide." human-review section (photo +
 *   review chips, components/products/ReviewPhoto.astro); results
 *   (StatBlock C07–C09 + WSSC case study card); access tiers with a discrepancy warning (P-03); FAQ;
 *   closing CtaBand.
 * Data: src/data/products.ts (`qwTools`: names, descriptions, CTA links and `observedStatus` from a
 *   17 Nov 2026 check), src/data/caseStudies.ts (WSSC case study), src/data/claims.ts via StatBlock.
 *   Hero copy, steps, review list, access tiers and FAQs are inline in this file.
 * SEO: inline title/description. JSON-LD: FAQPage built from `faqs` (faqLd), plus BreadcrumbList
 *   (Home > Products > QualityWatcher AI) from BaseLayout.
 * Review/release behaviour:
 *   - The demo window (QwDemo, formerly the hero mock) carries `data-release-blocker` in RELEASE builds (illustrative mock, needs approved
 *     product screenshots). The P-03 access Alert carries one too (access model unresolved). Both keep the
 *     release gate failing until resolved.
 *   - The "Proposed copy" note under the human-review list renders in REVIEW builds only.
 *   - StatBlock: in RELEASE it drops any stat whose claim has a `verification` value and hides the footnote
 *     (C07–C09 currently have none, so all three stay).
 * Gotchas:
 *   - The demo window is built for the prototype, NOT a product screenshot; its figcaption says so. Keep that
 *     caption until real screenshots replace it.
 *   - A tool whose observedStatus is 'not-found-404' shows a disabled-style message instead of a link
 *     (today: Schema to API Automation). Never link visitors to a known 404.
 *   - `qwExternal` is defined locally; it is not `ctas.qualityWatcherDemo` from site.ts (different label).
 *     Change both if the QualityWatcher hand-off wording changes.
 *   - Three of the four FAQs are proposed copy pending approval. They render on the page, but faqLd()
 *     emits only approved / published-live answers, so the FAQPage JSON-LD holds one question until
 *     the others are approved.
 *   - The access tiers repeat the live page; every tool link currently redirects to sign-in (P-03).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatBlock from '../../components/StatBlock.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import Alert from '../../components/Alert.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import QwDemo from '../../components/products/QwDemo.astro';
import QwShowcase from '../../components/QwShowcase.astro';
import ReviewPhoto from '../../components/products/ReviewPhoto.astro';
import { peopleImage } from '../../data/peopleImagery';
import { qwTools } from '../../data/products';
import { caseStudyBySlug } from '../../data/caseStudies';
import { faqLd } from '../../lib/schema';
import type { FaqItem } from '../../data/types';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Products', href: '/products/' }, { label: 'QualityWatcher AI' }];
// External hand-off CTA used in the hero and the closing band (Button adds the new-tab text and icon).
const qwExternal = { label: 'Open QualityWatcher AI', href: 'https://www.qualitywatcher.ai/', external: true, handoffNote: 'Opens qualitywatcher.ai, the separate QualityWatcher product site' };
// Badge label and colour for each observed tool status (QwTool['observedStatus'] in types.ts).
const statusMeta = {
  'requires-sign-in': { label: 'Requires sign-in', cls: 'badge--warning' },
  'not-found-404': { label: 'Unavailable (404)', cls: 'badge--danger' },
  available: { label: 'Available', cls: 'badge--success' },
  'not-verified': { label: 'Not verified', cls: 'badge--neutral' },
} as const;
// FAQ items with provenance; the notes reference audit discrepancies P-02 and P-03.
const faqs: FaqItem[] = [
  { q: 'What is QualityWatcher AI?', a: 'QualityWatcher AI is a set of AI tools from QualityWorks that generate test cases from requirements in any format, convert test cases into UI automation scripts, and answer test automation questions. The tools run on qualitywatcher.ai.', provenance: { source: 'live-site-copy', approval: 'published-live' } },
  { q: 'Do I need an account?', a: 'As of November 2026 the tool links lead to a sign-in page. The current corporate page describes free registered access and three uses without registration; the product owner must confirm which is correct before launch.', provenance: { source: 'proposed-copy', approval: 'pending-approval', note: 'Discrepancy P-03' } },
  { q: 'Does AI replace testers?', a: 'No. Generated test cases and scripts are drafts. QA engineers review titles, steps, data and expected results before they are used, and our consultants train teams to do that review well.', provenance: { source: 'proposed-copy', approval: 'pending-approval', note: 'Human-review wording to be confirmed by product owner.' } },
  { q: 'How is QualityWatcher AI different from QualityWatcher test management?', a: 'QualityWatcher test management (qualitywatcher.com) is a test case management platform. QualityWatcher AI (qualitywatcher.ai) is the AI tool suite. Generated test cases can be exported to QualityWatcher.', provenance: { source: 'proposed-copy', approval: 'pending-approval', note: 'Relationship P-02 to confirm.' } },
];
// WSSC AI test-case-generation pilot: the case study that backs this page. Rendered only if the slug exists.
const wssc = caseStudyBySlug('ai-powered-test-case-generation-wssc');
---
<BaseLayout seo={{ title: 'QualityWatcher AI: AI Test Case & Automation Generation | QualityWorks', description: 'Generate test cases from any requirement format, turn them into UI automation and get automation help with QualityWatcher AI tools from QualityWorks.' }} breadcrumbs={crumbs} jsonLd={[faqLd(faqs)].filter((x) => x !== null)}>
  {/* Bright teal hero with a people photo and floating AI-review chips (replaces the dark product-grid hero). */}
  <PageHero tone="teal" image={peopleImage('px-5668764')} ui="ai" eyebrow="QualityWatcher AI · Product" title="Simplify quality with AI-driven testing tools" lede="Generate real-world test cases from requirements in any format, convert them into automation scripts, and get expert automation help — with your QA team reviewing every output." breadcrumbs={crumbs} primary={qwExternal} secondary={{ label: 'Talk to an automation expert', href: '/contact-us/' }} />

  {/* THE PLATFORM TODAY (CEO review 24 Nov 2026: focus on current agentic AI capabilities, show the actual
      technology). QualityWatcher's four agents and recreated interface panels from qualitywatcher.ai, plus the
      Navy AIAT prize. The AI tools below remain as the free test-creation tools. */}
  <section class="section surface-dark qw-band" aria-labelledby="platform-title">
    <div class="container">
      <QwShowcase headingId="platform-title" eyebrow="The platform today: agentic AI test automation" primary={{ label: 'Visit qualitywatcher.ai', href: 'https://www.qualitywatcher.ai/', external: true }} photo={false} />
    </div>
  </section>

  {/* How it works: interactive, auto-cycling product demonstration (QwDemo). Carries the illustrative-mock
      caption and RELEASE blocker that the old hero mock had. */}
  <section class="section surface-mint how" aria-labelledby="how-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">How it works</p>
        <h2 id="how-title" class="display-sm">From any input to <span class="mark">reviewed</span> test assets</h2>
      </div>
      <QwDemo />
    </div>
  </section>

  {/* The tools: one card per QwTool with its observed status badge and CTA (or an unavailable notice). */}
  <section class="section surface-white" aria-labelledby="tools-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">The tools</p>
        <h2 id="tools-title">Four QualityWatcher AI tools</h2>
        <p class="lede">Status shown is what the prototype observed on 17 Nov 2026. The product owner must confirm availability before launch.</p>
      </div>
      <div class="tools" data-reveal-stagger>
        {qwTools.map((t, i) => {
          const st = statusMeta[t.observedStatus];
          const icon = ['doc', 'code', 'agent', 'api'][i] ?? 'spark';
          return (
            <div class="tool-wrap" data-reveal="up"><article class:list={['tool', `tool--${i % 4}`]} data-tilt="5">
              <div class="tool__top"><span class:list={['icon-badge', i === 1 && 'icon-badge--green', i === 2 && 'icon-badge--slate', i === 3 && 'icon-badge--mint']}><Icon name={icon} /></span><span class:list={['badge', st.cls]}>{st.label}</span></div>
              <h3>{t.name}</h3>
              <p>{t.description}</p>
              {t.observedStatus === 'not-found-404' ? (
                <p class="tool__unavailable"><Icon name="alert" />Link currently returns “not found”. CTA disabled until confirmed.</p>
              ) : (
                <Button cta={{ label: t.ctaLabel, href: t.ctaHref, external: true, kind: 'secondary', handoffNote: 'Opens qualitywatcher.ai; sign-in required' }} size="sm" />
              )}
            </article></div>
          );
        })}
      </div>
    </div>
  </section>

  {/* Human review: answers "where do humans review?" from the core question. People photo + review chips. */}
  <section class="section surface-mint" aria-labelledby="human-title">
    <div class="container human">
      <ReviewPhoto image={peopleImage('exec-meeting')} chips={[
        { title: 'AI draft created', sub: 'Human review required', icon: 'agent', tone: 'slate', x: '2%', y: '8%' },
        { title: 'Expired reset link', sub: 'Needs edit', icon: 'doc', x: '52%', y: '58%' },
        { title: 'Approved by reviewer', icon: 'check', tone: 'green', x: '8%', y: '78%' },
      ]} />
      <div>
        <p class="eyebrow" data-reveal>Human review</p>
        <h2 id="human-title" class="display-sm" data-reveal>AI drafts. <span class="mark">People decide.</span></h2>
        <p class="lede" data-reveal>The tools reduce repetitive work that invites human error. They don’t decide what “correct” means for your product.</p>
        <ul class="review-list" data-reveal-stagger>
          <li data-reveal><span class="icon-badge icon-badge--mint"><Icon name="automation" /></span><span><strong>Automated:</strong> drafting test case titles, steps, test data and expected results from your input; converting reviewed cases into UI automation scripts; suggesting fixes when automation fails.</span></li>
          <li data-reveal><span class="icon-badge icon-badge--green"><Icon name="team" /></span><span><strong>Human-validated:</strong> whether a test case reflects the real requirement, edge cases specific to your domain, data privacy of inputs, and whether a script is fit to run in your pipeline.</span></li>
          <li data-reveal><span class="icon-badge icon-badge--slate"><Icon name="learn" /></span><span><strong>Where QualityWorks helps:</strong> our consultants set up review workflows and train teams — see the WSSC pilot below.</span></li>
        </ul>
        {REVIEW && <p class="muted small-note" data-review-note={rn('Proposed copy — confirm with product owner')}>Proposed copy. The exact automated vs. human steps must be confirmed by the product owner.</p>}
      </div>
    </div>
  </section>

  {/* Results: stats must reference claims (StatBlock enforces this), plus the WSSC case study. */}
  <section class="section surface-white" aria-labelledby="results-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Results</p>
        <h2 id="results-title">Average results per client project</h2>
      </div>
      <StatBlock stats={[
        { value: '10×', label: 'Reduction in time to create test cases', claim: 'C07' },
        { value: '3×', label: 'Reduction in time to create an automated test', claim: 'C08' },
        { value: '80%', label: 'Accelerated automation debugging', claim: 'C09' },
      ]} footnote="These metrics represent QualityWorks’ average result per client project, as stated on the current page. Sample and method to be documented." />
      {wssc && <div class="grid grid--3 wssc"><CaseStudyCard cs={wssc} /></div>}
    </div>
  </section>

  {/* Access tiers from the live page, flagged as an unresolved discrepancy (P-03). */}
  <section class="section surface-mint" aria-labelledby="access-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Access</p>
        <h2 id="access-title">Registered and unregistered access</h2>
      </div>
      <Alert tone="warning" title="Discrepancy to resolve before launch (P-03)" data-release-blocker={RELEASE ? 'unresolved: QualityWatcher access model' : undefined}>
        <p>The live page lists the tiers below, but every tool link currently redirects to a sign-in page. Keep, change or remove this section once the product owner confirms the access model.</p>
      </Alert>
      <div class="tiers" data-reveal-stagger>
        <div class="tier tier--feature" data-reveal><span class="icon-badge"><Icon name="shield" /></span><h3>Registered user</h3><ul class="checklist"><li>Free access</li><li>Daily usage</li><li>Detailed filtering</li><li>Chat history</li><li>Export test cases to QualityWatcher</li><li>Export as CSV</li></ul></div>
        <div class="tier" data-reveal><span class="icon-badge icon-badge--mint"><Icon name="globe" /></span><h3>Unregistered user</h3><ul class="checklist"><li>Free access</li><li>Limited access: 3 uses</li><li>Export test cases to QualityWatcher</li></ul></div>
      </div>
    </div>
  </section>

  {/* FAQ: same `faqs` array as the FAQPage JSON-LD, so visible content and schema always match. */}
  <section class="section surface-white" aria-labelledby="faq-title">
    <div class="container container--narrow">
      <SectionHeading eyebrow="FAQ" title="QualityWatcher AI questions" id="faq-title" />
      <FaqAccordion items={faqs} />
    </div>
  </section>

  {/* Closing CTA: external tool hand-off, or talk to an automation expert. */}
  <CtaBand eyebrow="Get started" title="Try the tools, or let us set them up with your team." primary={qwExternal} secondary={{ label: 'Talk to an automation expert', href: '/contact-us/' }} />
</BaseLayout>
<style>
  .how { overflow: hidden; }
  /* Tool cards: equal heights (grid rows stretch; flex column pushes the CTA to the bottom). */
  .tools { display: grid; gap: var(--space-5); grid-template-columns: 1fr; align-items: stretch; }
  @media (min-width: 640px) { .tools { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1180px) { .tools { grid-template-columns: repeat(4, 1fr); } }
  .tool-wrap { height: 100%; }
  .tool { height: 100%; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); border-radius: 22px; background: var(--qw-white); border: 1px solid color-mix(in srgb, var(--qw-slate-900) 10%, transparent); box-shadow: 0 1px 2px rgba(34,43,55,.04); transition: box-shadow 300ms, border-color 300ms; }
  .tool:hover { box-shadow: 0 30px 50px -30px rgba(34,43,55,.45); border-color: var(--qw-teal-500); }
  .tool--0 { border-top: 6px solid var(--qw-teal-500); } .tool--1 { border-top: 6px solid var(--qw-green-500); } .tool--2 { border-top: 6px solid var(--qw-slate-900); } .tool--3 { border-top: 6px solid #289DAD; }
  .tool__top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-3); margin-bottom: var(--space-2); }
  .tool h3 { font-size: var(--fs-md); margin: 0; }
  .tool p { margin: 0; font-size: var(--fs-sm); }
  .tool :global(.btn) { margin-top: auto; align-self: flex-start; }
  .tool__unavailable { margin-top: auto !important; display: flex; gap: 0.5rem; color: var(--qw-slate-900); padding: var(--space-3); border-radius: 12px; background: color-mix(in srgb, var(--qw-caution) 18%, white); }
  .tool__unavailable :global(svg) { width: 18px; height: 18px; flex: none; }
  /* Human review: photo left, copy right. */
  .human { display: grid; gap: var(--space-12); align-items: center; }
  @media (min-width: 960px) { .human { grid-template-columns: 1fr 1fr; gap: var(--space-16); } }
  .human h2.display-sm { font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem); }
  .review-list { list-style: none; padding: 0; margin: var(--space-8) 0 0; display: grid; gap: var(--space-4); }
  .review-list li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: start; padding: var(--space-4); border-radius: 18px; background: var(--qw-white); }
  .review-list .icon-badge { width: 44px; height: 44px; border-radius: 13px; }
  .review-list .icon-badge :global(svg) { width: 22px; height: 22px; }
  .small-note { font-size: var(--fs-xs); margin-top: var(--space-4); }
  .wssc { margin-top: var(--space-10); }
  .tiers { margin-top: var(--space-6); display: grid; gap: var(--space-5); align-items: stretch; }
  @media (min-width: 768px) { .tiers { grid-template-columns: 1fr 1fr; } }
  .tier { height: 100%; padding: var(--space-8); border-radius: 22px; background: var(--qw-white); }
  .tier h3 { margin-top: var(--space-4); }
  .tier--feature { background: var(--qw-teal-500); color: var(--qw-slate-900); --color-heading: var(--qw-slate-900); --color-text: var(--qw-slate-900); }
  .tier--feature .icon-badge { background: var(--qw-slate-900); color: var(--qw-white); }
</style>
