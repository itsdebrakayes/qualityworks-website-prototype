---
import { RELEASE, REVIEW } from '../lib/release';
/**
 * HOMEPAGE — reference implementation of the design system.
 * Primary persona: Enterprise CTO/VP Eng (A) and SMB Founder/COO (D). Secondary: QA Director (B), Public sector (C).
 * Core question: "What does QualityWorks do, and which part is relevant to me?"
 * Conversion: Contact us / Talk to an expert (/contact-us/) from the hero, every service pillar, the portfolio,
 *   QualityWatcher, results and the closing band (Stacy Kirk: "I don't want anyone to be like, how do I reach them?").
 *
 * STRUCTURE — follows the CEO executive review of 24 Nov 2026 (docs/17-executive-review.md), top to bottom:
 *   1 HERO (kept: Samsung-style scroll intro, "Engineered for Excellence."; new: senior business-leader photo,
 *     AI-powered testing + custom software named first, three service cards rise in on scroll)
 *   2 STATS "Quality you can measure" (kept, Stacy liked it)
 *   3 WHY QUALITYWORKS (kept copy; one large portrait instead of the small collage)
 *   4 SERVICES: three adjacent photo pillars, testing and development emphasised (replaces the scroll story)
 *   4b FEATURED WORK: custom development portfolio preview (PortfolioGallery mode="preview") linking to the
 *     full portfolio on /services/custom-software-development/#portfolio
 *   5 PRODUCTS & INNOVATION: QualityWatcher showcase + Navy AIAT prize (QwShowcase); PRISM de-emphasised
 *   6 TESTIMONIALS: large portrait + frosted-glass quote carousel (TestimonialStage; placeholders) + awards strip
 *   8 EXPERIENCE ACROSS INDUSTRIES: client logo cluster (LogoCluster; replaces "Who we help")
 *   9 RESULTS: three recognisable US engagements (BB&T/SunTrust now Truist, WSSC, US telecom)
 *   12 closing CtaBand (kept)
 *   Removed by request: Where we work (LA/Kingston map), Insights (no AEO case for a homepage blog strip; the
 *   blog and resource hub stay in the navigation), Speaking & events.
 * Data: services.ts (`pathways`), caseStudies.ts, portfolio.ts, testimonialPlaceholders.ts, clients.ts,
 *   peopleImagery.ts, site.ts (`ctas`), claims.ts via StatBlock/ClaimRef.
 * SEO: inline title/description. JSON-LD: Organization. No breadcrumbs.
 * Requirements: AC-HOME-1 (h1, hero CTA and the three pathway links visible at 1440 x 900 after the intro),
 *   AC-HOME-2 (every statistic references a claim ID; enforced by StatBlock). AC-HOME-3 (events fallback) is
 *   retired with the events strip (CEO decision, docs/17).
 * Review/release behaviour: StatBlock drops unverified stats in RELEASE; ClaimRef badges render in REVIEW
 *   only; sample portfolio projects and placeholder testimonials carry release blockers.
 * Gotchas:
 *   - Featured case studies are chosen by hard-coded slugs below; a renamed slug silently drops a card.
 *   - The "beyond the code" phrase is styled with <strong class="beyond"> (never angle brackets).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import StatBlock from '../components/StatBlock.astro';
import ClaimRef from '../components/ClaimRef.astro';
import CtaBand from '../components/CtaBand.astro';
import PortfolioGallery from '../components/PortfolioGallery.astro';
import QwShowcase from '../components/QwShowcase.astro';
import TestimonialStage from '../components/TestimonialStage.astro';
import LogoCluster from '../components/LogoCluster.astro';
import { pathways } from '../data/services';
import { products } from '../data/products';
import { caseStudyBySlug } from '../data/caseStudies';
import { peopleImage, peopleSrc, peopleSrcset } from '../data/peopleImagery';
import { ctas } from '../data/site';
import { organizationLd } from '../lib/schema';

// Hero: an experienced business leader (Stacy: "the hero section is supposed to make them a hero").
const heroImage = peopleImage('exec-leader');
// Hero service tabs (AI-powered testing and custom development first, per the CEO review).
const heroTabs = [
  { label: 'AI-Powered Testing', text: 'Release with confidence. AI-augmented testing and quality engineering, with human expertise at every step.', href: '/services/test-automation/' },
  { label: 'Custom Development', text: 'Web and mobile products designed, built and tested by one team, from first idea to launch.', href: '/services/custom-software-development/' },
  { label: 'AI Agents', text: 'AI agents that take repeat work off your team\u2019s plate, with people approving every step.', href: '/products/agents-as-a-service/' },
];
// Why QualityWorks: one large portrait (Stacy: "I'd rather it just be someone's face here").
const whyImg = peopleImage('why-exec');
// Service pillars: photo, emphasis and a second "talk to us" action per pathway (ids from services.ts).
const pillarMeta: Record<string, { photo: string; core: boolean; contact: string }> = {
  quality: { photo: 'svc-testing', core: true, contact: 'Talk to a testing expert' },
  build: { photo: 'svc-build', core: true, contact: 'Start a project' },
  ai: { photo: 'svc-agents', core: false, contact: 'Talk about AI agents' },
};
// Results: the three most recognisable US engagements with published case studies (Stacy: "get the biggest
// names here"). BB&T and SunTrust merged to form Truist in 2019; naming needs client approval (docs/17).
const featuredCases = [
  // `short` / `outcome`: one-line versions of the published case study so every card's text block is the same
  // height (Janique, 26 Nov 2026). Outcomes restate published facts only (metrics need a claim; WSSC has none).
  { slug: 'mobile-game-development-creating-legacy', label: 'BB&T / SunTrust (now Truist)', kind: 'Custom development', short: 'Leadership mobile game, rebuilt', outcome: '3 months to redesign and redevelop' },
  { slug: 'ai-powered-test-case-generation-wssc', label: 'WSSC Water', kind: 'AI-powered testing', short: 'AI-powered test case generation', outcome: 'Piloted with the WSSC QA team' },
  { slug: 'telecom-automation', label: 'US telecom & media company', kind: 'Test automation', short: 'Automation across many projects', outcome: '~500 testing hours saved weekly' },
].map((f) => ({ ...f, cs: caseStudyBySlug(f.slug)! })).filter((f) => f.cs);
const agents = products.find((p) => p.slug === 'agents-as-a-service');
---
<BaseLayout
  seo={{ title: 'QualityWorks Consulting Group | Software Quality, Custom Software & AI', description: 'QualityWorks tests smarter, builds faster and deploys AI: AI-powered testing, custom web and mobile development, and agentic business solutions since 2010.' }}
  jsonLd={[organizationLd()]}
>
  {/* 1 HERO — kept from the approved direction: the Samsung-style scroll intro (full-screen teal + photo first;
      scrolling zooms out to a windowed panel, the header slides in and the three service cards rise up).
      New (CEO review): an experienced business-leader photograph and the two core capabilities named first.
      Desktop with motion only; phones, tablets and reduced motion get the static layout. */}
  <div class="intro" data-intro>
  <div class="intro__stage">
  {/* Hero layout per the project lead's reference (26 Nov 2026, Stacy prefers it): the photo is the full background,
      the copy sits over it, "Excellence." carries the brand gradient, and a glass card switches between the three
      services. The teal rises from the bottom only to just below the headline (not halfway across the photo) and
      fades out before it reaches the executive, so his face stays clear. --teal-top tunes how high it comes. */}
  <section class="hero surface-teal" aria-labelledby="hero-title">
    <p class="intro__hint" aria-hidden="true"><i></i>Scroll</p>
    <div class="hero__media">
      <img class="hero__photo" src={peopleSrc(heroImage)} srcset={peopleSrcset(heroImage)} sizes="100vw"
        alt={heroImage.alt} width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" style={`object-position: ${heroImage.focus}`} />
      <span class="hero__teal" aria-hidden="true"></span>
    </div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__brand" data-reveal="fade"><img src="/brand/qualityworks-wordmark-white.png" alt="" width="146" height="32" /></p>
        <p class="hero__eyebrow" data-reveal="fade">Human expertise · AI-powered possibilities</p>
        {/* Tagline per the brand guide: title case, always with the period. */}
        <h1 id="hero-title" class="display" data-words><span class="word" style="--w:0">Engineered</span><br /><span class="word" style="--w:1">for</span> <span class="word hero__excel" style="--w:2">Excellence.</span></h1>
        <p class="lede hero__lede" data-reveal style="--i:3">Your vision deserves exceptional software. We bring the people, precision and AI-powered expertise to make it happen.</p>
        <div class="hero__card" data-cycle="6000" data-reveal style="--i:4">
          <div class="hero__tabs" role="tablist" aria-label="What we do">
            {heroTabs.map((t, i) => (
              <button type="button" class="hero__tab" role="tab" id={`hero-tab-${i}`} aria-controls={`hero-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-cycle-tab={i}>{t.label}</button>
            ))}
          </div>
          {heroTabs.map((t, i) => (
            <div class="hero__panel" id={`hero-panel-${i}`} role="tabpanel" aria-labelledby={`hero-tab-${i}`} data-cycle-panel={i} data-cycle-hide hidden={i !== 0}>
              <p>{t.text}</p>
              <div class="hero__ctas">
                <a class="btn hero__explore" href={t.href}>Explore<Icon name="arrow" /></a>
                <a class="btn btn--secondary hero__contact" href="/contact-us/">Contact us</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <div class="container pathways-wrap">
    <ul class="pathways" aria-label="Three ways we help" data-reveal-stagger>
      {pathways.map((p, i) => (
        <li class:list={['pathway', `pathway--${['white', 'green', 'slate'][i]}`]} data-pathway={p.id} data-reveal="up" data-tilt="5">
          <span class="pathway__icon" aria-hidden="true"><Icon name={['shield', 'devices', 'agent'][i]} /></span>
          <p class="pathway__label">{p.label}</p>
          <h2 class="pathway__title"><a href={p.href}>{p.title}</a></h2>
          <p class="pathway__text">{p.text}</p>
          <span class="pathway__cta" aria-hidden="true">{p.cta}<Icon name="arrow" /></span>
        </li>
      ))}
    </ul>
  </div>
  </div>
  </div>

  {/* 2 STATS — kept (Stacy: "I like that section with the measures"). Count-up tiles tied to claim IDs. */}
  <section class="section stats-sec" aria-labelledby="impact-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Impact</p>
        <h2 id="impact-title" class="display-sm">Quality you can <span class="mark">measure</span>.</h2>
      </div>
      <StatBlock
        stats={[
          { value: '16+', label: 'Years of quality-driven development', claim: 'C01' },
          { value: '90%', label: 'Increase in quality releases (avg. per client)', claim: 'C02' },
          { value: '$30M', label: 'Cost savings through automation', claim: 'C03' },
          { value: '80%', label: 'Faster time to market (avg. per client)', claim: 'C04' },
        ]}
        footnote="Figures as currently published on qualityworkscg.com. Measurement context for the 90%, $30M and 80% figures requires verification before launch; they have not been independently verified."
      />
    </div>
  </section>

  {/* 3 WHY QUALITYWORKS — kept message; one large editorial portrait (CEO review) that unmasks on scroll. */}
  <section class="section why-sec scene scene--media-left" aria-labelledby="intro-title">
    <figure class="scene__media why-portrait" data-reveal="fade">
      <img src={peopleSrc(whyImg)} srcset={peopleSrcset(whyImg)} sizes="(min-width: 1024px) 50vw, 100vw" alt={whyImg.alt} width="1600" height="2400" loading="lazy" style={`object-position:${whyImg.focus}`} />
    </figure>
    <div class="container scene__grid">
      <div class="scene__copy intro__copy">
        <p class="eyebrow">Why QualityWorks</p>
        <h2 id="intro-title" class="why-title" data-reveal>We go <strong class="beyond">beyond the code</strong> to help clients reach their most extraordinary digital goals.</h2>
        <p class="lede" data-reveal>Founded in 2010, QualityWorks is a Black-owned, woman-led software solutions firm<ClaimRef id="C14" /> helping companies build higher-quality software, create future-ready teams and accelerate delivery.</p>
        <ol class="why" data-reveal-stagger>
          <li class="why__item" data-reveal="left"><h3>Faster teams, not bigger ones</h3><p>Regression cycles from 4 days to 45 minutes<ClaimRef id="C05" />, and nearly 500 testing hours saved weekly for one client<ClaimRef id="C06" />.</p></li>
          <li class="why__item" data-reveal="left"><h3>AI baked in, not bolted on</h3><p>Our own AI tools help create test cases and automation faster<ClaimRef id="C07" />, always with people reviewing the results.</p></li>
          <li class="why__item" data-reveal="left"><h3>Your team, better than we found it</h3><p>We train your QA and development teams alongside every engagement.</p></li>
        </ol>
        <div class="btn-row">
          <Button href="/about-us/" label="About QualityWorks" variant="secondary" />
          <Button href="/contact-us/" label="Contact us" />
        </div>
      </div>
    </div>
  </section>

  {/* 4 SERVICES — three adjacent photo pillars, all visible at once (CEO review: "all visual at the same time",
      "not as wordy", "and or people"). Testing and development carry a "Core service" badge and lead into the
      deeper showcases below (portfolio, QualityWatcher). id="services"/"solutions" anchors. */}
  <section class="section surface-mint pillars-sec" id="services" aria-labelledby="ways-title">
    <span id="solutions" aria-hidden="true"></span>
    <div class="container">
      <div class="section-intro section-intro--center" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2 id="ways-title" class="display-sm">Three ways we move your business forward</h2>
      </div>
      <ul class="pillars" data-reveal-stagger>
        {pathways.map((p) => {
          const m = pillarMeta[p.id]; const img = peopleImage(m.photo);
          return (
            <li class:list={['pillar', `pillar--${p.id}`, { 'pillar--core': m.core }]} data-reveal="up">
              <div class="pillar__media">
                <img src={peopleSrc(img)} srcset={peopleSrcset(img)} sizes="(min-width: 960px) 33vw, 100vw" alt={img.alt} width="1600" height="1067" loading="lazy" style={`object-position:${img.focus}`} />
                {m.core && <span class="pillar__badge">Core service</span>}
              </div>
              <div class="pillar__body">
                <span class="pillar__accent" aria-hidden="true"></span>
                <p class="pillar__label">{p.label}</p>
                <h3 class="pillar__title">{p.title}</h3>
                <p class="pillar__text">{p.text}</p>
                <div class="pillar__ctas">
                  <a class="btn btn--sm" href={p.href}>Learn more<Icon name="arrow" /></a>
                  <a class="pillar__contact" href="/contact-us/">{m.contact}<Icon name="arrow" /></a>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {/* 4b FEATURED WORK — custom development portfolio preview (CEO review: "a click through to get them on the
      custom development page"). Sample projects, clearly labelled. */}
  <section class="section work-sec" aria-labelledby="work-title">
    <div class="container">
      <div class="section-row">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">Custom development · Featured work</p>
          <h2 id="work-title" class="display-sm">Software we design, build and stand behind</h2>
          <p class="lede">Web and mobile products for banks, clinics, carriers and cities. Browse the work, then tell us what you want to build.</p>
        </div>
        <div class="btn-row">
          <Button href="/services/custom-software-development/#portfolio" label="Explore our work" variant="secondary" />
          <Button href="/contact-us/" label="Start a project" />
        </div>
      </div>
      <PortfolioGallery mode="preview" id="featured-work" />
    </div>
  </section>

  {/* 5 PRODUCTS & INNOVATION — QualityWatcher first, with the Navy AIAT prize (CEO review). Dark band. */}
  <section class="section surface-dark qw-sec" aria-labelledby="products-title">
    <div class="container">
      <QwShowcase />
      <ul class="products__more">
        {agents && <li><a href={agents.path}><strong>Agents as a Service</strong> — named AI agents for business teams, with people approving the work<Icon name="arrow" /></a></li>}
        <li><a href="/products/prism/"><strong>PRISM™</strong> — AI output quality scoring · coming soon<Icon name="arrow" /></a></li>
        <li><a href="/products/"><strong>All products</strong> — compare what each one does<Icon name="arrow" /></a></li>
      </ul>
    </div>
  </section>

  {/* 6 TESTIMONIALS — large portraits with a frosted-glass quote panel (CEO review; placeholders until clients
      approve their quote and photo), then the recognition strip. */}
  <section class="section testi-sec" aria-labelledby="proof-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Testimonials</p>
        <h2 id="proof-title" class="display-sm">What our clients say</h2>
      </div>
      <TestimonialStage />
      <ul class="awards" aria-label="Awards and recognition">
        <li><img src="/brand/Clutch_TopAutomationTesting-500x540.png" alt="Clutch: Top Automation Testing Company" width="72" height="78" loading="lazy" /></li>
        <li><img src="/brand/Clutch_TopComplianceTesting-500x540.png" alt="Clutch: Top Compliance Testing Company" width="72" height="78" loading="lazy" /></li>
        <li><img src="/brand/Clutch_TopRecoveryTesting-1-500x540.png" alt="Clutch: Top Global Recovery Testing Company" width="72" height="78" loading="lazy" /><ClaimRef id="C12" /></li>
        <li class="award-txt"><a href="/qualityworks-wins-inc-best-in-business-2025-award/"><span class="award__brand">Inc.</span> Best in Business 2025</a><ClaimRef id="C11" /></li>
        <li class="award-txt"><a href="/qualityworks-wins-us-navy-ai-testing-challenge/">First Prize · U.S. Navy AIAT Challenge</a><ClaimRef id="C10" /></li>
      </ul>
    </div>
  </section>

  {/* 8 EXPERIENCE ACROSS INDUSTRIES — logo cluster (replaces the wordy "Who we help"; CEO review). */}
  <section class="section surface-mint clients-sec" aria-labelledby="clients-title">
    <div class="container">
      <div class="section-intro section-intro--center" data-reveal>
        <p class="eyebrow">Who we help</p>
        <h2 id="clients-title" class="display-sm">Experience across industries</h2>
        <p class="lede">Hover or tap a logo to see the industry.</p>
      </div>
      <LogoCluster />
      <p class="clients-more"><a class="link-arrow" href="/industries/">Browse industries<Icon name="arrow" /></a></p>
    </div>
  </section>

  {/* 9 RESULTS — kept; three recognisable US engagements as large photo cards (CEO review). */}
  <section class="section results-sec" aria-labelledby="results-title">
    <div class="container">
      <div class="section-row">
        <div class="section-intro" data-reveal><p class="eyebrow">Results</p><h2 id="results-title" class="display-sm">Outcomes from recent engagements</h2></div>
        <Button href="/case-studies/" label="All case studies" variant="secondary" size="sm" />
      </div>
      <ul class="results" data-reveal-stagger>
        {featuredCases.map(({ cs, label, kind, short, outcome }) => (
          <li class="result" data-reveal="up">
            {cs.image && <img src={cs.image} alt={cs.altText} loading="lazy" width="800" height="1000" />}
            <div class="result__glass">
              <p class="result__meta"><span>{kind}</span></p>
              <p class="result__client">{label}</p>
              <h3 class="result__title"><a href={`/case-studies/${cs.slug}/`}>{short}</a></h3>
              <p class="result__metric">{outcome}</p>
              <span class="result__more" aria-hidden="true">Read the case study<Icon name="arrow" /></span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 12 Closing CTA — kept (Stacy: "Yeah, that's fine"). */}
  <CtaBand title="Tell us what you’re trying to launch." text="Testing, a new product or an AI initiative — one conversation is enough to find out whether we can help." primary={{ label: 'Contact us', href: '/contact-us/', kind: 'primary' }} secondary={ctas.caseStudies} eyebrow="Let’s talk" />
  {/* Scroll intro driver: sets --p on the intro and --ip on <html> (header reveal). Desktop + motion only. */}
  <script is:inline>
    (function () {
      var intro = document.querySelector('[data-intro]'); if (!intro) return;
      var mq = matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');
      var html = document.documentElement, raf = 0;
      var update = function () {
        raf = 0;
        var on = mq.matches; html.classList.toggle('intro-mode', on);
        if (!on) { html.style.removeProperty('--ip'); return; }
        var p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.9)));
        intro.style.setProperty('--p', p.toFixed(4));
        html.style.setProperty('--ip', Math.min(1, Math.max(0, (p - 0.55) / 0.4)).toFixed(4));
      };
      var queue = function () { if (!raf) raf = requestAnimationFrame(update); };
      addEventListener('scroll', queue, { passive: true }); addEventListener('resize', queue); mq.addEventListener('change', queue);
      update();
    })();
  </script>
</BaseLayout>

<style>
  /* ---------- HERO: bright teal block ---------- */
  .hero { position: relative; overflow: hidden; padding: 0 0 clamp(7rem, 5rem + 6vw, 10rem); }
  .hero__media { position: relative; overflow: hidden; }
  .hero__photo { display: block; width: 100%; aspect-ratio: 16 / 10; height: auto; object-fit: cover; }
  .hero__grid { position: relative; z-index: 2; padding-top: var(--space-8); }
  .hero__copy h1 { margin-bottom: var(--space-6); max-width: 10ch; font-size: clamp(2.75rem, 1.6rem + 3.6vw, 4.75rem); }
  .hero__lede { max-width: 31rem; font-size: var(--fs-md); }
  .hero__ctas { margin-top: var(--space-6); }
  .hero__brand { display: flex; align-items: center; gap: 10px; margin: 0 0 var(--space-5); font: 700 var(--fs-sm)/1 var(--font-display); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-slate-900); }
  .hero__brand img { height: 38px; width: auto; filter: brightness(0) saturate(100%) invert(14%) sepia(12%) saturate(1100%) hue-rotate(176deg); }
  .hero__eyebrow { margin: 0 0 var(--space-4); font: 800 var(--fs-xs)/1.3 var(--font-display); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-teal-800); }
  .hero__copy h1 { max-width: none; }
  /* "Excellence." in the brand gradient (reference design). Dark enough to keep 3:1 on the bright photo. */
  .hero__excel { background: linear-gradient(95deg, var(--qw-slate-900) 0%, #18625C 30%, #1D8C7F 60%, #1E9A6E 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero__lede { color: var(--qw-slate-900); }
  .hero__card { margin-top: var(--space-6); max-width: 40rem; padding: var(--space-4) var(--space-5) var(--space-5); border-radius: 22px;
    background: linear-gradient(160deg, rgba(255,255,255,.62), rgba(255,255,255,.42)); -webkit-backdrop-filter: blur(18px) saturate(160%); backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255,255,255,.75); box-shadow: 0 24px 50px -24px rgba(17,74,69,.5), inset 0 1px 0 rgba(255,255,255,.9); }
  .hero__tabs { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 999px; background: rgba(34,43,55,.1); margin-bottom: var(--space-4); }
  .hero__tab { border: 0; cursor: pointer; padding: .5em 1em; border-radius: 999px; background: transparent; color: var(--qw-slate-900); font: 700 var(--fs-sm)/1.2 var(--font-display); transition: background 250ms, color 250ms; }
  .hero__tab:hover { background: rgba(255,255,255,.6); }
  .hero__tab[aria-selected="true"] { background: var(--qw-slate-900); color: #fff; }
  .hero__panel { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .hero__panel[hidden] { display: none; }
  .hero__panel p { margin: 0; flex: 1 1 16rem; font-size: var(--fs-base); line-height: 1.55; color: var(--qw-slate-900); }
  .hero__ctas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .hero__ctas .btn { justify-content: center; white-space: nowrap; }
  .hero__ctas :global(svg) { width: 1em; height: 1em; }
  .hero__teal { display: none; }
  @media (max-width: 1023px) {
    /* On the solid teal block the light end of the gradient disappears: keep it dark. */
