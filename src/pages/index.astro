---
import { RELEASE, REVIEW } from '../lib/release';
/**
 * HOMEPAGE — reference implementation of the design system.
 * Primary persona: Enterprise CTO/VP Eng (A) and SMB Founder/COO (D). Secondary: QA Director (B), Public sector (C).
 * Core question: "What does QualityWorks do, and which part is relevant to me?"
 * Conversion: Talk to an expert (/contact-us/) or self-select a pathway.
 *
 * URL: / (the site root).
 * Persona / CTA (docs/03-page-map-personas.md §2, "Home" row): primary A Enterprise CTO; D SMB Founder.
 *   Secondary B QA Director; C Public sector. Proof required: approved stats (C01–C04), awards (C10–C12),
 *   3 case studies. Primary CTA: "Talk to an expert" to /contact-us/; secondary "Explore solutions".
 *   Journeys A and D in docs/03 §3 start here.
 * What, top to bottom (each block is marked with a {comment} in the markup): HERO with company facts and
 *   the three pathways; STATS; INTRO ("Why QualityWorks"); THREE WAYS (pathway detail cards); PRODUCTS
 *   (with a review-only PRISM sample); PROOF (awards + testimonials); WHO WE HELP; RESULTS (3 case
 *   studies); INSIGHTS + EVENTS; closing CtaBand.
 * Data: src/data/services.ts (`pathways`, `servicesByPathway`), src/data/products.ts, src/data/caseStudies.ts,
 *   src/data/articles.ts (`blogPosts`), src/data/events.ts, src/data/industries.ts, src/data/site.ts (`ctas`,
 *   `site.externalPlatforms.clutch`), src/data/claims.ts via StatBlock/ClaimRef, testimonials via ProofBlock.
 *   The pathway bullet lists and some section copy are inline.
 * SEO: inline title/description. JSON-LD: Organization (organizationLd from src/lib/schema.ts). No
 *   breadcrumbs, so no BreadcrumbList.
 * Requirements: docs/10-acceptance-criteria.md AC-HOME-1 (h1, both hero CTAs and all three pathway links
 *   visible without scrolling at 1440 x 900; QA-16), AC-HOME-2 (every statistic references a claim ID;
 *   enforced by StatBlock) and AC-HOME-3 (events fallback message when nothing is upcoming).
 * Review/release behaviour:
 *   - StatBlock: in RELEASE it drops stats whose claim has a `verification` value (today C02, C03, C04),
 *     leaving only C01, and hides the footnote.
 *   - ClaimRef badges (C05–C07, C10–C12, C14, C15) render in REVIEW only.
 *   - The PRISM sample score card renders in REVIEW only (`{REVIEW && ...}`).
 *   - Events: fixtures are excluded here in every build; RELEASE also drops unverified/undated events
 *     inside events.ts.
 * Gotchas:
 *   - Keep the hero short: AC-HOME-1 needs the pathways above the fold at 1440 x 900.
 *   - Featured case studies and products are chosen by hard-coded slugs below; a renamed slug silently
 *     drops a card (case studies) or moves it to the "more" list (products).
 *   - `pathwayBullets` keys must match the pathway ids in services.ts (quality, build, ai).
 *   - The "beyond the code" phrase must not be wrapped in angle brackets (content-check flags the bracketed
 *     form); it is styled with <em class="beyond"> instead.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatBlock from '../components/StatBlock.astro';
import ClaimRef from '../components/ClaimRef.astro';
import ProductCard from '../components/ProductCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EventCard from '../components/EventCard.astro';
import ProofBlock from '../components/ProofBlock.astro';
import CtaBand from '../components/CtaBand.astro';
import EmptyState from '../components/EmptyState.astro';
import WorldDots from '../components/WorldDots.astro';
import { pathways, servicesByPathway } from '../data/services';
import { products } from '../data/products';
import { caseStudyBySlug } from '../data/caseStudies';
import { blogPosts } from '../data/articles';
import { events, eventPhase } from '../data/events';
import { industries } from '../data/industries';
import { peopleImage, peopleSrc, peopleSrcset } from '../data/peopleImagery';
import { ctas, site } from '../data/site';
import { organizationLd } from '../lib/schema';

// Homepage hero photograph (visual revision, docs/15): people working through a technical problem together.
const heroImage = peopleImage('home-mentoring');
// People collage in WHY QUALITYWORKS (Janique: add people here).
const teamImg = peopleImage('about-team');
const pairImg = peopleImage('careers-colleagues');
// Bullet lists for the THREE WAYS cards, keyed by pathway id. Homepage-only copy.
const pathwayBullets = {
  quality: ['AI-generated test cases & automation scripts', 'AI-assisted regression testing', 'Web, mobile, API & USSD coverage', 'Full-stack QA managed service', 'Test maturity assessments & roadmaps'],
  build: ['Custom web & mobile applications', 'AI-accelerated development cycles', 'Rapid prototyping & MVP delivery', 'UX/UI design & product strategy', 'Nearshore delivery at competitive rates'],
  ai: ['Custom AI agent design & deployment', 'Generative AI integration & strategy', 'Data quality and governance', 'Technology advisory (CTO-as-a-service)'],
};
// Three featured case studies (WSSC, fintech modernization, JMMB); missing slugs are dropped.
const featuredCases = ['ai-powered-test-case-generation-wssc', 'fintech-legacy-platform-modernization', 'jmmb-group-leverages-automation-best-practices'].map(caseStudyBySlug).filter(Boolean);
// Latest three migrated posts (articles.ts sorts newest first); fixtures are not in blogPosts.
const latest = blogPosts.slice(0, 3);
// Events band (AC-HOME-3): never show fixtures on the homepage. Prefer up to two upcoming events; if there are
// none, fall back to the first two remaining events (past or date-TBC) and show the fallback message.
const homeEvents = events.filter((e) => e.provenance.approval !== 'fixture');
const upcoming = homeEvents.filter((e) => eventPhase(e) === 'upcoming');
const eventsToShow = upcoming.length ? upcoming.slice(0, 2) : homeEvents.slice(0, 2);
// Three products get full cards; the rest (external platforms today) are listed as compact external links.
const featuredProducts = products.filter((p) => ['qualitywatcher-ai-tools', 'agents-as-a-service', 'prism'].includes(p.slug));
const otherProducts = products.filter((p) => !featuredProducts.includes(p));
// Live industry pages only; the two proposed audience pages get their own cards in WHO WE HELP.
const industryList = industries.filter((i) => i.status === 'live');
---
<BaseLayout
  seo={{ title: 'QualityWorks Consulting Group | Software Quality, Custom Software & AI', description: 'QualityWorks tests smarter, builds faster and deploys AI: AI-powered testing, custom web and mobile development, and agentic business solutions since 2010.' }}
  jsonLd={[organizationLd()]}
>
  {/* HERO (redesign, docs/16): bright brand-Teal block (Janique/Sabrina: navy heroes are dull). Left: tagline
      (words rise in), lede, equal-width CTAs, company facts. Right: a photograph of people working through a
      problem, blended into the teal (floating chips removed at the user's request). Text never sits on the photo. Pathway cards overlap the bottom edge so all three
      pathways stay above the fold at 1440 x 900 (AC-HOME-1). */}
  {/* INTRO (scroll-driven, Samsung-style): the hero first fills the whole screen with no header and no cards.
      Scrolling the first ~90% of a viewport "zooms out": the hero shrinks into a rounded panel, the site header
      slides down and the three pathway cards rise in. The stage is sticky, then the page scrolls on normally.
      Desktop with motion only; phones, tablets and reduced motion get the static layout. */}
  <div class="intro" data-intro>
  <div class="intro__stage">
  <section class="hero surface-teal" aria-labelledby="hero-title" data-pointer-scene>
    <p class="intro__hint" aria-hidden="true"><i></i>Scroll</p>
    <div class="hero__media" aria-hidden="false">
      <img class="hero__photo" src={peopleSrc(heroImage)} srcset={peopleSrcset(heroImage)} sizes="(min-width: 1024px) 62vw, 100vw"
        alt={heroImage.alt} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" style={`object-position: ${heroImage.focus}`} />
    </div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal="fade">QualityWorks Consulting Group</p>
        {/* Tagline per the brand guide: title case, always with the period. */}
        <h1 id="hero-title" class="display" data-words><span class="word" style="--w:0">Engineered</span> <span class="word" style="--w:1">for</span> <span class="word" style="--w:2">Excellence.</span></h1>
        <p class="lede hero__lede" data-reveal style="--i:3">We test smarter, build faster, and deploy AI to transform how businesses operate — from AI-powered testing to custom apps to AI agents that take work off your team’s plate.</p>
        <div class="btn-row btn-row--equal hero__ctas" data-reveal style="--i:4">
          <Button cta={ctas.contact} />
          <Button cta={ctas.exploreSolutions} />
        </div>
        <ul class="hero__facts" aria-label="Company facts" data-reveal style="--i:5">
          <li>Founded 2010<ClaimRef id="C14" /></li>
          <li>Los Angeles · Kingston</li>
          <li>US, UK, Latin America & Caribbean<ClaimRef id="C15" /></li>
        </ul>
      </div>
    </div>
  </section>
  <div class="container pathways-wrap">
    <ul class="pathways" aria-label="Three ways we help" data-reveal-stagger>
      {pathways.map((p, i) => (
        <li class:list={['pathway', `pathway--${['white', 'green', 'slate'][i]}`]} data-pathway={p.id} data-reveal="up" data-tilt="5">
          <span class="pathway__icon" aria-hidden="true"><Icon name={['shield', 'devices', 'agent'][i]} /></span>
          <p class="pathway__label">{p.label}</p>
          <h2 class="pathway__title"><a href={p.href}>{p.title}</a></h2>
          <p class="pathway__text">{p.text}</p>
          <span class="pathway__cta" aria-hidden="true">{p.cta}<Icon name="arrow" /></span>
        </li>
      ))}
    </ul>
  </div>
  </div>
  </div>

  {/* STATS: colourful count-up tiles (StatBlock), each tied to a claim ID (AC-HOME-2). */}
  <section class="section stats-sec" aria-labelledby="impact-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Impact</p>
        <h2 id="impact-title" class="display-sm">Quality you can <span class="mark">measure</span>.</h2>
      </div>
      <StatBlock
        stats={[
          { value: '16+', label: 'Years of quality-driven development', claim: 'C01' },
          { value: '90%', label: 'Increase in quality releases (avg. per client)', claim: 'C02' },
          { value: '$30M', label: 'Cost savings through automation', claim: 'C03' },
          { value: '80%', label: 'Faster time to market (avg. per client)', claim: 'C04' },
        ]}
        footnote="Figures as currently published on qualityworkscg.com. Measurement context for the 90%, $30M and 80% figures requires verification before launch; they have not been independently verified."
      />
    </div>
  </section>

  {/* WHY QUALITYWORKS: people collage (layered photos with parallax and a floating chip) beside the bold
      "beyond the code" statement (Janique: "We could bold this too"; "We could also add some people here too"). */}
  <section class="section surface-mint why-sec" aria-labelledby="intro-title">
    <div class="container why-grid">
      <div class="collage" data-pointer-scene>
        <img class="collage__a" data-parallax="0.06" src={peopleSrc(teamImg)} srcset={peopleSrcset(teamImg)} sizes="(min-width: 960px) 30vw, 70vw" alt={teamImg.alt} width="1600" height="875" loading="lazy" style={`object-position:${teamImg.focus}`} />
        <img class="collage__b" data-parallax="0.14" src={peopleSrc(pairImg)} srcset={peopleSrcset(pairImg)} sizes="(min-width: 960px) 22vw, 50vw" alt={pairImg.alt} width="1600" height="1067" loading="lazy" style={`object-position:${pairImg.focus}`} />
        <span class="collage__block" aria-hidden="true" data-parallax="0.2"></span>
      </div>
      <div class="intro__copy">
        <p class="eyebrow">Why QualityWorks</p>
        <h2 id="intro-title" class="display-sm" data-reveal>We go <strong class="beyond">beyond the code</strong> to help clients reach their most extraordinary digital goals.</h2>
        <p class="lede" data-reveal>Founded in 2010, QualityWorks is a Black-owned, woman-led software solutions firm<ClaimRef id="C14" /> focused on helping companies build higher-quality software, create future-ready teams and accelerate delivery.</p>
        <ol class="why" data-reveal-stagger>
          <li class="why__item" data-reveal="left">
            <h3>We make your team faster without making it bigger</h3>
            <p>AI-powered automation and process improvements have taken regression cycles from 4 days to 45 minutes<ClaimRef id="C05" /> and saved nearly 500 testing hours weekly for a single client<ClaimRef id="C06" />.</p>
          </li>
          <li class="why__item" data-reveal="left">
            <h3>AI is baked in, not bolted on</h3>
            <p>Our own AI tools help create test cases and automation faster<ClaimRef id="C07" />, and PRISM™ evaluates the quality of AI-generated outputs themselves.</p>
          </li>
          <li class="why__item" data-reveal="left">
            <h3>We leave your team better than we found it</h3>
            <p>We train your QA and development teams alongside every engagement. At JMMB, manual testers learned to write and run automated tests.</p>
          </li>
        </ol>
        <a class="link-arrow" href="/about-us/">About QualityWorks<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  {/* THREE WAYS: a scroll-driven story. A sticky visual on the left transforms between three states (testing
      dashboard → product build → agent network) as each pathway's text scrolls past on the right. Without JS
      or with reduced motion every state is visible beside its own text (stacked). id="solutions" anchor. */}
  <section class="section story-sec" id="solutions" aria-labelledby="ways-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Our services</p>
        <h2 id="ways-title" class="display-sm">Three ways we drive your business forward</h2>
        <p class="lede">From bulletproof testing to full-scale digital products to AI-powered operations — we handle the hard parts so you can move faster.</p>
      </div>
      <div class="story" data-story data-active="0">
        <div class="story__visual" aria-hidden="true">
          <div class="story__screen">
            <div class="sv sv--0">
              <div class="mon">
                <div class="mon__screen">
                  <div class="mon__bar"><i></i><i></i><i></i><span>Regression suite: running</span></div>
                  {['Unit tests', 'API checks', 'UI regression', 'Accessibility', 'Performance', 'Security scan'].map((t, k) => (
                    <div class="tr" style={`--k:${k}`}><span class="tr__state"><span class="tr__spin"></span><Icon name="check" /></span><span class="tr__name">{t}</span><span class="tr__bar"><i></i></span></div>
                  ))}
                  <div class="mon__foot"><span class="mon__pill">All checks passing</span><span class="mon__ship">Ready to release <Icon name="arrow" /></span></div>
                </div>
                <div class="mon__neck"></div><div class="mon__base"></div>
              </div>
            </div>
            <div class="sv sv--1">
              <div class="devs">
                <div class="lap">
                  <div class="lap__screen">
                    <div class="lap__code">{[70, 45, 85, 55, 30, 75, 50, 65, 40].map((w, k) => <i style={`--w:${w}%;--k:${k};--x:${[0,8,8,16,16,8,0,8,16][k]}%`}></i>)}</div>
                    <div class="lap__preview"><b class="pv pv--hero"></b><b class="pv pv--a"></b><b class="pv pv--b"></b><b class="pv pv--c"></b></div>
                  </div>
                  <div class="lap__base"></div>
                </div>
                <div class="ph">
                  <div class="ph__notch"></div>
                  <b class="pv pv--hero"></b><b class="pv pv--row"></b><b class="pv pv--row"></b><b class="pv pv--btn"></b>
                </div>
                <span class="build-chip"><Icon name="check" /> Build deployed: web, iOS, Android</span>
              </div>
            </div>
            <div class="sv sv--2">
              <div class="net">
                <svg class="net__svg" viewBox="0 0 400 300" preserveAspectRatio="none">
                  {[[200,150,70,60],[200,150,330,60],[200,150,70,240],[200,150,330,240]].map(([x1,y1,x2,y2], k) => (
                    <g><path d={`M${x1} ${y1} L${x2} ${y2}`} /><circle r="5" class="net__pkt"><animateMotion dur={`${2.2 + k * 0.3}s`} repeatCount="indefinite" path={`M${x1} ${y1} L${x2} ${y2}`} /></circle></g>
                  ))}
                </svg>
                <span class="net__hub"><Icon name="agent" /><b>AI agents</b></span>
                {[['Support', 'mail', 17.5, 20], ['Sales', 'gauge', 82.5, 20], ['Knowledge', 'learn', 17.5, 80], ['Follow-up', 'calendar', 82.5, 80]].map(([l, ic, x, y]) => (
                  <span class="net__node" style={`left:${x}%;top:${y}%`}><Icon name={ic as string} />{l}</span>
                ))}
                <span class="net__human"><Icon name="team" /> Human approval at every step</span>
              </div>
            </div>
          </div>
        </div>
        <div class="story__steps">
          {pathways.map((p, i) => (
            <article class="story__step" data-step data-pathway={p.id}>
              <p class="way__index">{p.index} / {p.label}</p>
              <h3 class="way__title">{p.title}</h3>
              <p class="way__text">{p.text}</p>
              <ul class="checklist way__list">{pathwayBullets[p.id].map((b) => <li>{b}</li>)}</ul>
              <div class="way__links">
                <p class="way__links-title">Related services</p>
                <ul>{servicesByPathway(p.id).filter((s) => s.contentDepth === 'full').slice(0, 4).map((s) => <li><a href={s.path}>{s.name}</a></li>)}</ul>
              </div>
              <Button href={p.href} label={p.cta} variant="secondary" size="sm" />
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* PRODUCTS: equal-height product cards on a bright Green block; external products as equal-height tiles. */}
  <section class="section surface-green products" aria-labelledby="products-title">
    <div class="container">
      <div class="products__head">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">Products & innovations</p>
          <h2 id="products-title" class="display-sm">Software we build for quality and AI</h2>
          <p class="lede">Our products are separate from our consulting services. Some live on their own platforms — we’ll always tell you when a link takes you there.</p>
        </div>
        {/* Review-only: reproduces the sample score from the live homepage; removed from release builds. */}
        {REVIEW && <div class="prism-sample" data-review-note="Sample score reproduced from the live homepage" data-tilt="6">
          <p class="prism-sample__label">PRISM™ sample score</p>
          <p class="prism-sample__grade">C+</p>
          <p class="prism-sample__desc">Fair — correct in parts</p>
          <div class="prism-sample__bar" role="img" aria-label="Sample score 78 percent"><span style="width:78%"></span></div>
          <p class="prism-sample__note">Illustrative sample, as shown on the current homepage.</p>
        </div>}
      </div>
      <div class="grid grid--3 products__cards" data-reveal-stagger>
        {featuredProducts.map((p) => <div class="products__card" data-reveal="up"><ProductCard p={p} /></div>)}
      </div>
      <ul class="products__more">
        {otherProducts.map((p) => (
          <li><a href={p.path} target="_blank" rel="noopener"><strong>{p.name}</strong> — {p.tagline}<Icon name="external" /><span class="visually-hidden"> (external site, opens in a new tab)</span></a></li>
        ))}
        <li><a href="/products/"><strong>All products</strong> — compare what each one does<Icon name="arrow" /></a></li>
      </ul>
    </div>
  </section>

  {/* PROOF: recognition tiles and the interactive testimonial stage (ProofBlock). The official Inc. Best in
      Business badge was not found (docs/16 §6), so the award is a typographic tile linking to the news post. */}
  <section class="section" aria-labelledby="proof-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Recognition</p>
        <h2 id="proof-title" class="display-sm">What our clients say</h2>
      </div>
      <ul class="awards" aria-label="Awards and recognition" data-reveal-stagger>
        <li class="award award--img" data-reveal="scale"><img src="/brand/Clutch_TopAutomationTesting-500x540.png" alt="Clutch: Top Automation Testing Company" width="96" height="104" loading="lazy" /></li>
        <li class="award award--img" data-reveal="scale"><img src="/brand/Clutch_TopComplianceTesting-500x540.png" alt="Clutch: Top Compliance Testing Company" width="96" height="104" loading="lazy" /></li>
        <li class="award award--img" data-reveal="scale"><img src="/brand/Clutch_TopRecoveryTesting-1-500x540.png" alt="Clutch: Top Global Recovery Testing Company" width="96" height="104" loading="lazy" /><ClaimRef id="C12" /></li>
        <li class="award award--inc" data-reveal="scale"><a href="/qualityworks-wins-inc-best-in-business-2025-award/"><span class="award__brand">Inc.</span><span class="award__name">Best in Business</span><span class="award__year">2025</span></a><ClaimRef id="C11" /></li>
        <li class="award award--navy" data-reveal="scale"><a href="/qualityworks-wins-us-navy-ai-testing-challenge/"><span class="award__name">First Prize</span><span class="award__sub">U.S. Navy AI Augmented Testing (AIAT) Challenge</span></a><ClaimRef id="C10" /><span class="awards__note">Administered by PEO MLB with Palmetto Tech Bridge</span></li>
      </ul>
      <ProofBlock />
      <p class="proof-more"><a class="link-arrow" href={site.externalPlatforms.clutch} target="_blank" rel="noopener">Read more reviews on Clutch<Icon name="external" /><span class="visually-hidden"> (opens in a new tab)</span></a></p>
    </div>
  </section>

  {/* WHERE WE WORK: build-time dotted map of the stated regions (C15) and the two offices, with an animated arc
      (Janique: "Thinking about these stats"). Regions and offices are unchanged from the live site. */}
  <section class="section surface-mint map-sec" aria-labelledby="map-title">
    <div class="container map-grid">
      <div class="map-copy" data-reveal>
        <p class="eyebrow">Where we work</p>
        <h2 id="map-title" class="display-sm">Two offices. One connected team.</h2>
        <dl class="map-facts">
          <div><dt>Headquarters</dt><dd>Los Angeles, CA</dd></div>
          <div><dt>Nearshore delivery</dt><dd>Kingston, Jamaica</dd></div>
          <div><dt>Clients across</dt><dd>US, UK, Latin America & Caribbean<ClaimRef id="C15" /></dd></div>
        </dl>
      </div>
      <WorldDots />
    </div>
  </section>

  {/* WHO WE HELP: people photo + industry chips, and the two audience cards. */}
  <section class="section help-sec" aria-labelledby="help-title">
    <div class="container help-grid">
      <div data-reveal>
        <p class="eyebrow">Who we help</p>
        <h2 id="help-title" class="display-sm">Quality for the way your industry works</h2>
        <p class="lede">Each industry carries its own risks — regulated calculations in banking, patient data in healthcare, peak-day traffic in entertainment.</p>
        <ul class="industry-chips" data-reveal-stagger>
          {industryList.map((i) => <li data-reveal="scale"><a href={i.path}>{i.name}</a></li>)}
        </ul>
      </div>
      <div class="audience-cards">
        <a class="audience audience--teal" href="/industries/public-sector/" data-reveal="right" data-tilt="4">
          <span class="eyebrow">Public sector & utilities</span>
          <span class="audience__title">Documented, requirement-based QA — with evidence you can verify.</span>
          <span class="link-arrow">For agencies and utilities<Icon name="arrow" /></span>
        </a>
        <a class="audience audience--slate" href="/industries/small-business/" data-reveal="right" data-tilt="4">
          <span class="eyebrow">Small & mid-size businesses</span>
          <span class="audience__title">Ready-made AI agent, custom build, or neither? Start with the problem.</span>
          <span class="link-arrow">For growing businesses<Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  {/* RESULTS: the three featured case studies. */}
  <section class="section surface-mint" aria-labelledby="results-title">
    <div class="container">
      <div class="section-row">
        <div class="section-intro" data-reveal><p class="eyebrow">Results</p><h2 id="results-title" class="display-sm">Outcomes from recent engagements</h2></div>
        <Button href="/case-studies/" label="All case studies" variant="secondary" size="sm" />
      </div>
      <div class="grid grid--3" data-reveal-stagger>
        {featuredCases.map((cs) => <div data-reveal="up"><CaseStudyCard cs={cs!} /></div>)}
      </div>
    </div>
  </section>

  {/* INSIGHTS + EVENTS: latest articles and the events panel (AC-HOME-3). The events panel is a contrasting
      grey card so past events no longer blend into the background (Janique). */}
  <section class="section" aria-labelledby="insights-title">
    <div class="container insights">
      <div>
        <div class="section-row">
          <div class="section-intro" data-reveal><p class="eyebrow">Insights</p><h2 id="insights-title" class="display-sm">From our team</h2></div>
          <Button href="/blog/" label="All articles" variant="secondary" size="sm" />
        </div>
        {latest.length ? (
          <div class="grid grid--3" data-reveal-stagger>{latest.map((a) => <div data-reveal="up"><ArticleCard a={a} /></div>)}</div>
        ) : (
          <EmptyState title="New articles are on the way"><p>Meanwhile, browse our <a href="/case-studies/">case studies</a>.</p></EmptyState>
        )}
      </div>
      <div class="events-strip" data-reveal>
        <div class="events-strip__head">
          <img src="/brand/stacy-kirk.png" alt="Stacy Kirk, CEO and Founder of QualityWorks" width="480" height="454" loading="lazy" class="events-strip__photo" />
          <SectionHeading eyebrow="Events" title="Events & speaking" subheading="Where’s Stacy?" level="h2" lede="Stacy Kirk, CEO and Founder, speaks to professional and student groups across the United States and abroad." />
        </div>
        {upcoming.length === 0 && (
          <p class="events-strip__fallback"><Icon name="info" />No confirmed upcoming events right now. Recent and to-be-confirmed appearances are below.</p>
        )}
        <div class="grid grid--2">{eventsToShow.map((e) => <EventCard e={e} />)}</div>
        <p><a class="link-arrow" href="/events/">All events<Icon name="arrow" /></a></p>
      </div>
    </div>
  </section>

  {/* Closing CTA: bright teal block with people photo. */}
  <CtaBand title="Tell us what you’re trying to launch." text="Testing, a new product or an AI initiative — one conversation is enough to find out whether we can help." primary={ctas.contact} secondary={ctas.caseStudies} eyebrow="Let’s talk" />
  {/* Scroll intro driver: sets --p on the intro and --ip on <html> (header reveal). Desktop + motion only. */}
  <script is:inline>
    (function () {
      var intro = document.querySelector('[data-intro]'); if (!intro) return;
      var mq = matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');
      var html = document.documentElement, raf = 0;
      var update = function () {
        raf = 0;
        var on = mq.matches; html.classList.toggle('intro-mode', on);
        if (!on) { html.style.removeProperty('--ip'); return; }
        var p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.9)));
        intro.style.setProperty('--p', p.toFixed(4));
        html.style.setProperty('--ip', Math.min(1, Math.max(0, (p - 0.55) / 0.4)).toFixed(4));
      };
      var queue = function () { if (!raf) raf = requestAnimationFrame(update); };
      addEventListener('scroll', queue, { passive: true }); addEventListener('resize', queue); mq.addEventListener('change', queue);
      update();
    })();
  </script>
</BaseLayout>

<style>
  /* ---------- HERO: bright teal block ---------- */
  .hero { position: relative; overflow: hidden; padding: 0 0 clamp(7rem, 5rem + 6vw, 10rem); }
  .hero__media { position: relative; overflow: hidden; }
  .hero__photo { display: block; width: 100%; aspect-ratio: 16 / 10; height: auto; object-fit: cover; }
  .hero__grid { position: relative; z-index: 2; padding-top: var(--space-8); }
  .hero__copy h1 { margin-bottom: var(--space-6); max-width: 10ch; font-size: clamp(2.75rem, 1.6rem + 3.6vw, 4.75rem); }
  .hero__lede { max-width: 31rem; font-size: var(--fs-md); }
  .hero__ctas { margin-top: var(--space-6); }
  .hero__facts { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); list-style: none; padding: 0; margin: var(--space-6) 0 0; font: var(--fw-semibold) var(--fs-sm)/1.4 var(--font-display); }
  .hero__facts li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .hero__facts li::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--qw-slate-900); }
  .hero__media :global(.fui) { display: none; }
  .stack3d { display: none; }
  @media (min-width: 1024px) {
    .hero { display: flex; align-items: center; padding-block: var(--space-12) 8.5rem; }
    .hero__grid { width: 100%; padding-top: 0; }
    .hero__media { position: absolute; top: 0; right: 0; bottom: 0; width: 62%; }
    .hero__photo { height: 100%; aspect-ratio: auto; -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 8%, #000 40%); mask-image: linear-gradient(90deg, transparent 0%, transparent 8%, #000 40%); }
    .hero__copy { max-width: 33rem; }
    .hero__media :global(.fui) { display: block; }
    /* 3D stack of report cards that tilts toward the pointer (--mx/--my from data-pointer-scene). */
    .stack3d { display: block; position: absolute; left: 24%; bottom: 20%; width: 200px; height: 150px; perspective: 900px; z-index: 3; }
    .stack3d__card { position: absolute; inset: 0; border-radius: 16px; background: var(--qw-white); color: var(--qw-slate-900); box-shadow: 0 30px 60px -20px rgba(34,43,55,.5); padding: 14px 16px; font: 700 12px/1.3 var(--font-display); display: grid; align-content: start; gap: 8px;
      transform: rotateX(calc(14deg - var(--my) * 10deg)) rotateY(calc(-18deg + var(--mx) * 14deg)) translateZ(var(--z)); transition: transform 600ms var(--ease-out); }
    .stack3d__card--1 { --z: 0px; }
    .stack3d__card--2 { --z: 40px; inset: 34px -34px -34px 34px; background: var(--qw-slate-900); color: var(--qw-white); }
    .stack3d__card--3 { --z: 80px; inset: 92px auto auto 140px; width: 130px; height: 48px; display: flex; align-items: center; gap: 8px; background: var(--qw-green-500); }
    .stack3d__card--3 :global(svg) { width: 18px; height: 18px; }
    .stack3d__card i { display: block; height: 7px; width: var(--w); border-radius: 6px; background: var(--qw-teal-500); }
    .stack3d__card code { font: 500 11px/1.4 var(--font-code); color: var(--qw-green-500); }
    .s3-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--qw-green-500); animation: qw-pulse 1.8s ease-out infinite; }
  }

  /* ---------- SCROLL INTRO (desktop, motion allowed; html.intro-mode set by the script below) ----------
     --p runs 0 → 1 over the first 90% of a viewport of scroll. p=0: hero covers the screen edge to edge, photo
     zoomed in, header hidden above, cards hidden below. p=1: hero is an inset rounded panel below the header,
     photo at normal scale, cards in place overlapping its bottom edge. */
  @media (min-width: 1024px) {
    :global(html.intro-mode) .intro { --p: 0; height: 190vh; position: relative; }
    :global(html.intro-mode) .intro__stage { position: sticky; top: 0; height: 100vh; overflow: hidden; background: var(--qw-white); }
    :global(html.intro-mode) .intro .hero { position: absolute; min-height: 0; padding-block: 0;
      top: calc(var(--p) * 88px); left: calc(var(--p) * 24px); right: calc(var(--p) * 24px); bottom: calc(var(--p) * 24px);
      border-radius: calc(var(--p) * 32px); }
    :global(html.intro-mode) .intro .hero__photo { transform: scale(calc(1.18 - var(--p) * 0.18)); transform-origin: 60% 50%; }
    :global(html.intro-mode) .intro .hero__copy { transform: translateY(calc(var(--p) * -84px)) scale(calc(1.08 - var(--p) * 0.14)); transform-origin: left center; }
    :global(html.intro-mode) .intro .pathways-wrap { position: absolute; left: 0; right: 0; width: auto; bottom: 48px; margin: 0 auto;
      opacity: clamp(0, calc(var(--p) * 2 - 0.8), 1); transform: translateY(calc((1 - var(--p)) * 160px)); }
    :global(html.intro-mode) .intro .pathway { padding-block: var(--space-6) var(--space-5); }
    :global(html.intro-mode) .intro .pathway__text, :global(html.intro-mode) .intro .pathway__icon { display: none; }
    :global(html.intro-mode .site-header) { position: fixed; left: 0; right: 0; top: 0; transform: translateY(calc((var(--ip, 1) - 1) * 110%)); }
    :global(html.intro-mode) .intro .hero__facts { display: none; }
    :global(html.intro-mode) .intro__hint { display: flex; }
  }
  .intro__hint { display: none; position: absolute; left: 50%; bottom: 28px; translate: -50% 0; z-index: 4; align-items: center; gap: 8px; font: var(--fw-bold) var(--fs-xs)/1 var(--font-display); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-slate-900); opacity: calc(1 - var(--p, 1) * 4); pointer-events: none; }
  .intro__hint i { width: 22px; height: 34px; border: 2px solid currentColor; border-radius: 12px; position: relative; }
  .intro__hint i::after { content: ""; position: absolute; left: 50%; top: 6px; width: 4px; height: 7px; margin-left: -2px; border-radius: 2px; background: currentColor; animation: hint 1.6s ease-in-out infinite; }
  @keyframes hint { 50% { transform: translateY(8px); opacity: 0.3; } }

  /* Pathway cards overlap the hero's bottom edge. */
  .pathways-wrap { position: relative; z-index: 3; margin-top: calc(-1 * clamp(5rem, 4rem + 3vw, 7rem)); }
  .pathways { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .pathway { position: relative; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-8) var(--space-6) var(--space-6); border-radius: 24px; box-shadow: 0 30px 60px -30px rgba(34,43,55,.45); }
  .pathway--white { background: linear-gradient(160deg, rgba(29,118,111,0.78), rgba(24,98,92,0.86)); -webkit-backdrop-filter: blur(24px) saturate(170%); backdrop-filter: blur(24px) saturate(170%); border: 1px solid rgba(255,255,255,0.32); color: var(--qw-white); }
  .pathway--green { background: linear-gradient(160deg, rgba(30,127,92,0.84), rgba(22,104,75,0.9)); -webkit-backdrop-filter: blur(24px) saturate(170%); backdrop-filter: blur(24px) saturate(170%); border: 1px solid rgba(255,255,255,0.32); color: var(--qw-white); }
  .pathway--green .pathway__cta { color: var(--qw-white); }
  .pathway--slate { background: rgba(34,43,55,0.66); -webkit-backdrop-filter: blur(20px) saturate(140%); backdrop-filter: blur(20px) saturate(140%); border: 1px solid rgba(255,255,255,0.14); color: var(--qw-white); }
  /* Liquid glass: a soft specular sheen and bright top edge over the blur. */
  .pathway { box-shadow: 0 30px 60px -30px rgba(34,43,55,.5), inset 0 1px 0 rgba(255,255,255,.75), inset 0 -1px 0 rgba(255,255,255,.12); overflow: hidden; }
  .pathway::before { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: linear-gradient(135deg, rgba(255,255,255,.45) 0%, rgba(255,255,255,0) 38%, rgba(255,255,255,0) 70%, rgba(255,255,255,.18) 100%); }
  .pathway__icon { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: var(--qw-teal-500); color: var(--qw-slate-900); margin-bottom: var(--space-3); }
  .pathway--green .pathway__icon { background: var(--qw-slate-900); color: var(--qw-white); }
  .pathway--slate .pathway__icon { background: var(--qw-green-500); }
  .pathway__icon :global(svg) { width: 22px; height: 22px; }
  .pathway__label { margin: 0; font: var(--fw-bold) var(--fs-xs)/1.3 var(--font-display); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .pathway__title { margin: 0; font-size: var(--fs-lg); line-height: 1.2; }
  .pathway__title { color: inherit; }
  .pathway__title a { color: inherit; text-decoration: none; }
  .pathway__title a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .pathway:has(a:focus-visible) { outline: 3px solid var(--qw-slate-900); outline-offset: 3px; }
  .pathway__title a:focus-visible { outline: none; }
  .pathway__text { margin: 0; font-size: var(--fs-sm); }
  .pathway__cta { margin-top: auto; padding-top: var(--space-4); display: inline-flex; align-items: center; gap: 0.4em; font: var(--fw-bold) var(--fs-sm)/1 var(--font-display); }
  .pathway--white .pathway__cta { color: var(--qw-white); }
  .pathway--white .pathway__icon { background: var(--qw-white); color: var(--qw-teal-800); }
  .pathway--slate .pathway__cta { color: var(--qw-green-500); }
  .pathway__cta :global(svg) { width: 1em; height: 1em; transition: transform var(--dur-base) var(--ease-out); }
  .pathway:hover .pathway__cta :global(svg) { transform: translateX(4px); }

  /* ---------- WHY: collage + bold statement ---------- */
  .why-grid { display: grid; gap: var(--space-12); align-items: center; }
  @media (min-width: 960px) { .why-grid { grid-template-columns: 0.95fr 1.05fr; gap: var(--space-16); } }
  .collage { position: relative; min-height: 26rem; }
  .collage img { position: absolute; object-fit: cover; border-radius: 24px; box-shadow: var(--shadow-lg); }
  .collage__a { left: 0; top: 0; width: 78%; height: 68%; }
  .collage__b { right: 0; bottom: 0; width: 56%; height: 52%; border: 6px solid var(--qw-mint-50); }
  .collage__chip { left: 6%; bottom: 8%; position: absolute; }
  .collage__block { position: absolute; right: 6%; top: -6%; width: 110px; height: 110px; border-radius: 50%; background: var(--qw-green-500); z-index: -1; }
  .beyond { font-weight: var(--fw-black); color: var(--qw-teal-700); white-space: nowrap; background: linear-gradient(transparent 64%, color-mix(in srgb, var(--qw-green-500) 45%, transparent) 64%); }
  .intro__copy .lede { margin-block: var(--space-6); }
  .why { list-style: none; padding: 0; margin: 0 0 var(--space-8); display: grid; gap: var(--space-4); counter-reset: why; }
  .why__item { counter-increment: why; position: relative; padding: var(--space-5) var(--space-6) var(--space-5) 4.5rem; background: rgba(255,255,255,0.7); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.7); border-radius: 18px; box-shadow: var(--shadow-sm); }
  .why__item::before { content: "0" counter(why); position: absolute; left: var(--space-5); top: var(--space-5); font: var(--fw-black) var(--fs-lg)/1 var(--font-display); color: var(--qw-teal-500); }
  .why__item h3 { font-size: var(--fs-md); margin-bottom: var(--space-2); }
  .why__item p { margin: 0; font-size: var(--fs-sm); color: var(--color-muted); }

  /* ---------- STORY: sticky transforming visual ---------- */
  .story { display: grid; gap: var(--space-10); }
  .story__visual { display: none; }
  .story__step { padding: var(--space-8); border-radius: 24px; background: var(--qw-mint-50); }
  .way__index { font: var(--fw-bold) var(--fs-xs)/1 var(--font-display); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-teal-700); }
  .way__title { font-size: var(--fs-xl); margin: var(--space-3) 0; }
  .way__list { margin: var(--space-6) 0; }
  .way__links-title { font: var(--fw-bold) var(--fs-xs)/1.3 var(--font-display); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-muted); margin: 0 0 var(--space-2); }
  .way__links ul { list-style: none; padding: 0; margin: 0 0 var(--space-6); display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); font-size: var(--fs-sm); }
  @media (min-width: 1024px) {
    .story { grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: start; }
    .story__visual { display: block; position: sticky; top: 7rem; }
    .story__steps { display: grid; gap: 40vh; padding-block: 8vh 18vh; }
    .story__step { background: transparent; padding: 0 0 0 var(--space-6); border-left: 3px solid var(--qw-line); transition: border-color 400ms var(--ease-out); }
    .story__step.is-active { border-left-color: var(--qw-teal-500); }
    :global(html:not(.js-motion)) .story__step, :global(html.reduced-motion) .story__step { opacity: 1; }
  }
  .story__screen { position: relative; container-type: inline-size; aspect-ratio: 4 / 3.4; border-radius: 28px; background: linear-gradient(150deg, var(--qw-teal-500), var(--qw-teal-700)); overflow: hidden; box-shadow: 0 40px 80px -40px rgba(34,43,55,.5); transition: background 700ms var(--ease-out); }
  .story__screen::before { content: ""; position: absolute; inset: 0; background: radial-gradient(50% 40% at 20% 15%, rgba(255,255,255,.28), transparent 70%), radial-gradient(40% 40% at 85% 90%, rgba(44,175,129,.5), transparent 70%); }
  .story[data-active="1"] .story__screen { background: linear-gradient(150deg, var(--qw-green-500), #1E7F5C); }
  .story[data-active="2"] .story__screen { background: linear-gradient(150deg, var(--qw-slate-800), var(--qw-slate-950)); }
  .sv { position: absolute; inset: 7%; display: grid; place-items: center; opacity: 0; transform: translateY(30px) scale(0.96); transition: opacity 500ms var(--ease-out) 350ms, transform 700ms var(--ease-out) 350ms; pointer-events: none; }
  .story[data-active="0"] .sv--0, .story[data-active="1"] .sv--1, .story[data-active="2"] .sv--2 { opacity: 1; transform: none; transition-delay: 0ms; }

  /* State 0: desktop monitor running a test suite; rows load, then take off upward when you scroll on. */
  .mon { width: 100%; display: grid; justify-items: center; }
  .mon__screen { width: 100%; aspect-ratio: 16 / 10.5; border-radius: 2.4cqw; padding: 3.2cqw; background: rgba(255,255,255,.82); -webkit-backdrop-filter: blur(20px) saturate(170%); backdrop-filter: blur(20px) saturate(170%); border: 0.9cqw solid var(--qw-slate-900); box-shadow: 0 3cqw 6cqw -2cqw rgba(0,0,0,.4), inset 0 1px 0 #fff; overflow: hidden; display: flex; flex-direction: column; gap: 1.1cqw; color: var(--qw-slate-900); }
  .mon__neck { width: 12%; height: 5cqw; background: linear-gradient(var(--qw-slate-800), var(--qw-slate-900)); }
  .mon__base { width: 34%; height: 1.6cqw; border-radius: 1cqw 1cqw 0.4cqw 0.4cqw; background: var(--qw-slate-900); }
  .mon__bar { display: flex; align-items: center; gap: 0.9cqw; font: 700 2.2cqw/1 var(--font-display); margin-bottom: 0.8cqw; }
  .mon__bar i { width: 1.4cqw; height: 1.4cqw; border-radius: 50%; background: #ff5f57; } .mon__bar i:nth-child(2) { background: #febc2e; } .mon__bar i:nth-child(3) { background: #28c840; }
  .mon__bar span { margin-left: 1cqw; }
  .tr { display: grid; grid-template-columns: 3cqw 15cqw 1fr; align-items: center; gap: 1.6cqw; font: 600 2cqw/1 var(--font-display); padding: 0.6cqw 0; border-bottom: 1px solid rgba(34,43,55,.08); transition: transform 600ms cubic-bezier(.5,0,.75,0), opacity 500ms; transition-delay: calc(var(--k) * 60ms); }
  .tr__state { position: relative; width: 2.6cqw; height: 2.6cqw; }
  .tr__spin { position: absolute; inset: 0; border-radius: 50%; border: 0.45cqw solid rgba(41,165,154,.25); border-top-color: var(--qw-teal-500); animation: tr-spin 0.8s linear infinite; transition: opacity 200ms; transition-delay: calc(var(--k) * 320ms + 1000ms); }
  .tr__state :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--qw-green-500); opacity: 0; transform: scale(.4); transition: opacity 250ms, transform 350ms var(--ease-out); transition-delay: calc(var(--k) * 320ms + 1000ms); }
  @keyframes tr-spin { to { transform: rotate(360deg); } }
  .tr__bar { height: 1.1cqw; border-radius: 1cqw; background: var(--qw-mint-50); overflow: hidden; }
  .tr__bar i { display: block; height: 100%; width: 0; border-radius: inherit; background: linear-gradient(90deg, var(--qw-teal-500), var(--qw-green-500)); transition: width 1000ms var(--ease-out); transition-delay: calc(var(--k) * 320ms); }
  .story[data-active="0"] .tr__bar i { width: 100%; }
  .story[data-active="0"] .tr__spin { opacity: 0; }
  .story[data-active="0"] .tr__state :global(svg) { opacity: 1; transform: none; }
  .story:not([data-active="0"]) .tr { transform: translateY(-60cqw) rotate(-4deg); opacity: 0; }
  .story:not([data-active="0"]) .tr__bar i, .story:not([data-active="0"]) .tr__spin, .story:not([data-active="0"]) .tr__state :global(svg) { transition-delay: 0ms; }
  .mon__foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font: 700 1.9cqw/1 var(--font-display); }
  .mon__pill { padding: 1cqw 1.6cqw; border-radius: 4cqw; background: var(--qw-green-500); color: var(--qw-slate-900); opacity: 0; transition: opacity 400ms 2.9s; }
  .mon__ship { display: inline-flex; align-items: center; gap: .6cqw; color: var(--qw-teal-800); } .mon__ship :global(svg) { width: 2cqw; height: 2cqw; }
  .story[data-active="0"] .mon__pill { opacity: 1; }

  /* State 1: laptop + phone with an app being built (code types in, UI blocks assemble). */
  .devs { position: relative; width: 100%; height: 100%; }
  .lap { position: absolute; left: 0; top: 10%; width: 82%; }
  .lap__screen { aspect-ratio: 16 / 10; border: 1.2cqw solid var(--qw-slate-900); border-bottom-width: 1.8cqw; border-radius: 2cqw 2cqw 0 0; background: rgba(255,255,255,.85); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); display: grid; grid-template-columns: 44% 1fr; overflow: hidden; }
  .lap__base { height: 2.4cqw; margin-inline: -6%; border-radius: 0 0 2cqw 2cqw; background: linear-gradient(var(--qw-slate-700), var(--qw-slate-900)); }
  .lap__code { background: var(--qw-slate-900); padding: 2.4cqw 2cqw; display: grid; gap: 1.4cqw; align-content: start; }
  .lap__code i { display: block; height: 1.1cqw; width: var(--w); margin-left: var(--x); border-radius: 1cqw; background: linear-gradient(90deg, var(--qw-green-500), var(--qw-teal-500)); transform-origin: left; transform: scaleX(0); transition: transform 400ms var(--ease-out); transition-delay: calc(var(--k) * 180ms); }
  .lap__code i:nth-child(3n) { background: rgba(255,255,255,.55); } .lap__code i:nth-child(4n) { background: #febc2e; }
