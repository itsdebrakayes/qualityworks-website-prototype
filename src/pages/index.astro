---
import { RELEASE, REVIEW } from '../lib/release';
/**
 * HOMEPAGE — reference implementation of the design system.
 * Primary persona: Enterprise CTO/VP Eng (A) and SMB Founder/COO (D). Secondary: QA Director (B), Public sector (C).
 * Core question: "What does QualityWorks do, and which part is relevant to me?"
 * Conversion: Talk to an expert (/contact-us/) or self-select a pathway.
 *
 * URL: / (the site root).
 * Persona / CTA (docs/03-page-map-personas.md §2, "Home" row): primary A Enterprise CTO; D SMB Founder.
 *   Secondary B QA Director; C Public sector. Proof required: approved stats (C01–C04), awards (C10–C12),
 *   3 case studies. Primary CTA: "Talk to an expert" to /contact-us/; secondary "Explore solutions".
 *   Journeys A and D in docs/03 §3 start here.
 * What, top to bottom (each block is marked with a {comment} in the markup): HERO with company facts and
 *   the three pathways; STATS; INTRO ("Why QualityWorks"); THREE WAYS (pathway detail cards); PRODUCTS
 *   (with a review-only PRISM sample); PROOF (awards + testimonials); WHO WE HELP; RESULTS (3 case
 *   studies); INSIGHTS + EVENTS; closing CtaBand.
 * Data: src/data/services.ts (`pathways`, `servicesByPathway`), src/data/products.ts, src/data/caseStudies.ts,
 *   src/data/articles.ts (`blogPosts`), src/data/events.ts, src/data/industries.ts, src/data/site.ts (`ctas`,
 *   `site.externalPlatforms.clutch`), src/data/claims.ts via StatBlock/ClaimRef, testimonials via ProofBlock.
 *   The pathway bullet lists and some section copy are inline.
 * SEO: inline title/description. JSON-LD: Organization (organizationLd from src/lib/schema.ts). No
 *   breadcrumbs, so no BreadcrumbList.
 * Requirements: docs/10-acceptance-criteria.md AC-HOME-1 (h1, both hero CTAs and all three pathway links
 *   visible without scrolling at 1440 x 900; QA-16), AC-HOME-2 (every statistic references a claim ID;
 *   enforced by StatBlock) and AC-HOME-3 (events fallback message when nothing is upcoming).
 * Review/release behaviour:
 *   - StatBlock: in RELEASE it drops stats whose claim has a `verification` value (today C02, C03, C04),
 *     leaving only C01, and hides the footnote.
 *   - ClaimRef badges (C05–C07, C10–C12, C14, C15) render in REVIEW only.
 *   - The PRISM sample score card renders in REVIEW only (`{REVIEW && ...}`).
 *   - Events: fixtures are excluded here in every build; RELEASE also drops unverified/undated events
 *     inside events.ts.
 * Gotchas:
 *   - Keep the hero short: AC-HOME-1 needs the pathways above the fold at 1440 x 900.
 *   - Featured case studies and products are chosen by hard-coded slugs below; a renamed slug silently
 *     drops a card (case studies) or moves it to the "more" list (products).
 *   - `pathwayBullets` keys must match the pathway ids in services.ts (quality, build, ai).
 *   - The "beyond the code" phrase must not be wrapped in angle brackets (content-check flags the bracketed
 *     form); it is styled with <em class="beyond"> instead.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatBlock from '../components/StatBlock.astro';
import ClaimRef from '../components/ClaimRef.astro';
import ProductCard from '../components/ProductCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EventCard from '../components/EventCard.astro';
import ProofBlock from '../components/ProofBlock.astro';
import CtaBand from '../components/CtaBand.astro';
import EmptyState from '../components/EmptyState.astro';
import { pathways, servicesByPathway } from '../data/services';
import { products } from '../data/products';
import { caseStudyBySlug } from '../data/caseStudies';
import { blogPosts } from '../data/articles';
import { events, eventPhase } from '../data/events';
import { industries } from '../data/industries';
import { peopleImage, peopleSrc, peopleSrcset } from '../data/peopleImagery';
import { ctas, site } from '../data/site';
import { organizationLd } from '../lib/schema';

// Homepage hero photograph (visual revision, docs/15): people working through a technical problem together.
const heroImage = peopleImage('home-mentoring');
// Bullet lists for the THREE WAYS cards, keyed by pathway id. Homepage-only copy.
const pathwayBullets = {
  quality: ['AI-generated test cases & automation scripts', 'AI-assisted regression testing', 'Web, mobile, API & USSD coverage', 'Full-stack QA managed service', 'Test maturity assessments & roadmaps'],
  build: ['Custom web & mobile applications', 'AI-accelerated development cycles', 'Rapid prototyping & MVP delivery', 'UX/UI design & product strategy', 'Nearshore delivery at competitive rates'],
  ai: ['Custom AI agent design & deployment', 'Generative AI integration & strategy', 'Data quality and governance', 'Technology advisory (CTO-as-a-service)'],
};
// Three featured case studies (WSSC, fintech modernization, JMMB); missing slugs are dropped.
const featuredCases = ['ai-powered-test-case-generation-wssc', 'fintech-legacy-platform-modernization', 'jmmb-group-leverages-automation-best-practices'].map(caseStudyBySlug).filter(Boolean);
// Latest three migrated posts (articles.ts sorts newest first); fixtures are not in blogPosts.
const latest = blogPosts.slice(0, 3);
// Events band (AC-HOME-3): never show fixtures on the homepage. Prefer up to two upcoming events; if there are
// none, fall back to the first two remaining events (past or date-TBC) and show the fallback message.
const homeEvents = events.filter((e) => e.provenance.approval !== 'fixture');
const upcoming = homeEvents.filter((e) => eventPhase(e) === 'upcoming');
const eventsToShow = upcoming.length ? upcoming.slice(0, 2) : homeEvents.slice(0, 2);
// Three products get full cards; the rest (external platforms today) are listed as compact external links.
const featuredProducts = products.filter((p) => ['qualitywatcher-ai-tools', 'agents-as-a-service', 'prism'].includes(p.slug));
const otherProducts = products.filter((p) => !featuredProducts.includes(p));
// Live industry pages only; the two proposed audience pages get their own cards in WHO WE HELP.
const industryList = industries.filter((i) => i.status === 'live');
---
<BaseLayout
  seo={{ title: 'QualityWorks Consulting Group | Software Quality, Custom Software & AI', description: 'QualityWorks tests smarter, builds faster and deploys AI: AI-powered testing, custom web and mobile development, and agentic business solutions since 2010.' }}
  jsonLd={[organizationLd()]}
>
  {/* HERO: h1, two CTAs (Talk to an expert, Explore solutions), company facts, then the three pathway cards.
      Everything here must fit above the fold at 1440 x 900 (AC-HOME-1).
      Visual revision (docs/15): the stage is a photograph of people working through a technical problem
      together (src/data/peopleImagery.ts, "home-mentoring", from the live site). On desktop the photo fills
      the stage and a slate scrim sits behind the copy, so the text never depends on the image for contrast;
      the people stay clear on the right. Below 1100px the photo becomes a band above the copy. */}
  <section class="home-hero surface-dark" aria-labelledby="hero-title">
    <div class="home-hero__stage">
      <img class="home-hero__photo" src={peopleSrc(heroImage)} srcset={peopleSrcset(heroImage)} sizes="100vw"
        alt={heroImage.alt} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async"
        style={`object-position: ${heroImage.focus}`} />
      <div class="home-hero__scrim" aria-hidden="true"></div>
      <div class="container home-hero__grid">
        <div class="home-hero__copy">
          <p class="eyebrow">QualityWorks Consulting Group</p>
          {/* Tagline per the brand guide: title case, always with the period. */}
          <h1 id="hero-title">Engineered for Excellence.</h1>
          <p class="lede">We test smarter, build faster, and deploy AI to transform how businesses operate — from AI-powered testing to custom apps to AI agents that take work off your team’s plate.</p>
          {/* The page's single brand-gradient moment (guide: once per layout). */}
          <span class="brand-rule home-hero__rule" aria-hidden="true"></span>
          <div class="btn-row home-hero__ctas">
            <Button cta={ctas.contact} />
            <Button cta={ctas.exploreSolutions} />
          </div>
          <ul class="home-hero__facts" aria-label="Company facts">
            <li>Founded 2010<ClaimRef id="C14" /></li>
            <li>Los Angeles · Kingston</li>
            <li>US, UK, Latin America & Caribbean<ClaimRef id="C15" /></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="container">
      <ul class="pathways" aria-label="Three ways we help">
        {pathways.map((p) => (
          <li class="pathway" data-pathway={p.id}>
            {/* Whole card is clickable: the title link's ::after stretches over the card (see CSS). The CTA text is
                aria-hidden so screen readers hear the link once, via the h2. */}
            <p class="pathway__label">{p.label}</p>
            <h2 class="pathway__title"><a href={p.href}>{p.title}</a></h2>
            <p class="pathway__text">{p.text}</p>
            <span class="pathway__cta" aria-hidden="true">{p.cta}<Icon name="arrow" /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* STATS: headline figures, each tied to a claim ID (AC-HOME-2). StatBlock removes unverified ones in release. */}
  <section class="section section--tight" aria-labelledby="impact-title">
    <div class="container">
      <h2 id="impact-title" class="visually-hidden">QualityWorks impact</h2>
      <StatBlock
        stats={[
          { value: '16+', label: 'Years of quality-driven development', claim: 'C01' },
          { value: '90%', label: 'Increase in quality releases (avg. per client)', claim: 'C02' },
          { value: '$30M', label: 'Cost savings through automation', claim: 'C03' },
          { value: '80%', label: 'Faster time to market (avg. per client)', claim: 'C04' },
        ]}
        footnote="Figures as currently published on qualityworkscg.com. Measurement context for the 90%, $30M and 80% figures requires verification before launch; they have not been independently verified."
      />
    </div>
  </section>

  {/* INTRO: "Why QualityWorks": positioning statement plus three reasons, with claim annotations on each figure. */}
  <section class="section surface-alt intro" aria-labelledby="intro-title">
    <div class="container split">
      <div>
        <p class="eyebrow">Why QualityWorks</p>
        <h2 id="intro-title">We go <em class="beyond">beyond the code</em> to help clients reach their most extraordinary digital goals.</h2>
      </div>
      <div class="intro__copy">
        <p class="lede">Founded in 2010, QualityWorks is a Black-owned, woman-led software solutions firm<ClaimRef id="C14" /> focused on helping companies build higher-quality software, create future-ready teams and accelerate delivery.</p>
        <div class="why">
          <div class="why__item">
            <h3>We make your team faster without making it bigger</h3>
            <p>AI-powered automation and process improvements have taken regression cycles from 4 days to 45 minutes<ClaimRef id="C05" /> and saved nearly 500 testing hours weekly for a single client<ClaimRef id="C06" />.</p>
          </div>
          <div class="why__item">
            <h3>AI is baked in, not bolted on</h3>
            <p>Our own AI tools help create test cases and automation faster<ClaimRef id="C07" />, and PRISM™ evaluates the quality of AI-generated outputs themselves.</p>
          </div>
          <div class="why__item">
            <h3>We leave your team better than we found it</h3>
            <p>We train your QA and development teams alongside every engagement. At JMMB, manual testers learned to write and run automated tests.</p>
          </div>
        </div>
        <a class="link-arrow" href="/about-us/">About QualityWorks<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  {/* THREE WAYS: one card per pathway with bullets, up to four related full-depth services and a CTA.
      id="solutions" makes this section an in-page anchor. */}
  <section class="section" id="solutions" aria-labelledby="ways-title">
    <div class="container">
      <SectionHeading eyebrow="Our services" title="Three ways we drive your business forward" lede="From bulletproof testing to full-scale digital products to AI-powered operations — we handle the hard parts so you can move faster." id="ways-title" />
      <div class="ways">
        {pathways.map((p) => (
          <article class="way reveal" data-pathway={p.id}>
            <p class="way__index mono">{p.index} / {p.label}</p>
            <h3 class="way__title">{p.title}</h3>
            <p class="way__text">{p.text}</p>
            <ul class="checklist way__list">{pathwayBullets[p.id].map((b) => <li>{b}</li>)}</ul>
            <div class="way__links">
              <p class="way__links-title">Related services</p>
              <ul>
                {servicesByPathway(p.id).filter((s) => s.contentDepth === 'full').slice(0, 4).map((s) => <li><a href={s.path}>{s.name}</a></li>)}
              </ul>
            </div>
            <Button href={p.href} label={p.cta} variant="secondary" size="sm" />
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* PRODUCTS: featured product cards, review-only PRISM sample score, and compact links to external products. */}
  <section class="section surface-product products" aria-labelledby="products-title">
    <div class="container">
      <div class="products__head">
        <SectionHeading eyebrow="Products & innovations" title="Software we build for quality and AI" lede="Our products are separate from our consulting services. Some live on their own platforms — we’ll always tell you when a link takes you there." id="products-title" />
        {/* Review-only: reproduces the sample score from the live homepage; removed from release builds. */}
        {REVIEW && <div class="prism-sample" data-review-note="Sample score reproduced from the live homepage">
          <p class="prism-sample__label mono">PRISM™ sample score</p>
          <p class="prism-sample__grade">C+</p>
          <p class="prism-sample__desc">Fair — correct in parts</p>
          <div class="prism-sample__bar" role="img" aria-label="Sample score 78 percent"><span style="width:78%"></span></div>
          <p class="prism-sample__note">Illustrative sample, as shown on the current homepage.</p>
        </div>}
      </div>
      <div class="grid grid--3">
        {featuredProducts.map((p) => <ProductCard p={p} />)}
      </div>
      <ul class="products__more">
        {otherProducts.map((p) => (
          <li><a href={p.path} target="_blank" rel="noopener"><strong>{p.name}</strong> — {p.tagline}<Icon name="external" /><span class="visually-hidden"> (external site, opens in a new tab)</span></a></li>
        ))}
        <li><a href="/products/"><strong>All products</strong> — compare what each one does<Icon name="arrow" /></a></li>
      </ul>
    </div>
  </section>

  {/* PROOF: Clutch badges and awards (claims C10–C12), testimonials, and a link to Clutch reviews. */}
  <section class="section" aria-labelledby="proof-title">
    <div class="container">
      <SectionHeading eyebrow="Recognition" title="What our clients say" id="proof-title" />
      <ul class="awards" aria-label="Awards and recognition">
        <li><img src="/brand/Clutch_TopAutomationTesting-500x540.png" alt="Clutch: Top Automation Testing Company" width="96" height="104" loading="lazy" /></li>
        <li><img src="/brand/Clutch_TopComplianceTesting-500x540.png" alt="Clutch: Top Compliance Testing Company" width="96" height="104" loading="lazy" /></li>
        <li><img src="/brand/Clutch_TopRecoveryTesting-1-500x540.png" alt="Clutch: Top Global Recovery Testing Company" width="96" height="104" loading="lazy" /><ClaimRef id="C12" /></li>
        <li class="awards__text"><a href="/qualityworks-wins-inc-best-in-business-2025-award/">Inc. Best in Business 2025</a><ClaimRef id="C11" /></li>
        <li class="awards__text awards__text--wide"><a href="/qualityworks-wins-us-navy-ai-testing-challenge/">First Prize, U.S. Navy AI Augmented Testing (AIAT) Challenge</a><ClaimRef id="C10" /><span class="awards__note">Administered by PEO MLB with Palmetto Tech Bridge</span></li>
      </ul>
      <ProofBlock />
      <p class="proof-more"><a class="link-arrow" href={site.externalPlatforms.clutch} target="_blank" rel="noopener">Read more reviews on Clutch<Icon name="external" /><span class="visually-hidden"> (opens in a new tab)</span></a></p>
    </div>
  </section>

  {/* WHO WE HELP: live industry chips, plus cards for the two proposed audience pages (personas C and D). */}
  <section class="section surface-tint" aria-labelledby="help-title">
    <div class="container split split--reverse">
      <div>
        <SectionHeading eyebrow="Who we help" title="Quality for the way your industry works" lede="Each industry carries its own risks — regulated calculations in banking, patient data in healthcare, peak-day traffic in entertainment." id="help-title" />
        <ul class="industry-chips">
          {industryList.map((i) => <li><a href={i.path}>{i.name}</a></li>)}
        </ul>
      </div>
      <div class="audience-cards">
        <a class="audience" href="/industries/public-sector/">
          <span class="eyebrow">Public sector & utilities</span>
          <span class="audience__title">Documented, requirement-based QA — with evidence you can verify.</span>
          <span class="link-arrow">For agencies and utilities<Icon name="arrow" /></span>
        </a>
        <a class="audience" href="/industries/small-business/">
          <span class="eyebrow">Small & mid-size businesses</span>
          <span class="audience__title">Ready-made AI agent, custom build, or neither? Start with the problem.</span>
          <span class="link-arrow">For growing businesses<Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  {/* RESULTS: the three featured case studies. */}
  <section class="section" aria-labelledby="results-title">
    <div class="container">
      <div class="section-row">
        <SectionHeading eyebrow="Results" title="Outcomes from recent engagements" id="results-title" />
        <Button href="/case-studies/" label="All case studies" variant="secondary" size="sm" />
      </div>
      <div class="grid grid--3">
        {featuredCases.map((cs) => <CaseStudyCard cs={cs!} />)}
      </div>
    </div>
  </section>

  {/* INSIGHTS + EVENTS: latest articles (with an empty state) and the events strip with its no-upcoming fallback (AC-HOME-3). */}
  <section class="section surface-alt" aria-labelledby="insights-title">
    <div class="container insights">
      <div>
        <div class="section-row">
          <SectionHeading eyebrow="Insights" title="From our team" id="insights-title" />
          <Button href="/blog/" label="All articles" variant="secondary" size="sm" />
        </div>
        {latest.length ? (
          <div class="grid grid--3">{latest.map((a) => <ArticleCard a={a} />)}</div>
        ) : (
          <EmptyState title="New articles are on the way"><p>Meanwhile, browse our <a href="/case-studies/">case studies</a>.</p></EmptyState>
        )}
      </div>
      <div class="events-strip">
        <div class="section-row">
          <SectionHeading eyebrow="Events" title="Events & speaking" subheading="Where’s Stacy?" level="h2" lede="Stacy Kirk, CEO and Founder, speaks to professional and student groups across the United States and abroad." />
        </div>
        {upcoming.length === 0 && (
          <p class="events-strip__fallback"><Icon name="info" />No confirmed upcoming events right now. Recent and to-be-confirmed appearances are below.</p>
        )}
        <div class="grid grid--2">{eventsToShow.map((e) => <EventCard e={e} />)}</div>
        <p><a class="link-arrow" href="/events/">All events<Icon name="arrow" /></a></p>
      </div>
    </div>
  </section>

  {/* Closing CTA: contact, or see case studies. */}
  <CtaBand title="Tell us what you’re trying to launch." text="Testing, a new product or an AI initiative — one conversation is enough to find out whether we can help." primary={ctas.contact} secondary={ctas.caseStudies} eyebrow="Let’s talk" />
</BaseLayout>

<style>
  /* Hero (visual revision): solid slate-900 section. The "stage" holds the photo, the scrim and the copy;
     the pathway cards sit below the stage on plain slate. */
  .home-hero { position: relative; overflow: hidden; background: var(--qw-slate-900); padding-bottom: clamp(3rem, 2rem + 3vw, 5rem); }
  .home-hero__stage { position: relative; }
  /* Photo: below 1100px it is an ordinary 16:9 band above the copy, so text never covers faces on phones
     and tablets. */
  .home-hero__photo { display: block; width: 100%; aspect-ratio: 16 / 9; height: auto; object-fit: cover; }
  .home-hero__scrim { display: none; }
  .home-hero__grid { position: relative; display: grid; gap: var(--space-12); align-items: center; padding-top: var(--space-8); }
  @media (min-width: 1100px) {
    /* From 1100px the photo fills the whole stage behind the copy; the people sit to the right of it. */
    .home-hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; }
    /* Scrim: solid slate-900 behind the copy column, fading out towards the people on the right, plus a
       bottom fade into the pathway band. The copy area is solid to 38% and at least 92% slate-900 to 50% of the
       width; measured worst-case contrast behind the text is recorded in docs/15 §5 (teal eyebrow >= 4.5:1). */
    .home-hero__scrim { display: block; position: absolute; inset: 0; pointer-events: none;
      background:
        linear-gradient(180deg, transparent 70%, var(--qw-slate-900) 100%),
        linear-gradient(90deg, var(--qw-slate-900) 0%, var(--qw-slate-900) 38%, color-mix(in srgb, var(--qw-slate-900) 92%, transparent) 50%, color-mix(in srgb, var(--qw-slate-900) 45%, transparent) 64%, color-mix(in srgb, var(--qw-slate-900) 6%, transparent) 82%, transparent 100%); }
    .home-hero__grid { padding-block: clamp(3rem, 2rem + 3vw, 5.5rem) clamp(2.5rem, 2rem + 2vw, 4rem); }
    .home-hero__copy { max-width: 36rem; }
  }

  /* Hero text. max-width: 12ch keeps the h1 to about two lines. */
  .home-hero h1 { font-size: var(--fs-3xl); font-weight: var(--fw-black); max-width: 12ch; margin-bottom: var(--space-6); }
  .home-hero .lede { color: var(--qw-ink-1); max-width: 36rem; }
  .home-hero__rule { margin-top: var(--space-8); }
  .home-hero__ctas { margin-top: var(--space-8); }
  .home-hero__facts { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); list-style: none; padding: 0; margin: var(--space-10) 0 0; font-size: var(--fs-sm); color: var(--qw-ink-2); }
  .home-hero__facts li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .home-hero__facts li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--qw-green-500); }

  /* Pathway cards: teal top rule (green for the AI pathway). No fill, so the teal CTA text sits on slate-900
     (4.73:1); a translucent fill would lower it below 4.5:1. */
  .pathways { position: relative; list-style: none; margin: var(--space-12) 0 0; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .pathway { position: relative; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-6); border-radius: var(--radius-lg); background: transparent; border: 1px solid rgba(255,255,255,0.12); border-top: 3px solid var(--qw-teal-500); transition: background var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); }
  .pathway[data-pathway="ai"] { border-top-color: var(--qw-green-500); }
  .pathway:hover { background: color-mix(in srgb, var(--qw-teal-500) 10%, transparent); border-color: color-mix(in srgb, var(--qw-teal-500) 45%, transparent); }
  .pathway__label { margin: 0; font: var(--fw-bold) var(--fs-xs)/1.3 var(--font-display); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-ink-2); }
  .pathway__title { margin: 0; font-size: var(--fs-md); line-height: 1.3; }
  .pathway__title a { color: #fff; text-decoration: none; }
  /* Stretched link: the title link's ::after covers the whole card, so the card is one click target. The focus
     ring is drawn on the card (:has) instead of the invisible stretched link. */
  .pathway__title a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .pathway:has(a:focus-visible) { outline: 3px solid var(--qw-green-500); outline-offset: 3px; }
  .pathway__title a:focus-visible { outline: none; }
  .pathway__text { margin: 0; font-size: var(--fs-sm); color: var(--color-text); }
  .pathway__cta { margin-top: auto; padding-top: var(--space-2); display: inline-flex; align-items: center; gap: 0.4rem; font-weight: var(--fw-semibold); font-size: var(--fs-sm); color: var(--qw-teal-500); }
  .pathway__cta :global(svg) { width: 16px; height: 16px; transition: transform var(--dur-base) var(--ease-out); }
  .pathway:hover .pathway__cta :global(svg) { transform: translateX(3px); }

  /* Intro: positioning headline and three "why" items with a teal left rule. */
  .intro h2 { font-size: var(--fs-xl); font-weight: var(--fw-semibold); line-height: 1.2; }
  .intro .beyond { white-space: normal; font-size: 0.9em; }
  .why { display: grid; gap: var(--space-6); margin: var(--space-8) 0; }
  .why__item { padding-left: var(--space-5); border-left: 2px solid var(--qw-teal-500); }
