---
/**
 * CASE STUDY DETAIL (/case-studies/{slug}/). Standardised in review round 1; the legacy
 * /case-study/{slug}/ addresses need 301 redirects at launch (docs/06-url-mapping.md) — NOT configured in the prototype.
 * Structured fields: customer, challenge, contribution, approach, outcome, metrics (+source/context).
 *
 * URLs: getStaticPaths() emits one route per record in `caseStudies` (src/data/caseStudies.ts), using the
 *   record's PUBLIC `slug` (a WordPress slug that must not be public, e.g. one containing a client name, is
 *   renamed via src/data/redirects.json `caseStudySlugRenames`; see CONTRIBUTING.md recipe 4.2).
 * Persona / CTA (docs/03-page-map-personas.md §2, "Case studies" row): primary A, C; secondary B. Core
 *   question: "Have they solved this before?" Proof required: metrics with source/context. Primary CTA:
 *   "Discuss a similar challenge" (closing CtaBand; the button itself is the record's `cta`).
 * What, top to bottom: dark hero (breadcrumbs, eyebrow with industry, h1, summary, Client / Industry /
 *   Services facts, optional image); key-result metrics with their source and the client-disclosure state;
 *   the story (client, challenge, solution, result) beside a sticky "Our contribution" aside; up to three
 *   related case studies; closing CtaBand.
 * Data: src/data/caseStudies.ts (the record and the related list), src/data/industries.ts (industry name
 *   and link), src/data/services.ts and src/data/products.ts (service links and the "About {solution}"
 *   button, resolved from `relatedSolution`, service first then product).
 * SEO: title "{title} | QualityWorks Case Study", cut to 90 characters. Description: `summary` (or
 *   `challenge`), cut at a word boundary when longer than 160 characters. og:type "article" and og:image =
 *   the case-study image when present. JSON-LD: BreadcrumbList only (from BaseLayout).
 * Review/release: no REVIEW/RELEASE logic in this file. The disclosure line ("Client disclosure approval:
 *   to be confirmed / approved / not approved") is shown in every build.
 * Gotchas:
 *   - The page renders its own hero (no PageHero), so it places <Breadcrumbs> and the single <h1> itself. Its image
 *     follows the PageHero photo treatment (blended on desktop, plain picture on mobile; docs/15).
 *   - The metrics source line uses only the FIRST metric's `metricSource`; all metrics in one record are
 *     assumed to share a source.
 *   - Story sections with 20 characters or fewer are dropped, so stub values like "N/A" never render as a
 *     section.
 *   - `cs.client` is shown as-is: unapproved client names must already be replaced by a neutral descriptor
 *     in the data (CONTRIBUTING.md recipe 4.2, step 5).
 *   - Metric values go through MetricValue so characters like the "A -> B" arrow use brand-font glyphs
 *     (glyph-lint fails the build otherwise).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Button from '../../components/Button.astro';
import MetricValue from '../../components/MetricValue.astro';
import { caseStudies } from '../../data/caseStudies';
import { industryBySlug } from '../../data/industries';
import { serviceBySlug } from '../../data/services';
import { productBySlug } from '../../data/products';
import type { CaseStudy } from '../../data/types';
export function getStaticPaths() { return caseStudies.map((c) => ({ params: { slug: c.slug }, props: { cs: c } })); }
const { cs } = Astro.props as { cs: CaseStudy };
// Lookups for the facts list and the aside button. `relatedSolution` may name a service OR a product.
const industry = industryBySlug(cs.industry);
const solution = serviceBySlug(cs.relatedSolution) ?? productBySlug(cs.relatedSolution);
// Related case studies: same industry or at least one shared service tag, first three in data order.
const more = caseStudies.filter((c) => c.slug !== cs.slug && (c.industry === cs.industry || c.serviceTags.some((t) => cs.serviceTags.includes(t)))).slice(0, 3);
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Case Studies', href: '/case-studies/' }, { label: cs.title }];
// Story sections as [heading, text] pairs; empty or very short fields are filtered out (see Gotchas).
const sections = [
  // Section heading says “The client”: QualityWorks calls the organisations it works for clients (review round 2).
  ['The client', cs.customer], ['The challenge', cs.challenge], ['Our solution', cs.approach], ['The result', cs.outcome],
].filter(([, v]) => v && v.length > 20) as [string, string][];
// Meta description: use the summary as-is when it fits search-result length (≤160 chars); otherwise cut at a word boundary.
const rawDescription = cs.summary || cs.challenge;
const description = rawDescription.length <= 160 ? rawDescription : rawDescription.slice(0, 155).replace(/\s+\S*$/, '') + '…';
---
<BaseLayout seo={{ title: `${cs.title} | QualityWorks Case Study`.slice(0, 90), description, ogImage: cs.image ?? undefined }} breadcrumbs={crumbs} ogType="article">
  {/* Custom dark hero: breadcrumbs, h1, summary, key facts and the optional case-study image. The image uses
      the same treatment as the people-focused PageHero headers (docs/15): a plain edge-to-edge picture above the
      copy below 1024px; from 1024px it fills the right half of the band and blends into slate. No boxed card. */}
  <section class:list={['cs-hero', 'surface-dark', { 'cs-hero--photo': !!cs.image }]}>
    {cs.image && (
      <div class="cs-hero__media">
        <img src={cs.image} alt={cs.altText} width="720" height="480" loading="eager" fetchpriority="high" decoding="async" />
        <div class="cs-hero__blend" aria-hidden="true"></div>
      </div>
    )}
    <div class="container cs-hero__grid">
      <div class="cs-hero__copy">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow">Case study · {industry?.name}</p>
        <h1>{cs.title}</h1>
        <p class="lede">{cs.summary}</p>
        <dl class="cs-facts">
          <div><dt>Client</dt><dd>{cs.client}</dd></div>
          <div><dt>Industry</dt><dd><a href={industry?.path}>{industry?.name}</a></dd></div>
          <div><dt>Services</dt><dd>{cs.serviceTags.map((t, i) => { const s = serviceBySlug(t); return <>{i > 0 && ', '}{s ? <a href={s.path}>{s.name}</a> : t}</>; })}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  {/* Key results: each metric shows value, label and measurement context, plus one source/disclosure line. */}
  {cs.metrics.length > 0 && (
    <section class="section section--tight" aria-labelledby="metrics-title">
      <div class="container">
        <h2 id="metrics-title" class="visually-hidden">Key results</h2>
        <dl class="metrics">
          {cs.metrics.map((m) => (
            <div class="metric">
              <dt>{m.label}</dt>
              <dd class="metric__value"><MetricValue value={m.value} /></dd>
              <dd class="metric__ctx">{m.context}</dd>
            </div>
          ))}
        </dl>
        <p class="metric-src">Results as reported in the published case study {cs.metrics[0].metricSource.startsWith('http') ? <>(<a href={cs.metrics[0].metricSource} target="_blank" rel="noopener">source<span class="visually-hidden">, opens current live page in a new tab</span></a>)</> : <>({cs.metrics[0].metricSource})</>}. Client disclosure approval: <strong>{cs.clientDisclosureApproved === null ? 'to be confirmed' : cs.clientDisclosureApproved ? 'approved' : 'not approved'}</strong>.</p>
      </div>
    </section>
  )}

  {/* Story body: contribution aside (sticky from 960px) and the client / challenge / solution / result sections. */}
  <section class="section surface-alt">
    <div class="container cs-body">
      <aside class="cs-aside" aria-label="Our contribution">
        <p class="eyebrow">Our contribution</p>
        <p class="cs-aside__text">{cs.contribution}</p>
        {solution && <Button href={solution.path} label={`About ${solution.name}`} variant="secondary" size="sm" />}
      </aside>
      <div class="cs-story">
        {sections.map(([h, v]) => (<><h2>{h}</h2><p>{v}</p></>))}
      </div>
    </div>
  </section>

  {/* Related case studies (only when at least one matches). */}
  {more.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeading eyebrow="More results" title="Related case studies" />
        <div class="grid grid--3">{more.map((c) => <CaseStudyCard cs={c} />)}</div>
      </div>
    </section>
  )}
  {/* Closing CTA: the record's own `cta`, plus a link back to the list. */}
  <CtaBand title="Discuss a similar challenge with our team." primary={cs.cta} secondary={{ label: 'All case studies', href: '/case-studies/' }} />
</BaseLayout>
<style>
  /* Hero: teal glow (logo teal var(--qw-teal-500) at 25%) from the top-right corner over ink-900. Image column from 1024px. */
  /* Hero: solid slate-900 band (no gradient background; the brand gradient is reserved for one rule per page). */
  .cs-hero { position: relative; overflow: hidden; padding-block: var(--space-10) var(--space-16); background: var(--qw-slate-900); }
  .cs-hero__grid { position: relative; display: grid; gap: var(--space-10); align-items: center; }
  .cs-hero h1 { font-size: var(--fs-2xl); }
  /* Image, below 1024px: a plain edge-to-edge picture at the top of the band (no radius, no shadow). */
  .cs-hero--photo { padding-top: 0; }
  .cs-hero__media { position: relative; margin-bottom: var(--space-8); }
  .cs-hero__media img { display: block; width: 100%; aspect-ratio: 16 / 9; height: auto; object-fit: cover; }
  .cs-hero__blend { display: none; }
  @media (min-width: 1024px) {
    /* Image, from 1024px: fills the right 55% of the band at full height and blends into slate on its left
       edge, like PageHero's photo headers. The copy column stays on the solid part of the band. */
    .cs-hero--photo { padding-top: var(--space-10); }
    .cs-hero__media { position: absolute; top: 0; right: 0; bottom: 0; width: 55%; margin: 0; }
    .cs-hero__media img { height: 100%; aspect-ratio: auto; }
    .cs-hero__blend { display: block; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(90deg, var(--qw-slate-900) 0%, color-mix(in srgb, var(--qw-slate-900) 80%, transparent) 16%, color-mix(in srgb, var(--qw-slate-900) 35%, transparent) 38%, transparent 62%),
        linear-gradient(0deg, color-mix(in srgb, var(--qw-slate-900) 55%, transparent) 0%, transparent 30%); }
    .cs-hero--photo .cs-hero__copy { max-width: min(36rem, 43vw); }
  }
  /* Facts list: mono uppercase labels in logo green, which is an accent meant for dark surfaces like this one. */
  .cs-facts { display: grid; gap: var(--space-3); margin: var(--space-8) 0 0; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .cs-facts dt { font: var(--fw-medium) var(--fs-xs)/1.3 var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--qw-green-500); }
  .cs-facts dd { margin: 0.2rem 0 0; color: #fff; }
  /* Metric cards. The markup order is dt (label) then dd (value) for valid <dl> structure; CSS `order` shows
     the big value first, then the label, then the context. */
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: var(--space-6); margin: 0; }
  .metric { display: flex; flex-direction: column; padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); border-top: 4px solid var(--qw-teal-500); }
  .metric dt { order: 2; font-weight: var(--fw-semibold); color: var(--qw-slate-900); }
  .metric__value { order: 1; margin: 0 0 var(--space-2); font-size: var(--fs-2xl); font-weight: var(--fw-bold); line-height: 1.05; color: var(--qw-teal-700); letter-spacing: -0.02em; }
  .metric__ctx { order: 3; margin: var(--space-2) 0 0; font-size: var(--fs-xs); color: var(--color-muted); }
  .metric-src { font-size: var(--fs-xs); color: var(--color-muted); margin: var(--space-4) 0 0; }
  /* Story layout: 18rem aside + text column from 960px. The aside sticks at top: 7rem to clear the sticky
     site header. Body text is capped at 44rem for a comfortable line length. */
  .cs-body { display: grid; gap: var(--space-10); }
  @media (min-width: 960px) { .cs-body { grid-template-columns: 18rem 1fr; gap: var(--space-16); } .cs-aside { position: sticky; top: 7rem; align-self: start; } }
  .cs-aside { padding: var(--space-6); background: #fff; border: 1px solid var(--qw-line); border-radius: var(--radius-lg); }
  .cs-aside__text { font-weight: var(--fw-medium); color: var(--qw-slate-900); }
  .cs-story { max-width: 44rem; font-size: 1.0625rem; line-height: 1.75; }
  .cs-story h2 { font-size: var(--fs-xl); margin-top: var(--space-10); }
  .cs-story h2:first-child { margin-top: 0; }
</style>
