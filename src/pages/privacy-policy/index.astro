---
/**
 * PRIVACY POLICY — renders /privacy-policy/ (legacy URL preserved).
 *
 * What: a placeholder route. All markup comes from src/components/LegalStub.astro.
 * Why: legal text is deliberately NOT reproduced in the prototype. It must be migrated verbatim from the
 *   live site (and reviewed by counsel if data processing changes, e.g. a new form provider). The stub
 *   shows a "Prototype route" notice linking to the current live version.
 * Persona / CTA: not listed in docs/03-page-map-personas.md §2 (utility page in the §1 page map).
 * Data: none; `title` and `path` props only. `path` must match this route so the stub links to
 *   https://qualityworkscg.com/privacy-policy/.
 * SEO: LegalStub builds the title ("Privacy Policy | QualityWorks") and description from `title`, and
 *   passes Home > Privacy Policy breadcrumbs, so BaseLayout emits BreadcrumbList JSON-LD.
 * Review/release: no REVIEW/RELEASE logic; the stub notice appears in both builds, so the real policy
 *   text must replace it before launch.
 * Gotchas: the sibling /terms-conditions/ page uses the same pattern. Edit LegalStub.astro to change both.
 */
import LegalStub from '../../components/LegalStub.astro';
---
<LegalStub title="Privacy Policy" path="/privacy-policy/" />
