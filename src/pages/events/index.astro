---
/**
 * EVENTS (proposed route). Upcoming / date TBC / past / cancelled are visually and textually distinct.
 *
 * URL: /events/. Marked "(proposed)" in the docs/03 page map ("Events & Speaking"): not in the live
 *   sitemap, needs QM-41 confirmation.
 * What: three groups of EventCards: "Upcoming and to be confirmed", "Past events", and (only if any)
 *   "Cancelled". Each card links to /events/{slug}/ (events/[slug].astro).
 * Persona / CTA (docs/03-page-map-personas.md §2, "Events" row): primary persona All; no secondary.
 *   Core question: "Where can I see the team, and is it upcoming?" Proof required: dates verified with the
 *   organiser. Primary CTA: "Register" (upcoming only), shown on the detail page, not on this list.
 * Data: src/data/events.ts (`events`, `eventPhase`). Phase is derived from dates at BUILD time (the
 *   prototype's "today" is the build date), so a static build goes stale; production should rebuild
 *   daily or compute on request.
 * SEO: inline title/description. Breadcrumbs Home > Resources > Events produce BreadcrumbList JSON-LD via
 *   BaseLayout. No list-level JSON-LD (Event schema is emitted per detail page).
 * Review/release: no REVIEW/RELEASE logic in this file. In RELEASE builds events.ts already removes
 *   fixture events, unverified events and events with no start date, so the "to be confirmed" and
 *   "Cancelled" groups can be empty there.
 * Redesign: green photo hero; upcoming on white; past events on a grey band with white, bordered cards so
 *   they never blend into the background (Janique: "maybe we could use gray"). Card overrides are scoped here.
 * Gotchas:
 *   - The "Cancelled" heading is h2 (level="h2") so the outline does not skip a level.
 *   - "Past events" has no empty state; if every past event is removed, the section shows just a heading.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventCard from '../../components/EventCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { peopleImage } from '../../data/peopleImagery';
import { events, eventPhase } from '../../data/events';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Resources', href: '/resources/' }, { label: 'Events' }];
// Select events whose derived phase is in the given list.
const by = (p: string[]) => events.filter((e) => p.includes(eventPhase(e)));
// Soonest first. Undated ("date-tbc") events have an empty startDate, and the '9' fallback sorts them after
// any ISO date string, so they appear last.
const upcoming = by(['upcoming', 'date-tbc']).sort((a, b) => (a.startDate || '9').localeCompare(b.startDate || '9'));
// Most recent first.
const past = by(['past']).sort((a, b) => b.startDate.localeCompare(a.startDate));
const cancelled = by(['cancelled']);
---
<BaseLayout seo={{ title: 'Events & Speaking | QualityWorks', description: 'Conferences, webinars and speaking engagements featuring QualityWorks CEO and Founder Stacy Kirk and the QualityWorks team.' }} breadcrumbs={crumbs}>
  <PageHero image={peopleImage('resources-audience')} tone="green" ui={false} eyebrow="Resource Hub · Events & webinars" title="Events & speaking" lede="Where’s Stacy? Stacy Kirk, CEO and Founder of QualityWorks, speaks to professional and student groups across the United States and abroad. Our webinars focus on practical ways to stay ahead of changing trends." breadcrumbs={crumbs} secondary={{ label: 'Resource Hub', href: '/resources/' }} primary={{ label: 'See what’s coming up', href: '#up-title' }} />
  {/* Upcoming + date TBC, with an empty state when there are none. */}
  <section class="section surface-white ev-up" aria-labelledby="up-title">
    <div class="container">
      <SectionHeading eyebrow="Coming up" title="Upcoming and to be confirmed" id="up-title" />
      {upcoming.length ? <div class="grid grid--3">{upcoming.map((e) => <EventCard e={e} />)}</div> : <EmptyState title="No upcoming events" icon="calendar"><p>Check back soon, or follow us on LinkedIn.</p></EmptyState>}
    </div>
  </section>
  {/* Archive of past events (no registration). */}
  <section class="section ev-past" aria-labelledby="past-title">
    <div class="container">
      <SectionHeading eyebrow="Archive" title="Past events" id="past-title" />
      <div class="grid grid--3">{past.map((e) => <EventCard e={e} />)}</div>
    </div>
  </section>
  {/* Cancelled events: section only appears when at least one exists (today: the fixture, review builds only). */}
  {cancelled.length > 0 && (
    <section class="section surface-white ev-cancelled" aria-labelledby="c-title">
      <div class="container"><SectionHeading title="Cancelled" id="c-title" level="h2" /><div class="grid grid--3">{cancelled.map((e) => <EventCard e={e} />)}</div></div>
    </section>
  )}
</BaseLayout>
<style>
  /* Upcoming: white band; cards get a green (upcoming) or teal (date TBC) top bar. */
  .ev-up :global(.event-card) { border-radius: 22px; border: 1.5px solid color-mix(in srgb, var(--qw-slate-900) 16%, transparent); box-shadow: 0 22px 44px -32px rgba(34,43,55,0.55); }
  .ev-up :global(.event-card--upcoming) { border-top: 8px solid var(--qw-green-500); }
  .ev-up :global(.event-card--date-tbc) { border-top: 8px solid var(--qw-teal-500); }
  /* Past: grey band (slate tint) with WHITE, bordered cards and a slate top bar, so cards stand out clearly. */
  .ev-past { background: color-mix(in srgb, #36414F 10%, #fff); }
  .ev-past :global(.event-card), .ev-past :global(.event-card--past) { background: #fff; border-radius: 22px; border: 1.5px solid color-mix(in srgb, var(--qw-slate-900) 22%, transparent); border-top: 8px solid #36414F; box-shadow: 0 22px 44px -30px rgba(34,43,55,0.6); }
  .ev-cancelled :global(.event-card--cancelled) { background: color-mix(in srgb, #36414F 7%, #fff); border-radius: 22px; border: 1.5px dashed color-mix(in srgb, var(--qw-slate-900) 35%, transparent); }
  :global(#up-title) { scroll-margin-top: 6rem; }
</style>
