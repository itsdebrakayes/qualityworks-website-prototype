---
/**
 * RESOURCE HUB (proposed new route; live "Resources" menu holds only Blog).
 * Combines articles, news/awards and whitepapers with type chips + topic filter. Events were removed from the
 * site (CEO review, 24 Nov 2026); /events/ URLs redirect here (scripts/gen-redirects.mjs).
 * Persona: QA Director (B), Marketing/Ops (E). Core question: "What can I learn before I talk to sales?"
 *
 * URL: /resources/. Marked "(proposed hub)" in the docs/03 page map: not in the live sitemap, needs QM-41.
 * Persona / CTA (docs/03-page-map-personas.md §2, "Resources / Blog / Article" row): primary B, E;
 *   secondary A. Proof required: author, dates, references. Primary CTA: "Talk to an expert" (here the
 *   closing CtaBand with `ctas.contact`). Required data: articles (WordPress).
 * What: one grid of ArticleCards with two combinable filters: content-type chips
 *   (single-select toggle buttons) and a topic <select>. Empty state with its own "Clear filters" button.
 * Data: src/data/articles.ts (`articles` = migrated posts plus, in review builds only, the PRISM
 *   whitepaper fixture; `contentTypes` for the chips), src/data/site.ts (`ctas.contact`).
 * SEO: inline title/description. Breadcrumbs Home > Resources produce BreadcrumbList JSON-LD via
 *   BaseLayout. No other JSON-LD.
 * Review/release: no REVIEW/RELEASE logic in this file; the review/release difference comes from the
 *   data modules (fixtures filtered out in RELEASE), so chip counts differ between builds.
 * Redesign (Janique 24 Nov: "Not seeing how blog and Resource Hub differs"): the hub is now framed as the home of
 *   deeper educational and downloadable material that exists today: whitepapers (articles typed 'whitepaper',
 *   incl. the PRISM "Coming soon" fixture in review builds), case studies (src/data/caseStudies.ts, linking to
 *   /case-studies/). Events & webinars were removed (CEO review, 24 Nov 2026). No guides exist, so
 *   none are shown. The Blog (articles, news and insights) is linked from the hero and the overview tiles.
 *   Below the featured sections, the original filterable library grid is kept unchanged.
 * Gotchas:
 *   - The filter form is written by hand here instead of using FilterBar.astro, because FilterBar only
 *     renders <select>s and this page needs chip buttons. It still uses the same data-* hooks
 *     (data-filter-bar, data-chip-filter, data-filter, data-filter-clear, data-filter-count) that
 *     src/lib/filters.ts expects, and repeats the .filter-bar styles locally (FilterBar's are scoped).
 *   - Topic options come from article categories only.
 *   - Filter state is mirrored in the URL (?type=...&topic=...) so filtered views are shareable.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
// People photograph for the section overview header (visual revision, docs/15).
import { peopleImage } from '../../data/peopleImagery';
import ArticleCard from '../../components/ArticleCard.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { articles, contentTypes, blogPosts } from '../../data/articles';
import { caseStudies } from '../../data/caseStudies';
import { ctas } from '../../data/site';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Resources' }];
// Topic options: unique article categories, minus WordPress's default "Uncategorized", sorted A-Z.
const topics = [...new Set(articles.flatMap((a) => a.categories))].filter((c) => c !== 'Uncategorized').sort();
// Item count shown on each content-type chip.
const count = (t: string) => articles.filter((a) => a.type === t).length;
// Featured sections. Whitepapers: every article typed 'whitepaper'. Case studies: the first three records
// that have a headline metric. Events: upcoming / date-TBC first (soonest first), then the most recent past.
const whitepapers = articles.filter((a) => a.type === 'whitepaper');
const featuredCases = caseStudies.filter((c) => c.metrics.length > 0).slice(0, 3);
// Overview tiles: what lives in the hub (three) plus the Blog crossover tile.
const tiles = [
  { href: '#whitepapers', icon: 'doc', tone: 'teal', label: 'Whitepapers', n: whitepapers.length, text: 'In-depth papers on software quality and AI.' },
  { href: '/case-studies/', icon: 'gauge', tone: 'green', label: 'Case studies', n: caseStudies.length, text: 'How clients solved difficult digital challenges.' },
  { href: '/blog/', icon: 'learn', tone: 'white', label: 'Blog', n: blogPosts.length, text: 'Articles, news and insights from our team.' },
];
---
<BaseLayout seo={{ title: 'Resources: Articles, Whitepapers, Case Studies & News | QualityWorks', description: 'Insights on software testing, test automation, agentic QA and AI adoption from QualityWorks, plus company news, whitepapers and case studies.' }} breadcrumbs={crumbs}>
  <PageHero image={peopleImage('resources-audience')} tone="teal" ui={false} eyebrow="Resource Hub · Whitepapers and case studies" title="The Resource Hub" lede="Practical thinking on software quality, AI and delivery from the QualityWorks team." breadcrumbs={crumbs} primary={{ label: 'Explore the hub', href: '#hub-overview' }} secondary={{ label: 'Read the blog', href: '/blog/' }}>
    <p class="purpose">The Resource Hub collects our deeper material: whitepapers and client case studies. For shorter articles and company news, see the <a href="/blog/">Blog</a>.</p>
  </PageHero>

  {/* Overview: four big tiles explaining what is in the hub, with live counts from the data. */}
  <section class="section surface-white" id="hub-overview" aria-labelledby="overview-title">
    <div class="container">
      <div class="section-intro" data-reveal="up">
        <p class="eyebrow">What’s in the hub</p>
        <h2 id="overview-title" class="display-sm">Go deeper than a blog post</h2>
      </div>
      <ul class="tiles" data-reveal-stagger>
        {tiles.map((t) => (
          <li class:list={['tile', `tile--${t.tone}`]} data-reveal="up">
            <span class="tile__icon" aria-hidden="true"><Icon name={t.icon} /></span>
            <span class="tile__n" aria-hidden="true">{t.n}</span>
            <h3 class="tile__title"><a href={t.href}>{t.label}<span class="visually-hidden"> ({t.n})</span></a></h3>
            <p class="tile__text">{t.text}</p>
            <span class="tile__arrow" aria-hidden="true"><Icon name="arrow" /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Whitepapers: every article typed 'whitepaper' (the PRISM card shows "Coming soon"). */}
  <section class="section surface-mint" id="whitepapers" aria-labelledby="wp-title">
    <div class="container">
      <div class="section-intro" data-reveal="up">
        <p class="eyebrow">Whitepapers</p>
        <h2 id="wp-title" class="display-sm">Read the research</h2>
      </div>
      <div class="grid grid--2 wp-grid">{whitepapers.map((a) => <ArticleCard a={a} />)}</div>
    </div>
  </section>

  {/* Case studies: three featured records, linking to the full filterable list. */}
  <section class="section surface-white" aria-labelledby="cs-title">
    <div class="container">
      <div class="feat-head" data-reveal="up">
        <div><p class="eyebrow">Case studies</p><h2 id="cs-title" class="display-sm">Results from real engagements</h2></div>
        <a class="btn btn--secondary" href="/case-studies/">All {caseStudies.length} case studies <Icon name="arrow" /></a>
      </div>
      <div class="grid grid--3">{featuredCases.map((cs) => <CaseStudyCard cs={cs} />)}</div>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="lib-title">
    <div class="container">
      <div class="section-intro" data-reveal="up">
        <p class="eyebrow">Browse everything</p>
        <h2 id="lib-title" class="display-sm">The full library</h2>
        <p class="lede">Every whitepaper, article and news item in one filterable list.</p>
      </div>
      {/* Hand-built filter form (see Gotchas). onsubmit="return false" stops Enter from reloading the page. */}
      <form class="filter-bar res-filter" id="res-filter" role="search" aria-label="Filter resources" data-filter-bar onsubmit="return false">
        <div class="res-filter__types">
          <p class="res-filter__label" id="type-label">Content type</p>
          <div class="chips" role="group" aria-labelledby="type-label" data-chip-filter="type">
            <button type="button" class="chip" aria-pressed="true" data-value="">All</button>
            {contentTypes.map((t) => <button type="button" class="chip" aria-pressed="false" data-value={t.id}>{t.label} <span class="chip__n">{count(t.id)}</span></button>)}
          </div>
        </div>
        <div class="field">
          <label for="res-topic">Topic</label>
          <select class="select" id="res-topic" data-filter="topic"><option value="">All topics</option>{topics.map((t) => <option value={t}>{t}</option>)}</select>
        </div>
        <div class="filter-bar__actions"><button type="button" class="btn btn--ghost btn--sm" data-filter-clear disabled>Clear filters</button></div>
        <p class="filter-bar__count" aria-live="polite" data-filter-count></p>
      </form>
      {/* Results grid: articles, newest first (sorted in articles.ts). */}
      <div class="grid grid--3" id="res-results">
        {articles.map((a) => <ArticleCard a={a} />)}
      </div>
      {/* Empty state: shown by initFilters() when no item matches; its button is wired in the script below. */}
      <EmptyState title="Nothing matches those filters" id="res-empty" hidden><p>Try another topic or content type.</p><button type="button" class="btn btn--secondary btn--sm" data-empty-clear>Clear filters</button></EmptyState>
    </div>
  </section>
  <CtaBand title="Want to talk it through with the authors?" primary={ctas.contact} />
</BaseLayout>
<style>
  .purpose { margin-top: var(--space-4); max-width: 34rem; font-size: var(--fs-sm); color: var(--qw-slate-900); }
  /* Overview tiles: four colour blocks with a big count, the whole tile clickable via the title link. */
  .tiles { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .tile { position: relative; display: flex; flex-direction: column; min-height: 17rem; padding: var(--space-6); border-radius: 26px; background: var(--t-bg); color: var(--t-fg); border: 2px solid var(--t-border, transparent); transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out); }
  .tile:hover, .tile:focus-within { transform: translateY(-6px); box-shadow: 0 28px 48px -28px rgba(34,43,55,0.55); }
  .tile--teal { --t-bg: var(--qw-teal-500); --t-fg: var(--qw-slate-900); --i-bg: var(--qw-slate-900); --i-fg: #fff; }
  .tile--green { --t-bg: var(--qw-green-500); --t-fg: var(--qw-slate-900); --i-bg: #fff; --i-fg: var(--qw-slate-900); }
  .tile--slate { --t-bg: var(--qw-slate-900); --t-fg: #fff; --i-bg: var(--qw-teal-500); --i-fg: var(--qw-slate-900); }
  .tile--white { --t-bg: #fff; --t-fg: var(--qw-slate-900); --t-border: var(--qw-ink-3); --i-bg: var(--qw-mint-50); --i-fg: var(--qw-teal-700); }
  .tile__icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 16px; background: var(--i-bg); color: var(--i-fg); }
  .tile__icon :global(svg) { width: 24px; height: 24px; }
  .tile__n { position: absolute; right: var(--space-6); top: var(--space-4); font: var(--fw-black) 3.5rem/1 var(--font-display); letter-spacing: -0.04em; opacity: 0.9; }
  .tile__title { margin: auto 0 var(--space-2); padding-top: var(--space-8); font-size: var(--fs-xl); color: inherit; }
  .tile__title a { color: inherit; text-decoration: none; }
  .tile__title a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .tile__title a:focus-visible { outline: none; }
  .tile:has(a:focus-visible) { outline: 3px solid var(--qw-slate-900); outline-offset: 4px; }
  .tile__text { margin: 0; color: inherit; }
  .tile__arrow { position: absolute; right: var(--space-6); bottom: var(--space-6); transition: transform 0.3s var(--ease-out); }
  .tile__arrow :global(svg) { width: 22px; height: 22px; }
  .tile:hover .tile__arrow { transform: translateX(6px); }
  .tile__text { padding-right: 2rem; }
  /* Featured heads: heading left, "all" link right. */
  .feat-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-4); margin-bottom: var(--space-10); }
  .feat-head h2 { margin: 0; }
  .wp-grid > :global(.card) { border-radius: 24px; border: 0; box-shadow: 0 24px 50px -34px rgba(34,43,55,0.5); }
  /* Library: past events in the mixed grid get a grey container instead of mint. */
  #res-results :global(.event-card--past), #res-results :global(.event-card--cancelled) { background: color-mix(in srgb, var(--qw-slate-700, #36414F) 7%, #fff); border-color: color-mix(in srgb, var(--qw-slate-900) 20%, transparent); }
  /* Filter panel layout: stacked on small screens; from 900px, chips | 16rem topic select | clear button. */
  .filter-bar { display: grid; gap: var(--space-4); align-items: end; grid-template-columns: 1fr; padding: var(--space-5); background: var(--qw-mint-50); border-radius: 22px; margin-bottom: var(--space-8); }
  @media (min-width: 900px) { .filter-bar { grid-template-columns: 1fr 16rem auto; } }
  .res-filter__label { font-weight: var(--fw-semibold); font-size: var(--fs-sm); color: var(--qw-slate-900); margin-bottom: var(--space-2); }
  /* Content-type chips. 44px min height for touch targets; pressed state is slate-900 with white text. */
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip { min-height: 44px; padding: 0.4rem 1rem; border-radius: var(--radius-pill); border: 1.5px solid var(--qw-ink-3); background: #fff; color: var(--qw-slate-900); font: var(--fw-semibold) var(--fs-sm)/1 var(--font-display); cursor: pointer; display: inline-flex; gap: 0.4rem; align-items: center; }
  .chip:hover { border-color: var(--qw-teal-700); }
  .chip[aria-pressed="true"] { background: var(--qw-slate-900); border-color: var(--qw-slate-900); color: #fff; }
  .chip__n { font-family: var(--font-mono); font-size: var(--fs-xs); opacity: 0.75; }
  /* Clear button row and the live result count, which spans the full width. */
  .filter-bar__actions { display: flex; align-items: center; min-height: 48px; }
  .filter-bar__count { grid-column: 1 / -1; margin: 0; font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--qw-slate-900); }
  /* Event wrapper: stretch the EventCard to the grid cell height. The explicit [hidden] rule is needed because
     display: flex would otherwise override the hidden attribute the filter script sets. */
  .res-event { display: flex; }
  .res-event > :global(*) { flex: 1; }
  .res-event[hidden] { display: none; }
</style>
<script>
  // Client-side filtering via the shared controller in src/lib/filters.ts (URL state, live count, empty state).
  import { initFilters } from '../../lib/filters';
  // match: an item passes when no type chip is active or its data-type equals the chip value, AND no topic
  // is chosen or its "|"-joined data-categories contains the topic exactly.
  const api = initFilters({ bar: '#res-filter', results: '#res-results', empty: '#res-empty', noun: ['resource', 'resources'],
    match: (el, f) => (!f.type || el.dataset.type === f.type) && (!f.topic || (el.dataset.categories ?? '').split('|').includes(f.topic)) });
  // The empty state's own "Clear filters" button reuses the controller's clear() (resets chips, select and URL).
  document.querySelector('[data-empty-clear]')!.addEventListener('click', () => api.clear());
</script>
